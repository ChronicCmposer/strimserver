# strimserver only ever ships linux/amd64 (see README: "Architecture: x86_64 only").
build --platforms=//tools/bazel:linux_amd64

# Non-x86_64 hosts (e.g. aarch64 with qemu-user binfmt): the stock default
# test toolchain forces the test execution platform to satisfy the linux/amd64
# target constraints, so tests fail analysis with "No matching toolchains
# found" when the only execution platform is the host. Registering a
# hypothetical x86_64 execution platform globally would fix that but also
# makes Bazel prefer the amd64 Go SDK under qemu for ALL Go compilation and
# breaks C++ toolchain
# resolution for @bazel_tools//src/tools/launcher:launcher_maker. Instead,
# run test actions on the target platform (linux/amd64) via qemu-user binfmt;
# compile/genrule actions keep running natively on the host.
# NOTE: --use_target_platform_for_tests is deprecated in Bazel 9.2.0 (emits a
# non-fatal WARNING on every invocation). The suggested replacement --
# registering the target platform as an execution platform, e.g.
# --extra_execution_platforms=//tools/bazel:linux_x86_64_exec -- is deliberately
# NOT used: it would reintroduce the amd64 Go SDK preference under qemu and
# the C++ launcher_maker toolchain failure above. The linux_x86_64_exec
# platform target was removed as dead code; do not "fix" this deprecation.
build --use_target_platform_for_tests=true

test --test_output=errors
test --test_summary=terse

common --noenable_workspace

build --disk_cache=~/.cache/strimserver-bazel-cache

# =============================================================================
# Wave 0-A: hermetic musl C toolchain (zig cc) — see MODULE.bazel
# =============================================================================
# zig cc writes its cache to ~/.cache/zig; the sandbox must expose the host
# /home for that. --enable_platform_specific_config is what makes the
# build:linux section below apply on linux exec platforms.
common --enable_platform_specific_config
build:linux --sandbox_add_mount_pair=/home

# Opt-in musl C builds for both target arches. NOT the default: a plain
# `bazel build` keeps --platforms=//tools/bazel:linux_amd64 and the existing
# clang/glibc toolchain (the pure-Go controller needs no C toolchain at all).
# zig cc enables UBSan by default; -fno-sanitize=undefined turns it off for
# these hermetic builds.
#
# Binary-size reduction for the shipped C controller (mirrored in
# c_controller_transition.bzl): the zig toolchain's fastbuild mode passes no
# -O flag (i.e. -O0), which made the ~1.5 MB static binary ~58% larger than
# necessary. compilation_mode=opt makes the toolchain emit -O2 + -DNDEBUG;
# Bazel appends user --copt AFTER toolchain flags, so -Os (added after -O2)
# wins. -ffunction-sections/-fdata-sections plus --gc-sections prune unused
# functions from the pre-built musl static libc (built with function-sections)
# and unused MHD/nanopb/yyjson paths; -Wl,-s strips the symtab (the binary is
# a shipped image entrypoint, no debugging use); --build-id=none drops a
# trivial note section. NOTE: -Wl,--icf=safe (identical code folding) was
# intentionally NOT included: the zig 0.15.2 self-hosted linker errors with
# "unsupported linker arg: --icf" (Zig upstream limitation; zig cc ignores
# -fuse-ld=lld). -flto is intentionally excluded too (Zig/LLVM LTO bugs).
build:amd64 --platforms=@zig_sdk//platform:linux_amd64
build:amd64 --extra_toolchains=@zig_sdk//toolchain:linux_amd64_musl
build:amd64 --copt=-fno-sanitize=undefined
build:amd64 --linkopt=-fno-sanitize=undefined
build:amd64 --compilation_mode=opt
build:amd64 --copt=-Os
build:amd64 --copt=-ffunction-sections
build:amd64 --copt=-fdata-sections
build:amd64 --linkopt=-Wl,--gc-sections
build:amd64 --linkopt=-Wl,-s
build:amd64 --linkopt=-Wl,--build-id=none

build:arm64 --platforms=@zig_sdk//platform:linux_arm64
build:arm64 --extra_toolchains=@zig_sdk//toolchain:linux_arm64_musl
build:arm64 --copt=-fno-sanitize=undefined
build:arm64 --linkopt=-fno-sanitize=undefined
build:arm64 --compilation_mode=opt
build:arm64 --copt=-Os
build:arm64 --copt=-ffunction-sections
build:arm64 --copt=-fdata-sections
build:arm64 --linkopt=-Wl,--gc-sections
build:arm64 --linkopt=-Wl,-s
build:arm64 --linkopt=-Wl,--build-id=none
