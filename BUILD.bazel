# strimserver root package.

load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//:c_controller_transition.bzl", "c_controller_transition")
load("//tools/bazel:platform_transition.bzl", "platform_transition")

# --- Offline fallback segment --------------------------------------------
# The fallback clip is fetched by default through MODULE.bazel's
# s3_http_file(name = "offline_segment_dist") and bundled directly into the
# deployment tar (the clip is produced out-of-band on macOS by
# tools/brb-screen/publish.sh -- the encode uses VideoToolbox/AudioToolbox
# codecs that cannot run in the Bazel graph).

# --- No-Twitch-key gate ---------------------------------------------------
# Gates the CHECKED deployment tars (strimserver_deployment_tar_{go,c}_*,
# used by :package*, :package_all and :release) but NOT the publish targets,
# matching the Makefile exactly (verified: `package`'s recipe calls
# check-no-twitch-key explicitly; `publish-*` depends only on the unchecked
# tars, which never invoked the check itself).
genrule(
    name = "check_no_twitch_key",
    srcs = ["//core:strimserver.env"],
    outs = ["check_no_twitch_key.ok"],
    cmd = """
key="$$(set -a; . $(location //core:strimserver.env); set +a; printf '%s' "$$TWITCH_STREAM_KEY")"
if [ -n "$$key" ]; then
  echo "ERROR: TWITCH_STREAM_KEY is set in core/strimserver.env." >&2
  echo "Redistributable bundles must ship an EMPTY key (injected at deploy time)." >&2
  echo "Empty it for :strimserver_deployment_tar_go_amd64 / :release, or use" >&2
  echo ":publish_strimserver for a private, single-tenant build that bakes your own key." >&2
  exit 1
fi
touch $@
""",
)

# --- Bundle ----------------------------------------------------------------
# pkg_tar + strip_prefix.files_only() replaces GNU tar --transform, matching
# the Makefile's flattened layout exactly. Drops --ignore-failed-read: a
# missing input now fails the build loudly (exactly what would have
# surfaced bug #4 -- the broken publish-iperf3 deps -- years ago) instead of
# silently shipping an incomplete bundle.

# The bundle scripts fall into two mode classes:
#   * executable scripts - invoked directly on the host (./deploy.sh,
#     ./setup-gpu.sh, transcode.sh, notify.sh). rules_pkg 1.3.0 does NOT
#     preserve the source exec bit for plain source files: pkg_files only
#     assigns 0755 when the src is an executable RULE (it has a runfiles
#     manifest); plain files get default_mode "" which the tar writer maps to
#     0644. setup-gpu.sh shipped 0644 and broke `./setup-gpu.sh` on the host
#     ("Permission denied"). Pin modes explicitly with pkg_attributes.
#   * data/config files - sourced (fish-deploy.sh, imdslib.sh), a fish prompt,
#     core config templates, and the generated systemd units (bundled
#     per-language as bundle_unit_go / bundle_unit_c below). 0644.
pkg_files(
    name = "bundle_exec_scripts",
    srcs = [
        "//deploy/aws:deploy.sh",
        "//deploy/aws:setup-gpu.sh",
        "//core:transcode.sh",
        "//core:notify.sh",
    ],
    attributes = pkg_attributes(mode = "0755"),
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "bundle_scripts",
    srcs = [
        "//deploy/aws:fish-deploy.sh",
        "//deploy/aws:imdslib.sh",
        "//deploy/aws:prompt_login.fish",
        "//core:strimserver.env",
        "//core:mediamtx.yaml.template",
    ],
    attributes = pkg_attributes(mode = "0644"),
    strip_prefix = strip_prefix.files_only(),
)

# The systemd unit is the SECOND bundle member that differs per language (the
# controller image below is the first): the Go bundle ships the generated Go
# unit (//deploy/aws:strimserver_unit_go) and the C bundle the generated C unit
# (//deploy/aws:strimserver_unit_c), both renamed to strimserver.service inside
# the tar so the on-box deploy flow is identical for every bundle. The unit is
# arch-independent: both amd64 and arm64 bundles of a language share the SAME
# generated unit; no arch variants are created. Lane B supplies the two
# expand_template targets (they may emit distinct basenames such as
# strimserver-go.service / strimserver-c.service because two expand_template
# targets cannot both emit strimserver.service); the renames below normalize
# them to strimserver.service regardless of Lane B's output basename.
pkg_files(
    name = "bundle_unit_go",
    srcs = ["//deploy/aws:strimserver_unit_go"],
    attributes = pkg_attributes(mode = "0644"),
    renames = {
        "//deploy/aws:strimserver_unit_go": "strimserver.service",
    },
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "bundle_unit_c",
    srcs = ["//deploy/aws:strimserver_unit_c"],
    attributes = pkg_attributes(mode = "0644"),
    renames = {
        "//deploy/aws:strimserver_unit_c": "strimserver.service",
    },
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "bundle_images",
    srcs = [
        "//core:ffmpeg_image_tar_file",
        "//core:mediamtx_image_tar_file",
        "//core/controller:controller_image_tar_file",
    ],
    renames = {
        "//core:ffmpeg_image_tar_file": "ffmpeg-container.tar",
        "//core:mediamtx_image_tar_file": "mediamtx-container.tar",
        "//core/controller:controller_image_tar_file": "controller-container.tar",
    },
    strip_prefix = strip_prefix.files_only(),
)

# The controller-container.tar member is one of the TWO bundle members that
# differ per language (the other is the generated systemd unit above): the Go
# controller image (:controller_image_tar_file, the long-standing default) or
# the C controller image (:controller_image_c_tar_file, the musl-static port).
# Both land at the same controller-container.tar name so the on-box deploy flow
# is identical for every bundle.
pkg_files(
    name = "bundle_images_c",
    srcs = [
        "//core:ffmpeg_image_tar_file",
        "//core:mediamtx_image_tar_file",
        "//core/controller:controller_image_c_tar_file",
    ],
    renames = {
        "//core:ffmpeg_image_tar_file": "ffmpeg-container.tar",
        "//core:mediamtx_image_tar_file": "mediamtx-container.tar",
        "//core/controller:controller_image_c_tar_file": "controller-container.tar",
    },
    strip_prefix = strip_prefix.files_only(),
    tags = ["manual"],
)

# The offline clip is bundled straight from the external repo so the deployed
# filename stays strimserver-offline-2160p60.mp4 (s3_http_file's
# downloaded_file_name pin).
pkg_files(
    name = "bundle_offline_segment",
    srcs = ["@offline_segment_dist//file"],
    renames = {
        "@offline_segment_dist//file": "strimserver-offline-2160p60.mp4",
    },
    strip_prefix = strip_prefix.files_only(),
)

# The openssh RPM is a required bundle member: it is fetched from the pinned
# @openssh_dist (amd64) / @openssh_dist_arm64 (aarch64) artifacts (built
# out-of-band by tools/openssh/publish.sh), so there is no toggle to gate it.
# s3_http_file's exports_files mode makes each RPM addressable directly
# (@openssh_dist//:openssh-experimental.rpm /
# @openssh_dist_arm64//:openssh-experimental-aarch64.rpm). The member is
# select()ed per target architecture (mirroring the ffmpeg_root pattern) but
# renamed to openssh-experimental.rpm on BOTH arches: deploy.sh checks
# /mnt/nvme/openssh-experimental.rpm.
pkg_files(
    name = "bundle_openssh_rpm",
    srcs = select({
        "//tools/bazel:is_amd64_target": ["@openssh_dist//:openssh-experimental.rpm"],
        "//tools/bazel:is_arm64_target": ["@openssh_dist_arm64//:openssh-experimental-aarch64.rpm"],
    }),
    renames = select({
        "//tools/bazel:is_amd64_target": {},
        "//tools/bazel:is_arm64_target": {
            "@openssh_dist_arm64//:openssh-experimental-aarch64.rpm": "openssh-experimental.rpm",
        },
    }),
    strip_prefix = strip_prefix.files_only(),
)

# --- 4-way deployment bundle matrix -----------------------------------------
# Every release produces FOUR bundles -- the Go controller and the C
# controller, each for amd64 and arm64 -- under fully-explicit names:
#   strimserver-deployment-go-amd64.tar   (+ .sha256)
#   strimserver-deployment-go-arm64.tar   (+ .sha256)
#   strimserver-deployment-c-amd64.tar    (+ .sha256)
#   strimserver-deployment-c-arm64.tar    (+ .sha256)
# The Go bundles reuse the original (pre-dual-arch) tar graph, renamed to the
# explicit go-<arch> scheme; the C bundles swap in the C controller image
# (:bundle_images_c) and are rebuilt under the zig musl configs via
# //:c_controller_transition (which ALSO injects the zig toolchain flags --
# toolchain selection comes from --extra_toolchains, a command-line option a
# plain platform transition cannot set).
#
# Arch handling stays entirely inside Bazel: one `bazel build //:package_all`
# (or one `bazel run //:release` / //:publish_all) produces all four from a
# single analysis pass. The Go arm64 bundle goes through
# //tools/bazel:platform_transition (unchanged behavior); the C bundles go
# through //:c_controller_transition. The C graph is `manual`-tagged: it pulls
# the C controller into the graph, and a plain `bazel build //...` (default
# clang/glibc toolchain) must never build it.

pkg_tar(
    name = "_strimserver_deployment_go_tar_unchecked",
    srcs = [
        ":bundle_images",
        ":bundle_unit_go",
        ":bundle_offline_segment",
        ":bundle_openssh_rpm",
        ":bundle_exec_scripts",
        ":bundle_scripts",
    ],
    out = "strimserver-deployment-go-amd64.unchecked.tar",
)

genrule(
    name = "strimserver_deployment_tar_go_amd64",
    srcs = [
        ":_strimserver_deployment_go_tar_unchecked",
        ":check_no_twitch_key",
    ],
    outs = ["strimserver-deployment-go-amd64.tar"],
    cmd = "cp $(location :_strimserver_deployment_go_tar_unchecked) $@",
)

genrule(
    name = "strimserver_deployment_sha256_go_amd64",
    srcs = [":strimserver_deployment_tar_go_amd64"],
    outs = ["strimserver-deployment-go-amd64.tar.sha256"],
    cmd = "printf '%s  strimserver-deployment-go-amd64.tar\\n' " +
          "\"$$(sha256sum $(location :strimserver_deployment_tar_go_amd64) | cut -d' ' -f1)\" > $@",
)

# --- Go arm64 bundle (the same graph rebuilt under //tools/bazel:linux_arm64)
# via a platform transition, so one `bazel build` produces BOTH Go tars from a
# single analysis pass. The transition output carries the -go-arm64 basename so
# the four bundles never collide on a GitHub release, S3, or sh_binary runfiles.
platform_transition(
    name = "deployment_go_arm64_transition",
    target = ":_strimserver_deployment_go_tar_unchecked",
    # Distinct basename: the underlying pkg_tar keeps
    # strimserver-deployment-go-amd64.unchecked.tar in BOTH configurations, so
    # this symlink name is what keeps the amd64/arm64 tars from colliding in
    # sh_binary runfiles (publish targets pass both to the script).
    out = "strimserver-deployment-go-arm64.unchecked.tar",
)

genrule(
    name = "strimserver_deployment_tar_go_arm64",
    srcs = [
        ":deployment_go_arm64_transition",
        ":check_no_twitch_key",
    ],
    outs = ["strimserver-deployment-go-arm64.tar"],
    cmd = "cp $(location :deployment_go_arm64_transition) $@",
)

genrule(
    name = "strimserver_deployment_sha256_go_arm64",
    srcs = [":strimserver_deployment_tar_go_arm64"],
    outs = ["strimserver-deployment-go-arm64.tar.sha256"],
    cmd = "printf '%s  strimserver-deployment-go-arm64.tar\\n' " +
          "\"$$(sha256sum $(location :strimserver_deployment_tar_go_arm64) | cut -d' ' -f1)\" > $@",
)

# --- C amd64 + arm64 bundles ------------------------------------------------
# The C bundle graph is NEVER built in the top-level config: both variants are
# reached only through //:c_controller_transition, which rebuilds the shared
# pkg_tar under the zig musl amd64 / arm64 config. Both arch configs write the
# C binary under the same exec-platform-named bazel-out directory (the Wave-2
# arch quirk), so the packaging NEVER inspects output paths to tell the arches
# apart: each image embeds whatever binary its configuration produced, and the
# bundles are verified with `file` (see //core/controller:image_c_smoke_test).
pkg_tar(
    name = "_strimserver_deployment_c_tar_unchecked",
    srcs = [
        ":bundle_images_c",
        ":bundle_unit_c",
        ":bundle_offline_segment",
        ":bundle_openssh_rpm",
        ":bundle_exec_scripts",
        ":bundle_scripts",
    ],
    out = "strimserver-deployment-c.unchecked.tar",
    tags = ["manual"],
)

c_controller_transition(
    name = "deployment_c_amd64_transition",
    target = ":_strimserver_deployment_c_tar_unchecked",
    to_arch = "amd64",
    out = "strimserver-deployment-c-amd64.unchecked.tar",
    tags = ["manual"],
)

c_controller_transition(
    name = "deployment_c_arm64_transition",
    target = ":_strimserver_deployment_c_tar_unchecked",
    to_arch = "arm64",
    out = "strimserver-deployment-c-arm64.unchecked.tar",
    tags = ["manual"],
)

genrule(
    name = "strimserver_deployment_tar_c_amd64",
    srcs = [
        ":deployment_c_amd64_transition",
        ":check_no_twitch_key",
    ],
    outs = ["strimserver-deployment-c-amd64.tar"],
    cmd = "cp $(location :deployment_c_amd64_transition) $@",
    tags = ["manual"],
)

genrule(
    name = "strimserver_deployment_sha256_c_amd64",
    srcs = [":strimserver_deployment_tar_c_amd64"],
    outs = ["strimserver-deployment-c-amd64.tar.sha256"],
    cmd = "printf '%s  strimserver-deployment-c-amd64.tar\\n' " +
          "\"$$(sha256sum $(location :strimserver_deployment_tar_c_amd64) | cut -d' ' -f1)\" > $@",
    tags = ["manual"],
)

genrule(
    name = "strimserver_deployment_tar_c_arm64",
    srcs = [
        ":deployment_c_arm64_transition",
        ":check_no_twitch_key",
    ],
    outs = ["strimserver-deployment-c-arm64.tar"],
    cmd = "cp $(location :deployment_c_arm64_transition) $@",
    tags = ["manual"],
)

genrule(
    name = "strimserver_deployment_sha256_c_arm64",
    srcs = [":strimserver_deployment_tar_c_arm64"],
    outs = ["strimserver-deployment-c-arm64.tar.sha256"],
    cmd = "printf '%s  strimserver-deployment-c-arm64.tar\\n' " +
          "\"$$(sha256sum $(location :strimserver_deployment_tar_c_arm64) | cut -d' ' -f1)\" > $@",
    tags = ["manual"],
)

# The publish targets are deliberately UNGATED (they bake the operator's own
# TWITCH_STREAM_KEY, so they must not run check_no_twitch_key). They upload the
# same tars as :package*/:release -- the gated genrules are byte-copies -- so
# the publish data hashes the unchecked tars directly; the .sha256 contents
# still name the published basenames.
genrule(
    name = "strimserver_deployment_sha256_go_amd64_unchecked",
    srcs = [":_strimserver_deployment_go_tar_unchecked"],
    outs = ["strimserver-deployment-go-amd64.unchecked.tar.sha256"],
    cmd = "printf '%s  strimserver-deployment-go-amd64.tar\\n' " +
          "\"$$(sha256sum $(location :_strimserver_deployment_go_tar_unchecked) | cut -d' ' -f1)\" > $@",
)

genrule(
    name = "strimserver_deployment_sha256_go_arm64_unchecked",
    srcs = [":deployment_go_arm64_transition"],
    outs = ["strimserver-deployment-go-arm64.unchecked.tar.sha256"],
    cmd = "printf '%s  strimserver-deployment-go-arm64.tar\\n' " +
          "\"$$(sha256sum $(location :deployment_go_arm64_transition) | cut -d' ' -f1)\" > $@",
)

genrule(
    name = "strimserver_deployment_sha256_c_amd64_unchecked",
    srcs = [":deployment_c_amd64_transition"],
    outs = ["strimserver-deployment-c-amd64.unchecked.tar.sha256"],
    cmd = "printf '%s  strimserver-deployment-c-amd64.tar\\n' " +
          "\"$$(sha256sum $(location :deployment_c_amd64_transition) | cut -d' ' -f1)\" > $@",
    tags = ["manual"],
)

genrule(
    name = "strimserver_deployment_sha256_c_arm64_unchecked",
    srcs = [":deployment_c_arm64_transition"],
    outs = ["strimserver-deployment-c-arm64.unchecked.tar.sha256"],
    cmd = "printf '%s  strimserver-deployment-c-arm64.tar\\n' " +
          "\"$$(sha256sum $(location :deployment_c_arm64_transition) | cut -d' ' -f1)\" > $@",
    tags = ["manual"],
)

# `bazel build //:package` replaces `make package` (the Makefile's default
# goal): the Go amd64 bundle -- the long-standing default controller + arch.
filegroup(
    name = "package",
    srcs = [
        ":strimserver_deployment_sha256_go_amd64",
        ":strimserver_deployment_tar_go_amd64",
    ],
)

# `bazel build //:package_arm64` -- the Go arm64 bundle (+ checksum) alone.
filegroup(
    name = "package_arm64",
    srcs = [
        ":strimserver_deployment_sha256_go_arm64",
        ":strimserver_deployment_tar_go_arm64",
    ],
)

# `bazel build //:package_all` -- ALL FOUR bundles (+ checksums) from one
# invocation: Go + C, amd64 + arm64. Manual: it pulls the C graph in, so a
# plain `bazel build //...` must not pick it up (the C bundles need the zig
# musl configs; the C controller must never build against the default glibc
# toolchain). Explicit `bazel build //:package_all` works fine.
filegroup(
    name = "package_all",
    srcs = [
        ":strimserver_deployment_tar_go_amd64",
        ":strimserver_deployment_tar_go_arm64",
        ":strimserver_deployment_tar_c_amd64",
        ":strimserver_deployment_tar_c_arm64",
        ":strimserver_deployment_sha256_go_amd64",
        ":strimserver_deployment_sha256_go_arm64",
        ":strimserver_deployment_sha256_c_amd64",
        ":strimserver_deployment_sha256_c_arm64",
    ],
    tags = ["manual"],
)

# `bazel run //:release` -- attaches the FOUR deployment bundles (+ checksums)
# and the Stream Deck plugin bundles to the tagged GitHub release, all built in
# this one invocation. Args map to $1..$10 in scripts/release.sh order:
# $1..$4=strimserver_deployment_{go,c}_{amd64,arm64}_tar,
# $5..$8=the four .sha256, $9=streamdeck_plugin_bundle (zip),
# $10=streamdeck_plugin_tar_gz. Manual for the same reason as :package_all.
sh_binary(
    name = "release",
    srcs = ["scripts/release.sh"],
    data = [
        ":strimserver_deployment_tar_go_amd64",
        ":strimserver_deployment_tar_go_arm64",
        ":strimserver_deployment_tar_c_amd64",
        ":strimserver_deployment_tar_c_arm64",
        ":strimserver_deployment_sha256_go_amd64",
        ":strimserver_deployment_sha256_go_arm64",
        ":strimserver_deployment_sha256_c_amd64",
        ":strimserver_deployment_sha256_c_arm64",
        "//tools/streamdeck-plugin:streamdeck_plugin_bundle",
        "//tools/streamdeck-plugin:streamdeck_plugin_tar_gz",
    ],
    args = [
        "$(rootpath :strimserver_deployment_tar_go_amd64)",
        "$(rootpath :strimserver_deployment_tar_go_arm64)",
        "$(rootpath :strimserver_deployment_tar_c_amd64)",
        "$(rootpath :strimserver_deployment_tar_c_arm64)",
        "$(rootpath :strimserver_deployment_sha256_go_amd64)",
        "$(rootpath :strimserver_deployment_sha256_go_arm64)",
        "$(rootpath :strimserver_deployment_sha256_c_amd64)",
        "$(rootpath :strimserver_deployment_sha256_c_arm64)",
        "$(rootpath //tools/streamdeck-plugin:streamdeck_plugin_bundle)",
        "$(rootpath //tools/streamdeck-plugin:streamdeck_plugin_tar_gz)",
    ],
    tags = ["manual"],
)

# `bazel run //:publish_strimserver` -- uploads the FOUR deployment bundles
# (+ checksums, now published on S3) and the Stream Deck plugin bundles, all
# built in this one invocation. Uses the UNCHECKED tars (and their hashes) so
# the no-twitch-key-gate contract is unchanged: the gated genrules are
# byte-copies, so the uploaded content is identical to :package*/:release.
# Args map to $1..$10 in scripts/publish_strimserver.sh order:
# $1..$4=the four unchecked tars (go-amd64, go-arm64, c-amd64, c-arm64),
# $5..$8=the four unchecked .sha256, $9=streamdeck_plugin_bundle (zip),
# $10=streamdeck_plugin_tar_gz.
sh_binary(
    name = "publish_strimserver",
    srcs = ["scripts/publish_strimserver.sh"],
    data = [
        ":_strimserver_deployment_go_tar_unchecked",
        ":deployment_go_arm64_transition",
        ":deployment_c_amd64_transition",
        ":deployment_c_arm64_transition",
        ":strimserver_deployment_sha256_go_amd64_unchecked",
        ":strimserver_deployment_sha256_go_arm64_unchecked",
        ":strimserver_deployment_sha256_c_amd64_unchecked",
        ":strimserver_deployment_sha256_c_arm64_unchecked",
        "//tools/streamdeck-plugin:streamdeck_plugin_bundle",
        "//tools/streamdeck-plugin:streamdeck_plugin_tar_gz",
    ],
    args = [
        "$(rootpath :_strimserver_deployment_go_tar_unchecked)",
        "$(rootpath :deployment_go_arm64_transition)",
        "$(rootpath :deployment_c_amd64_transition)",
        "$(rootpath :deployment_c_arm64_transition)",
        "$(rootpath :strimserver_deployment_sha256_go_amd64_unchecked)",
        "$(rootpath :strimserver_deployment_sha256_go_arm64_unchecked)",
        "$(rootpath :strimserver_deployment_sha256_c_amd64_unchecked)",
        "$(rootpath :strimserver_deployment_sha256_c_arm64_unchecked)",
        "$(rootpath //tools/streamdeck-plugin:streamdeck_plugin_bundle)",
        "$(rootpath //tools/streamdeck-plugin:streamdeck_plugin_tar_gz)",
    ],
    tags = ["manual"],
)

# `bazel run //:publish_all` -- the one-shot "publish everything" path
# (`make publish-all`): uploads ALL S3 artifacts -- the FOUR strimserver
# deployment tars (+ checksums), the Stream Deck plugin bundle (.zip +
# .tar.gz), and the iperf3 bundle -- in a SINGLE bazel run (one server/analysis
# pass). As with publish_strimserver, the UNCHECKED tars (+ hashes) keep the
# publish path free of the twitch-key gate. Args map to $1..$11 in order:
# $1..$4=the four unchecked tars, $5..$8=the four unchecked .sha256,
# $9=streamdeck_plugin_bundle (zip), $10=streamdeck_plugin_tar_gz,
# $11=iperf3_deployment_tar. Uses the same S3 object keys as the individual
# targets (bucket root); see publish_all.sh.
sh_binary(
    name = "publish_all",
    srcs = ["scripts/publish_all.sh"],
    data = [
        ":_strimserver_deployment_go_tar_unchecked",
        ":deployment_go_arm64_transition",
        ":deployment_c_amd64_transition",
        ":deployment_c_arm64_transition",
        ":strimserver_deployment_sha256_go_amd64_unchecked",
        ":strimserver_deployment_sha256_go_arm64_unchecked",
        ":strimserver_deployment_sha256_c_amd64_unchecked",
        ":strimserver_deployment_sha256_c_arm64_unchecked",
        "//tools/bandwidth-test:iperf3_deployment_tar",
        "//tools/streamdeck-plugin:streamdeck_plugin_bundle",
        "//tools/streamdeck-plugin:streamdeck_plugin_tar_gz",
    ],
    args = [
        "$(rootpath :_strimserver_deployment_go_tar_unchecked)",
        "$(rootpath :deployment_go_arm64_transition)",
        "$(rootpath :deployment_c_amd64_transition)",
        "$(rootpath :deployment_c_arm64_transition)",
        "$(rootpath :strimserver_deployment_sha256_go_amd64_unchecked)",
        "$(rootpath :strimserver_deployment_sha256_go_arm64_unchecked)",
        "$(rootpath :strimserver_deployment_sha256_c_amd64_unchecked)",
        "$(rootpath :strimserver_deployment_sha256_c_arm64_unchecked)",
        "$(rootpath //tools/streamdeck-plugin:streamdeck_plugin_bundle)",
        "$(rootpath //tools/streamdeck-plugin:streamdeck_plugin_tar_gz)",
        "$(rootpath //tools/bandwidth-test:iperf3_deployment_tar)",
    ],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# `bazel run //:bump_version -- patch` -- bumps the latest vX.Y.Z git tag
# (`make bump-version LEVEL=patch`). Tag-based versioning: git tags are the
# source of truth (no VERSION file). Reads git directly from the repo root;
# no data/args.
sh_binary(
    name = "bump_version",
    srcs = ["scripts/bump-version.sh"],
    visibility = ["//visibility:public"],
)
