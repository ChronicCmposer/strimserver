# strimserver root package.

load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//tools/bazel:platform_transition.bzl", "platform_transition")

# --- Offline fallback segment --------------------------------------------
# The fallback clip is fetched by default through MODULE.bazel's
# s3_http_file(name = "offline_segment_dist") and bundled directly into the
# deployment tar (the clip is produced out-of-band on macOS by
# tools/brb-screen/publish.sh -- the encode uses VideoToolbox/AudioToolbox
# codecs that cannot run in the Bazel graph).

# --- No-Twitch-key gate ---------------------------------------------------
# Gates :strimserver_deployment_tar (used by :package and :release) but NOT
# :publish_strimserver, matching the Makefile exactly (verified: `package`'s
# recipe calls check-no-twitch-key explicitly; `publish-strimserver` depends
# only on the tar target, which never invoked the check itself).
genrule(
    name = "check_no_twitch_key",
    srcs = ["//core:strimserver.env"],
    outs = ["check_no_twitch_key.ok"],
    cmd = """
key="$$(set -a; . $(location //core:strimserver.env); set +a; printf '%s' "$$TWITCH_STREAM_KEY")"
if [ -n "$$key" ]; then
  echo "ERROR: TWITCH_STREAM_KEY is set in core/strimserver.env." >&2
  echo "Redistributable bundles must ship an EMPTY key (injected at deploy time)." >&2
  echo "Empty it for :strimserver_deployment_tar / :release, or use" >&2
  echo ":publish_strimserver for a private, single-tenant build that bakes your own key." >&2
  exit 1
fi
touch $@
""",
)

# --- Bundle ----------------------------------------------------------------
# pkg_tar + strip_prefix.files_only() replaces GNU tar --transform, matching
# the Makefile's flattened layout exactly. Drops --ignore-failed-read: a
# missing input now fails the build loudly (exactly what would have
# surfaced bug #4 -- the broken publish-iperf3 deps -- years ago) instead of
# silently shipping an incomplete bundle.

pkg_files(
    name = "bundle_scripts",
    srcs = [
        "//deploy/aws:deploy.sh",
        "//deploy/aws:fish-deploy.sh",
        "//deploy/aws:imdslib.sh",
        "//deploy/aws:prompt_login.fish",
        "//deploy/aws:setup-gpu.sh",
        "//deploy/aws:strimserver.service",
        "//core:strimserver.env",
        "//core:mediamtx.yaml.template",
        "//core:transcode.sh",
        "//core:notify.sh",
    ],
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "bundle_images",
    srcs = [
        "//core:ffmpeg_image_tar_file",
        "//core:mediamtx_image_tar_file",
        "//core/controller:controller_image_tar_file",
    ],
    renames = {
        "//core:ffmpeg_image_tar_file": "ffmpeg-container.tar",
        "//core:mediamtx_image_tar_file": "mediamtx-container.tar",
        "//core/controller:controller_image_tar_file": "controller-container.tar",
    },
    strip_prefix = strip_prefix.files_only(),
)

# The offline clip is bundled straight from the external repo so the deployed
# filename stays strimserver-offline-2160p60.mp4 (s3_http_file's
# downloaded_file_name pin).
pkg_files(
    name = "bundle_offline_segment",
    srcs = ["@offline_segment_dist//file"],
    renames = {
        "@offline_segment_dist//file": "strimserver-offline-2160p60.mp4",
    },
    strip_prefix = strip_prefix.files_only(),
)

# The openssh RPM is a required bundle member: it is fetched from the pinned
# @openssh_dist (amd64) / @openssh_dist_arm64 (aarch64) artifacts (built
# out-of-band by tools/openssh/publish.sh), so there is no toggle to gate it.
# s3_http_file's exports_files mode makes each RPM addressable directly
# (@openssh_dist//:openssh-experimental.rpm /
# @openssh_dist_arm64//:openssh-experimental-aarch64.rpm). The member is
# select()ed per target architecture (mirroring the ffmpeg_root pattern) but
# renamed to openssh-experimental.rpm on BOTH arches: deploy.sh checks
# /mnt/nvme/openssh-experimental.rpm.
pkg_files(
    name = "bundle_openssh_rpm",
    srcs = select({
        "//tools/bazel:is_amd64_target": ["@openssh_dist//:openssh-experimental.rpm"],
        "//tools/bazel:is_arm64_target": ["@openssh_dist_arm64//:openssh-experimental-aarch64.rpm"],
    }),
    renames = select({
        "//tools/bazel:is_amd64_target": {},
        "//tools/bazel:is_arm64_target": {
            "@openssh_dist_arm64//:openssh-experimental-aarch64.rpm": "openssh-experimental.rpm",
        },
    }),
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "_strimserver_deployment_tar_unchecked",
    srcs = [
        ":bundle_images",
        ":bundle_offline_segment",
        ":bundle_openssh_rpm",
        ":bundle_scripts",
    ],
    out = "strimserver-deployment.unchecked.tar",
)

genrule(
    name = "strimserver_deployment_tar",
    srcs = [
        ":_strimserver_deployment_tar_unchecked",
        ":check_no_twitch_key",
    ],
    outs = ["strimserver-deployment.tar"],
    cmd = "cp $(location :_strimserver_deployment_tar_unchecked) $@",
)

genrule(
    name = "strimserver_deployment_sha256",
    srcs = [":strimserver_deployment_tar"],
    outs = ["strimserver-deployment.tar.sha256"],
    cmd = "printf '%s  strimserver-deployment.tar\\n' " +
          "\"$$(sha256sum $(location :strimserver_deployment_tar) | cut -d' ' -f1)\" > $@",
)

# --- arm64 bundle (produced in the SAME invocation as the amd64 bundle) -------
# The deployment tar graph is platform-selectable; the arm64 bundle is the same
# unchecked pkg_tar rebuilt under //tools/bazel:linux_arm64 via a platform
# transition, so one `bazel build` (or one `bazel run //:release` /
# //:publish_all) produces BOTH tars from a single analysis pass. The arm64
# outputs carry the -arm64 basename so the two bundles never collide on a
# GitHub release or S3; the amd64 basename stays unsuffixed (byte-identical to
# the pre-dual-arch artifacts).
platform_transition(
    name = "deployment_tar_arm64_transition",
    target = ":_strimserver_deployment_tar_unchecked",
    # Distinct basename: the underlying pkg_tar keeps
    # strimserver-deployment.unchecked.tar in BOTH configurations, so this
    # symlink name is what keeps the amd64/arm64 tars from colliding in
    # sh_binary runfiles (publish targets pass both to the script).
    out = "strimserver-deployment-arm64.unchecked.tar",
)

genrule(
    name = "strimserver_deployment_tar_arm64",
    srcs = [
        ":deployment_tar_arm64_transition",
        ":check_no_twitch_key",
    ],
    outs = ["strimserver-deployment-arm64.tar"],
    cmd = "cp $(location :deployment_tar_arm64_transition) $@",
)

genrule(
    name = "strimserver_deployment_sha256_arm64",
    srcs = [":strimserver_deployment_tar_arm64"],
    outs = ["strimserver-deployment-arm64.tar.sha256"],
    cmd = "printf '%s  strimserver-deployment-arm64.tar\\n' " +
          "\"$$(sha256sum $(location :strimserver_deployment_tar_arm64) | cut -d' ' -f1)\" > $@",
)

# The publish targets are deliberately UNGATED (they bake the operator's own
# TWITCH_STREAM_KEY, so they must not run check_no_twitch_key). They upload the
# same tars as :package/:release -- the gated genrules are byte-copies -- so
# the publish data hashes the unchecked tars directly; the .sha256 contents
# still name the published basenames.
genrule(
    name = "strimserver_deployment_sha256_unchecked",
    srcs = [":_strimserver_deployment_tar_unchecked"],
    outs = ["strimserver-deployment.unchecked.tar.sha256"],
    cmd = "printf '%s  strimserver-deployment.tar\\n' " +
          "\"$$(sha256sum $(location :_strimserver_deployment_tar_unchecked) | cut -d' ' -f1)\" > $@",
)

genrule(
    name = "strimserver_deployment_sha256_arm64_unchecked",
    srcs = [":deployment_tar_arm64_transition"],
    outs = ["strimserver-deployment-arm64.unchecked.tar.sha256"],
    cmd = "printf '%s  strimserver-deployment-arm64.tar\\n' " +
          "\"$$(sha256sum $(location :deployment_tar_arm64_transition) | cut -d' ' -f1)\" > $@",
)

# `bazel build //:package` replaces `make package` (the Makefile's default goal).
filegroup(
    name = "package",
    srcs = [
        ":strimserver_deployment_sha256",
        ":strimserver_deployment_tar",
    ],
)

# `bazel build //:package_arm64` -- the arm64 bundle (+ checksum) alone.
filegroup(
    name = "package_arm64",
    srcs = [
        ":strimserver_deployment_sha256_arm64",
        ":strimserver_deployment_tar_arm64",
    ],
)

# `bazel run //:release` -- attaches BOTH architecture bundles (+ checksums)
# and the Stream Deck plugin bundles to the tagged GitHub release, all built in
# this one invocation. Args map to $1..$6 in scripts/release.sh order:
# $1=strimserver_deployment_tar, $2=strimserver_deployment_tar_arm64,
# $3=strimserver_deployment_sha256, $4=strimserver_deployment_sha256_arm64,
# $5=streamdeck_plugin_bundle (zip), $6=streamdeck_plugin_tar_gz.
sh_binary(
    name = "release",
    srcs = ["scripts/release.sh"],
    data = [
        ":strimserver_deployment_tar",
        ":strimserver_deployment_tar_arm64",
        ":strimserver_deployment_sha256",
        ":strimserver_deployment_sha256_arm64",
        "//tools/streamdeck-plugin:streamdeck_plugin_bundle",
        "//tools/streamdeck-plugin:streamdeck_plugin_tar_gz",
    ],
    args = [
        "$(rootpath :strimserver_deployment_tar)",
        "$(rootpath :strimserver_deployment_tar_arm64)",
        "$(rootpath :strimserver_deployment_sha256)",
        "$(rootpath :strimserver_deployment_sha256_arm64)",
        "$(rootpath //tools/streamdeck-plugin:streamdeck_plugin_bundle)",
        "$(rootpath //tools/streamdeck-plugin:streamdeck_plugin_tar_gz)",
    ],
)

# `bazel run //:publish_strimserver` -- uploads BOTH architecture bundles
# (+ checksums, now published on S3) and the Stream Deck plugin bundles, all
# built in this one invocation. Uses the UNCHECKED tars (and their hashes) so
# the no-twitch-key-gate contract is unchanged: the gated genrules are
# byte-copies, so the uploaded content is identical to :package/:release.
# Args map to $1..$6 in scripts/publish_strimserver.sh order:
# $1=_strimserver_deployment_tar_unchecked, $2=deployment_tar_arm64_transition,
# $3=strimserver_deployment_sha256_unchecked,
# $4=strimserver_deployment_sha256_arm64_unchecked,
# $5=streamdeck_plugin_bundle (zip), $6=streamdeck_plugin_tar_gz.
sh_binary(
    name = "publish_strimserver",
    srcs = ["scripts/publish_strimserver.sh"],
    data = [
        ":_strimserver_deployment_tar_unchecked",
        ":deployment_tar_arm64_transition",
        ":strimserver_deployment_sha256_unchecked",
        ":strimserver_deployment_sha256_arm64_unchecked",
        "//tools/streamdeck-plugin:streamdeck_plugin_bundle",
        "//tools/streamdeck-plugin:streamdeck_plugin_tar_gz",
    ],
    args = [
        "$(rootpath :_strimserver_deployment_tar_unchecked)",
        "$(rootpath :deployment_tar_arm64_transition)",
        "$(rootpath :strimserver_deployment_sha256_unchecked)",
        "$(rootpath :strimserver_deployment_sha256_arm64_unchecked)",
        "$(rootpath //tools/streamdeck-plugin:streamdeck_plugin_bundle)",
        "$(rootpath //tools/streamdeck-plugin:streamdeck_plugin_tar_gz)",
    ],
)

# `bazel run //:publish_all` -- the one-shot "publish everything" path
# (`make publish-all`): uploads ALL S3 artifacts -- BOTH strimserver deployment
# tars (+ checksums), the Stream Deck plugin bundle (.zip + .tar.gz), and the
# iperf3 bundle -- in a SINGLE bazel run (one server/analysis pass) rather than
# the individual publish-* targets. As with publish_strimserver, the UNCHECKED
# tars (+ hashes) keep the publish path free of the twitch-key gate. Args map
# to $1..$7 in order: $1=_strimserver_deployment_tar_unchecked,
# $2=deployment_tar_arm64_transition, $3=strimserver_deployment_sha256_unchecked,
# $4=strimserver_deployment_sha256_arm64_unchecked,
# $5=streamdeck_plugin_bundle (zip), $6=streamdeck_plugin_tar_gz,
# $7=iperf3_deployment_tar. Uses the same S3 object keys as the individual
# targets (bucket root); see publish_all.sh.
sh_binary(
    name = "publish_all",
    srcs = ["scripts/publish_all.sh"],
    data = [
        ":_strimserver_deployment_tar_unchecked",
        ":deployment_tar_arm64_transition",
        ":strimserver_deployment_sha256_unchecked",
        ":strimserver_deployment_sha256_arm64_unchecked",
        "//tools/bandwidth-test:iperf3_deployment_tar",
        "//tools/streamdeck-plugin:streamdeck_plugin_bundle",
        "//tools/streamdeck-plugin:streamdeck_plugin_tar_gz",
    ],
    args = [
        "$(rootpath :_strimserver_deployment_tar_unchecked)",
        "$(rootpath :deployment_tar_arm64_transition)",
        "$(rootpath :strimserver_deployment_sha256_unchecked)",
        "$(rootpath :strimserver_deployment_sha256_arm64_unchecked)",
        "$(rootpath //tools/streamdeck-plugin:streamdeck_plugin_bundle)",
        "$(rootpath //tools/streamdeck-plugin:streamdeck_plugin_tar_gz)",
        "$(rootpath //tools/bandwidth-test:iperf3_deployment_tar)",
    ],
    visibility = ["//visibility:public"],
)

# `bazel run //:bump_version -- patch` -- bumps the latest vX.Y.Z git tag
# (`make bump-version LEVEL=patch`). Tag-based versioning: git tags are the
# source of truth (no VERSION file). Reads git directly from the repo root;
# no data/args.
sh_binary(
    name = "bump_version",
    srcs = ["scripts/bump-version.sh"],
    visibility = ["//visibility:public"],
)
