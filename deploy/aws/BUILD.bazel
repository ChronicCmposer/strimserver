load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(
    [
        "containerd-config.toml",
        "containerd-nvme.conf",
        "deploy.sh",
        "fish-deploy.sh",
        "imdslib.sh",
        "prompt_login.fish",
        "setup-gpu.sh",
        "stackctl-phase0-inventory.sh",
        "stackctl-setup.sh",
        "stackctl.sh",
        "strim-ddns.service.template",
        "strim-ddns-verify.service.template",
        "strim-ddns.timer",
    ],
    # deploy.sh is consumed by //core:security_hygiene_test; stackctl-setup.sh
    # is a member of the deployment tar assembled by the root package.
    visibility = ["//visibility:public"],
)

# --- stackctl wrapper -------------------------------------------------------
# Runs the pinned @stackctl binary against deploy/aws so operators never need
# an installed stackctl. See docs/onboarding.md Step 2 in the stackctl repo.
sh_binary(
    name = "stackctl",
    srcs = ["stackctl.sh"],
    data = ["@stackctl//core/cli/dispatch:stackctl"],
    env = {
        # rlocationpath (not rootpath): under bzlmod the external repo lives at
        # the runfiles root, not below the main-repo package directory.
        "STACKCTL_BIN": "$(rlocationpath @stackctl//core/cli/dispatch:stackctl)",
    },
)

# --- Generated systemd units (Go / C controller variants) --------------------
# Both controller variants share ONE unit template (strimserver.service.template)
# — a verbatim copy of the former static deploy/aws/strimserver.service with two
# placeholders:
#   __IMAGE__     -> the OCI image reference
#   __CONTAINER__ -> the container name used by the ctr run/kill/delete calls
#
# OUTPUT DISAMBIGUATION (IMPORTANT): two expand_template targets in the same
# package cannot both emit "strimserver.service" (duplicate output file), and
# that basename also collides with the still-present static source file
# deploy/aws/strimserver.service (until it is removed). Each target therefore
# emits a DISTINCT basename:
#   //deploy/aws:strimserver_unit_go -> strimserver-go.service
#   //deploy/aws:strimserver_unit_c  -> strimserver-c.service
# Bundle consumers (the root BUILD.bazel pkg_files) must RENAME the member to
# "strimserver.service" at packaging time via `renames`, e.g.
#   renames = {"//deploy/aws:strimserver_unit_go": "strimserver.service"}
# which matches the existing controller-container.tar rename pattern used by
# :bundle_images / :bundle_images_c.
#
# The C unit is a pure text expansion (no C toolchain in the graph), so it is
# intentionally NOT tagged manual: it builds in the default config and is
# config-independent.
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")

expand_template(
    name = "strimserver_unit_go",
    template = "strimserver.service.template",
    out = "strimserver-go.service",
    substitutions = {
        "__IMAGE__": "docker.io/library/strimserver-controller-go:latest",
        "__CONTAINER__": "strimserver-controller-go",
    },
    visibility = ["//visibility:public"],
)

expand_template(
    name = "strimserver_unit_c",
    template = "strimserver.service.template",
    out = "strimserver-c.service",
    substitutions = {
        "__IMAGE__": "docker.io/library/strimserver-controller-c:latest",
        "__CONTAINER__": "strimserver-controller-c",
    },
    visibility = ["//visibility:public"],
)

# --- Generated DDNS unit -----------------------------------------------------
# The strim-ddns unit was a static, committed file that HARDCODED the operator's
# domain (DDNS_HOST=strim / DDNS_DOMAIN=example.com). It is now generated from
# strim-ddns.service.template, mirroring the strimserver unit pattern: only the
# OCI image ref and container name are baked in at build time (__IMAGE__ /
# __CONTAINER__); the operator's DDNS_HOST / DDNS_DOMAIN (and optional DDNS_IP)
# are injected at runtime via the EnvironmentFile
# (/mnt/nvme/config/strimserver.env), so the unit itself contains no domain.
# Single target: no per-language variants, and the former static source file is
# gone, so `out = "strim-ddns.service"` emits the canonical basename directly
# (no rename needed at the bundle consumer).
expand_template(
    name = "strim_ddns_unit",
    template = "strim-ddns.service.template",
    out = "strim-ddns.service",
    substitutions = {
        "__IMAGE__": "docker.io/library/strim-ddns:latest",
        "__CONTAINER__": "strim-ddns",
    },
    visibility = ["//visibility:public"],
)

# --- Deploy helper unit tests ------------------------------------------------
# deploy_helpers_test.sh drives the pure helpers in lib/deploy.sh (passphrase
# generation/containerd root+state/logs-dir) through a recording fake sudo, so
# the suite needs no root. `deploy.sh` is a data input for the static
# no-passphrase-print assertion.
sh_test(
    name = "deploy_helpers_test",
    srcs = ["deploy_helpers_test.sh"],
    data = [
        "//deploy/aws/lib:deploy.sh",
        "containerd-config.toml",
        "deploy.sh",
    ],
)

# Baked-AMI deploy fast path. These execute deploy/aws/deploy.sh end-to-end
# against testutil_fake_gpu.sh's deploy sandbox (fake sudo/sysroot + ctr/
# nvidia-ctk/systemctl), so no root or /mnt/nvme is required:
#   * deploy_floor_check_test -- below-floor driver fails fast with remediation;
#     floor met generates the amd64 CDI spec at deploy time; setup-gpu.sh is
#     never invoked.
#   * deploy_ddns_blocking_test -- the two-milestone blocking contract: M1 is
#     the last line before the DDNS block, the block contains ONLY the two
#     bounded unit starts, and M2 is the last output line.
#   * deploy_budget_test      -- full fast path: no sleep/dnf/setup-gpu,
#     compare-before-restart containerd, parallel image imports with a barrier.
sh_test(
    name = "deploy_floor_check_test",
    srcs = ["deploy_floor_check_test.sh"],
    data = [
        "//deploy/aws/lib:deploy.sh",
        "//deploy/aws/lib:nvidia.sh",
        "containerd-config.toml",
        "containerd-nvme.conf",
        "deploy.sh",
        "testutil_fake_gpu.sh",
    ],
)

sh_test(
    name = "deploy_ddns_blocking_test",
    srcs = ["deploy_ddns_blocking_test.sh"],
    # The signal/interrupt cases wait on a fake blocking start; keep the test
    # from tripping the default 60s small-test timeout on slow sandboxes.
    size = "medium",
    data = [
        "//deploy/aws/lib:deploy.sh",
        "//deploy/aws/lib:nvidia.sh",
        "containerd-config.toml",
        "deploy.sh",
        "imdslib.sh",
        "strim-ddns.service.template",
        "strim-ddns.timer",
        "strim-ddns-verify.service.template",
        "strimserver.service.template",
        "testutil_fake_gpu.sh",
    ],
)

sh_test(
    name = "deploy_budget_test",
    srcs = ["deploy_budget_test.sh"],
    data = [
        "//deploy/aws/lib:deploy.sh",
        "//deploy/aws/lib:nvidia.sh",
        "containerd-config.toml",
        "deploy.sh",
        "strim-ddns.service.template",
        "strim-ddns-verify.service.template",
        "testutil_fake_gpu.sh",
    ],
)

# fish_deploy_test.sh sources fish-deploy.sh (FISH_DEPLOY_LIB_ONLY=1) and drives
# fish_write_system_config through a recording fake sudo. Regression for the
# umask 077 / 0700-parent bug that truncated config.fish to the prompt body.
sh_test(
    name = "fish_deploy_test",
    srcs = ["fish_deploy_test.sh"],
    data = ["fish-deploy.sh"],
)

# --- NVIDIA driver floor (620.70.06) -----------------------------------------
# lib/nvidia.sh owns the version compare, detection precedence and the
# stage-then-swap upgrade. These tests drive it (and setup-gpu.sh) through
# testutil_fake_gpu.sh, which installs PATH shims for nvidia-smi, dnf, rpm,
# modinfo, systemctl, rmmod/modprobe/depmod, fuser and a recording fake-sudo.
sh_test(
    name = "nvidia_version_test",
    srcs = ["nvidia_version_test.sh"],
    data = [
        "//deploy/aws/lib:nvidia.sh",
        "testutil_fake_gpu.sh",
    ],
)

sh_test(
    name = "setup_driver_test",
    srcs = ["setup_driver_test.sh"],
    data = [
        "//deploy/aws/lib:nvidia.sh",
        "testutil_fake_gpu.sh",
    ],
)

# setup-gpu.sh is owned by the deploy-wiring lane; this target still runs in the
# default test set and fails loudly until that script calls
# nvidia_ensure_driver_floor before the nvidia-smi guard.
sh_test(
    name = "setup_gpu_test",
    srcs = ["setup_gpu_test.sh"],
    data = [
        "//deploy/aws/lib:nvidia.sh",
        "setup-gpu.sh",
        "testutil_fake_gpu.sh",
    ],
)

# stackctl_render_env_test.sh sources stackctl-setup.sh (BASH_SOURCE dir) and
# asserts render_env's merge/overlay behavior: the packaged strimserver.env is the
# render source, with the SSM-fetched Twitch key overlaid onto its
# TWITCH_STREAM_KEY= line. Keep this in the `//deploy/aws:all` regression gate or
# a future render_env break would ship example env values unnoticed.
sh_test(
    name = "stackctl_render_env_test",
    srcs = ["stackctl_render_env_test.sh"],
    data = ["stackctl-setup.sh"],
)

