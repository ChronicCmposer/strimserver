# aws_profile_test.sh asserts every AWS-invoking tooling script pins the
# project-scoped [strimserver] profile AND never calls the AWS CLI directly:
# every call must route through the shared aws_strim wrapper (a bare
# `aws <service>` invocation is flagged; `command -v aws`, comments and
# echo/printf prose are not). It is NOT self-contained -- it greps sources
# across several packages (scripts/*.sh, tools/ffmpeg-dist, tools/openssh,
# tools/brb-screen, tools/bandwidth-test, tools/streamdeck-plugin) that are not
# exported as Bazel targets, and its behavioural checks assume a full checkout
# (they cd to the repo root and resolve the lib by walking up), so a sandboxed
# test action cannot run it. Wiring the cross-package sources as data would
# require exports_files in the root and tools/* packages (outside this package's
# ownership) plus a runfiles-aware rewrite. It is therefore wired here so it is
# addressable/discoverable, but tagged `manual` (excluded from
# `//deploy/aws/...` wildcards). The standalone run is the authoritative gate:
#   bash deploy/aws/aws_profile_test.sh
sh_test(
    name = "aws_profile_test",
    srcs = ["aws_profile_test.sh"],
    data = [
        "//deploy/aws/lib:aws_profile.sh",
        "launch",
        "terminate",
        "testutil_fake_aws.sh",
    ],
    tags = ["manual"],
)

