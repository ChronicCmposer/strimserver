PATH="$PATH:/path/to/projects/strimserver/deploy/aws"   # so the helper scripts are on $PATH

SSH_CMD="ssh"          # override if you need flags, e.g. "ssh -i ~/.ssh/strim.pem"
SCP_CMD="scp"          # used only for local-file deployment uploads
SSH_HOST="strimserver"
SSH_USER="ec2-user"
SSH_PORT="22"

# --- Deployment source --------------------------------------------------------
# The bundle is published per architecture: amd64 keeps the unsuffixed
# strimserver-deployment.tar (byte-identical to the pre-dual-arch assets) and
# arm64 ships strimserver-deployment-arm64.tar. Point DEPLOYMENT_SRC at the
# asset for the INSTANCE_TYPE's arch.
# setup_strimserver auto-detects by prefix:
#   https:// -> the box downloads it with curl (GitHub release asset; no AWS creds)
#   s3://    -> the box pulls it with `aws s3 cp` (box needs S3 read IAM)
#   /path    -> your local file is uploaded with scp (box needs nothing but SSH)
DEPLOYMENT_SRC="https://github.com/ChronicCmposer/strimserver/releases/download/v1.0.0/strimserver-deployment.tar"

# arm64 (g5g.2xlarge / ARCH=arm64) uses the -arm64 bundle:
# DEPLOYMENT_SRC="https://github.com/ChronicCmposer/strimserver/releases/download/v1.0.0/strimserver-deployment-arm64.tar"
# (launch also defaults the unset arm64 vars to the latest arm64 release asset:
#  DEPLOYMENT=strimserver-deployment-arm64.tar,
#  DEPLOYMENT_SRC=https://github.com/ChronicCmposer/strimserver/releases/latest/download/strimserver-deployment-arm64.tar,
#  and DEPLOYMENT_SHA256 from the arm64 .sha256 asset.)

# Or a file you downloaded from the release:
# DEPLOYMENT_SRC="$HOME/Downloads/strimserver-deployment.tar"
# DEPLOYMENT_SRC="$HOME/Downloads/strimserver-deployment-arm64.tar"

# Optional: verify against the sha256 published next to the release asset
# (both arches publish one: strimserver-deployment.tar.sha256 /
#  strimserver-deployment-arm64.tar.sha256).
# DEPLOYMENT_SHA256="<64-hex-digits>"

# Legacy S3 path (used only if DEPLOYMENT_SRC is unset):
# S3_BUCKET="s3://<bucket-name>"
# DEPLOYMENT="strimserver-deployment.tar"        # amd64 (the default)
# DEPLOYMENT="strimserver-deployment-arm64.tar"  # arm64 (launch defaults it)

# --- Twitch egress key (secret, injected at deploy time) ----------------------
# Get this from your Twitch dashboard. It is transferred to the instance over
# scp as a 0600 file and written into the on-box strimserver.env by deploy.sh;
# it is NOT baked into the deployment bundle.
TWITCH_STREAM_KEY="live_xxxxxxxxxxxxxxxx"

# Alternatively, point at a file that contains only the key (overridden by the
# inline value above if both are set):
# TWITCH_STREAM_KEY_FILE="$HOME/.config/strimserver/twitch-stream-key"

# --- Infra resolution (CloudFormation stack outputs) --------------------------
CFN_STACK_NAME="strimserver"      # stack from strimserver-infra.yaml
PROJECT_NAME="strimserver"        # tag launch applies / terminate matches

# --- Per-launch settings ------------------------------------------------------
KEY_NAME="my-ec2-keypair"         # REQUIRED: EC2 key pair name for SSH
SUBNET_ID=""                      # subnet in the SG's VPC (blank = a default subnet)
INSTANCE_TYPE="g6.xlarge"
# arm64 target for the aarch64 controller (Graviton2 CPU + T4G GPU, sm_75):
# INSTANCE_TYPE="g5g.2xlarge"
#   - amd64 keeps the x86_64 T4 types: g6.xlarge (above) or g4dn.xlarge
# ARCH=""                         # optional override: "amd64"/"x86_64" or "arm64"/"aarch64"
#                                 # (default: inferred from the INSTANCE_TYPE family:
#                                 #  g5g/c6g/m6g/r6g/a1/g6g/7g -> arm64, else amd64)
# AMI_ID=""                       # optional explicit AMI; default: pinned us-east-2 AL2023 DLAMI
# DLAMI_SSM_PARAM=""              # optional override: resolve the AL2023 GPU DLAMI via this SSM path
#                                 # instead of the pin (the default AMI is pinned for us-east-2; a
#                                 # different region requires AMI_ID or DLAMI_SSM_PARAM)
# SECURITY_GROUP_ID=""            # optional override of the stack output
# IAM_INSTANCE_PROFILE=""         # optional override of the stack output
