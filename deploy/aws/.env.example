# stackctl configuration for strimserver (migration pilot, stackctl v0.1.2).
#
# Copy to deploy/aws/.env (gitignored) and fill in every TODO(operator) value.
# Unknown keys are hard errors; validation is fail-closed before any AWS call.
# Keys in the 36-key allowlist that have safe built-in defaults are shown
# commented so the effective value is documented without over-riding it.

# --- Identity --------------------------------------------------------------
PROJECT=strimserver
REGION=us-east-2
ARCH=amd64

# --- AMI / image policy ----------------------------------------------------
# pinned | ssm | baked. strimserver selects the output of the baked pipeline.
AMI_POLICY=baked

# AMI_POLICY=pinned only:
# AMI_ID_AMD64=ami-0123456789abcdef0
# AMI_ID_ARM64=ami-0123456789abcdef0
# AMI_POLICY=ssm only (must be an absolute SSM parameter path):
# AMI_SSM_AMD64=/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64
# AMI_SSM_ARM64=/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64

# --- Compute ---------------------------------------------------------------
SPOT_DEFAULT=true
INSTANCE_TYPES_AMD64=g4dn.xlarge
# INSTANCE_TYPES_ARM64 is required only when ARCH=arm64 or ARCH=both.
# INSTANCE_TYPES_ARM64=g5g.xlarge
ROOT_VOLUME_SIZE=100
# ROOT_VOLUME_TYPE=gp3
# SSH_USER=ec2-user
# SSH_PORT=22

# --- Access ----------------------------------------------------------------
# TODO(operator): EC2 key pair name (formally deploy/aws/.env KEY_NAME).
KEY_NAME=my-strimserver-keypair
# TODO(operator): private key path on the operator machine.
SSH_IDENTITY=/home/operator/.ssh/strimserver-key.pem
# The single CIDR allowed to reach SSH (22), the controller (4000) and the
# experimental SSH port (2222). No default; launch refuses when this is empty.
# Value from the Phase 0 inventory (old stack OperatorCidr).
OPERATOR_CIDR=104.218.148.0/24

# --- Buckets / CI ----------------------------------------------------------
BUCKET_MODULES=artifact
# Optional: add "cert" when a certificate bucket is needed.
# BUCKET_MODULES=artifact,cert
RELEASE_PREFIXES=releases/
ENABLE_IMAGE_BUILDER=true
# Parent image for the BakedImage pipeline (valid only with the builder on).
IMAGE_BUILDER_PARENT_IMAGE=ami-0198b63ccfac121e8
ENABLE_SPOT_ALERTS=false
# SPOT_ALERT_EMAIL=ops@example.com
# PERMISSIONS_BOUNDARY_ARN=arn:aws:iam::123456789012:policy/operator-boundary

# --- On-box setup ----------------------------------------------------------
# Runs on the instance as root; renders the runtime env and hands off to
# deploy.sh (see deploy/aws/stackctl-setup.sh).
SETUP_ENTRYPOINT=stackctl-setup.sh
SERVICE_UNIT=strimserver.service

# --- Ingress ---------------------------------------------------------------
# Slots start at 0 because the SSH is a separate template rule. All three
# application rules are operator-restricted, matching the pre-migration
# security group exactly (Phase 0 inventory: tcp/22+4000 and udp/9000 all from
# 104.218.148.0/24). Widen deliberately, never by accident.
INGRESS_TCP=4000:104.218.148.0/24,2222:104.218.148.0/24
INGRESS_UDP=9000:104.218.148.0/24

# --- DDNS ------------------------------------------------------------------
# stackctl owns DDNS updates (DDNS_ONBOX=false retires the strim-ddns units).
DDNS_HOST=strim
# TODO(operator): the Namecheap domain the A + Dynamic DNS record lives on.
DDNS_DOMAIN=example.com
DDNS_ONBOX=false
# IP_ECHO_URL=https://checkip.amazonaws.com

# --- Release pipeline ------------------------------------------------------
# All four deployment bundles (Go/C x amd64/arm64). These labels exist in the
# root BUILD.bazel.
RELEASE_TARGETS=//:strimserver_deployment_tar_go_amd64,//:strimserver_deployment_tar_c_amd64,//:strimserver_deployment_tar_go_arm64,//:strimserver_deployment_tar_c_arm64
BAZEL_COMMAND=bazel
# TEMPLATE_OVERRIDE is infra-only; leave unset to use the canonical templates.
# TEMPLATE_OVERRIDE=deploy/aws/infra-demo.yaml
