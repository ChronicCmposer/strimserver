#!/usr/bin/env python3
"""Terminate running strimserver instances, found by tag (no launch template).

Matches running/pending instances tagged Project=<PROJECT_NAME> (default
strimserver) - the same tag deploy/aws/launch applies. Override the tag value
with PROJECT_NAME, or let it come from the CloudFormation stack's ProjectName
output (CFN_STACK_NAME, default strimserver).

Pass -y/--yes to skip the confirmation prompt (headless / automation use).
"""
import argparse
import os
import subprocess
import sys

import known_hosts


PROFILE = os.environ.get("AWS_PROFILE", "").strip() or "strimserver"


def require_strimserver_identity():
    """Fail loud unless the pinned profile authenticates as :user/strimserver.

    Decision 11b: the project-scoped operator account is selected via the
    [strimserver] profile; the ambient default identity is never trusted.
    """
    proc = subprocess.run(
        ["aws", "--profile", PROFILE, "sts", "get-caller-identity",
         "--query", "Arn", "--output", "text"],
        text=True, capture_output=True)
    arn = (proc.stdout or "").strip()
    if proc.returncode != 0 or not arn.endswith(":user/strimserver"):
        sys.exit(
            f"error: AWS profile '{PROFILE}' authenticated as "
            f"'{arn or '<none>'}', expected ...:user/strimserver.\n"
            "Run deploy/aws/deploy-infra (with admin credentials), then retry.")
    return arn


def aws(args):
    region = os.environ.get("AWS_REGION", "").strip()
    cmd = ["aws", "--profile", PROFILE] + (["--region", region] if region else []) + args
    return subprocess.check_output(cmd, text=True)


def project_name():
    name = os.environ.get("PROJECT_NAME", "").strip()
    if name:
        return name
    stack = os.environ.get("CFN_STACK_NAME", "strimserver")
    try:
        out = aws([
            "cloudformation", "describe-stacks", "--stack-name", stack,
            "--query", "Stacks[0].Outputs[?OutputKey=='ProjectName'].OutputValue",
            "--output", "text",
        ]).strip()
        if out and out != "None":
            return out
    except subprocess.CalledProcessError:
        pass
    return "strimserver"


def get_running_instances(project):
    out = aws([
        "ec2", "describe-instances",
        "--filters",
        "Name=instance-state-name,Values=running,pending",
        f"Name=tag:Project,Values={project}",
        "--query", "Reservations[].Instances[].InstanceId",
        "--output", "text",
    ]).strip()
    return out.split() if out and out != "None" else []


def instance_field(instance_id, field):
    """Best-effort read of one instance field; '' when it cannot be resolved."""
    try:
        out = aws([
            "ec2", "describe-instances", "--instance-ids", instance_id,
            "--query", f"Reservations[0].Instances[0].{field}",
            "--output", "text",
        ]).strip()
    except subprocess.CalledProcessError:
        return ""
    return "" if out == "None" else out


def forget_instance_hosts(instance_ids):
    """Prune the dedicated known_hosts store before the instances disappear.

    Forgets every host bound to each instance plus its current public IP/DNS
    name. Best-effort: a missing store or an AWS hiccup must not block the
    termination the operator asked for.
    """
    try:
        known_hosts.ensure_known_hosts_dir()
    except known_hosts.KnownHostsError as exc:
        print(f"warning: could not prepare the private known_hosts store: {exc}",
              file=sys.stderr)
        return
    for instance_id in instance_ids:
        try:
            known_hosts.forget_instance(instance_id)
        except known_hosts.KnownHostsError as exc:
            print(f"warning: could not forget hosts for {instance_id}: {exc}",
                  file=sys.stderr)
        for field in ("PublicIpAddress", "PublicDnsName"):
            host = instance_field(instance_id, field)
            if host:
                try:
                    known_hosts.forget_host(host)
                except known_hosts.KnownHostsError as exc:
                    print(f"warning: could not forget {host}: {exc}",
                          file=sys.stderr)


def main():
    parser = argparse.ArgumentParser(
        description="Terminate running strimserver instances found by tag Project=<name>.")
    parser.add_argument("-y", "--yes", action="store_true",
                        help="skip the interactive confirmation prompt")
    args = parser.parse_args()

    require_strimserver_identity()
    project = project_name()
    instance_ids = get_running_instances(project)
    if not instance_ids:
        print(f"No running instances found with tag Project={project}.")
        sys.exit(0)

    print(f"Terminating (Project={project}): {', '.join(instance_ids)}")
    if not args.yes:
        confirm = input("Type 'yes' to confirm termination: ").strip().lower()
        if confirm != "yes":
            print("Aborted.")
            sys.exit(1)

    # Before the instance disappears (so it is still describable), drop its
    # hosts from the dedicated known_hosts store.
    forget_instance_hosts(instance_ids)

    aws(["ec2", "terminate-instances", "--instance-ids"] + instance_ids)
    subprocess.run(["date"], check=True)
    print("Termination initiated.")


if __name__ == "__main__":
    main()
