#!/usr/bin/env python3
"""Terminate running strimserver instances, found by tag (no launch template).

Matches running/pending instances tagged Project=<PROJECT_NAME> (default
strimserver) - the same tag deploy/aws/launch applies. Override the tag value
with PROJECT_NAME, or let it come from the CloudFormation stack's ProjectName
output (CFN_STACK_NAME, default strimserver).

Pass -y/--yes to skip the confirmation prompt (headless / automation use).
"""
import argparse
import os
import subprocess
import sys


def aws(args):
    region = os.environ.get("AWS_REGION", "").strip()
    cmd = ["aws"] + (["--region", region] if region else []) + args
    return subprocess.check_output(cmd, text=True)


def project_name():
    name = os.environ.get("PROJECT_NAME", "").strip()
    if name:
        return name
    stack = os.environ.get("CFN_STACK_NAME", "strimserver")
    try:
        out = aws([
            "cloudformation", "describe-stacks", "--stack-name", stack,
            "--query", "Stacks[0].Outputs[?OutputKey=='ProjectName'].OutputValue",
            "--output", "text",
        ]).strip()
        if out and out != "None":
            return out
    except subprocess.CalledProcessError:
        pass
    return "strimserver"


def get_running_instances(project):
    out = aws([
        "ec2", "describe-instances",
        "--filters",
        "Name=instance-state-name,Values=running,pending",
        f"Name=tag:Project,Values={project}",
        "--query", "Reservations[].Instances[].InstanceId",
        "--output", "text",
    ]).strip()
    return out.split() if out and out != "None" else []


def main():
    parser = argparse.ArgumentParser(
        description="Terminate running strimserver instances found by tag Project=<name>.")
    parser.add_argument("-y", "--yes", action="store_true",
                        help="skip the interactive confirmation prompt")
    args = parser.parse_args()

    project = project_name()
    instance_ids = get_running_instances(project)
    if not instance_ids:
        print(f"No running instances found with tag Project={project}.")
        sys.exit(0)

    print(f"Terminating (Project={project}): {', '.join(instance_ids)}")
    if not args.yes:
        confirm = input("Type 'yes' to confirm termination: ").strip().lower()
        if confirm != "yes":
            print("Aborted.")
            sys.exit(1)

    aws(["ec2", "terminate-instances", "--instance-ids"] + instance_ids)
    subprocess.run(["date"], check=True)
    print("Termination initiated.")


if __name__ == "__main__":
    main()
