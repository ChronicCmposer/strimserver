#!/usr/bin/env python3
import os
import re
import shlex
import subprocess
import sys
from urllib.parse import urlparse

import known_hosts


PROFILE = os.environ.get("AWS_PROFILE", "").strip() or "strimserver"
DEFAULT_DEPLOYMENT = "strimserver-deployment-go-amd64.tar"


def ssh_identity_flags():
    """['-i', <path>] when SSH_IDENTITY is set, else [] - ssh/scp then rely
    on the agent / default keys, exactly as before."""
    identity = os.environ.get("SSH_IDENTITY", "").strip()
    if not identity:
        return []
    return ["-i", identity]


def ssh_run(hostname, username, port, cmd, capture=False):
    ssh_cmd = os.environ.get("SSH_CMD", "ssh")
    full_cmd = (ssh_cmd.split() + ssh_identity_flags()
                + known_hosts.ssh_options()
                + ["-p", f"{port}", "-t", f"{username}@{hostname}", cmd])
    print(f"\n>>> Running: {cmd}")
    try:
        result = subprocess.run(full_cmd, text=True, check=True, capture_output=capture)
    except FileNotFoundError:
        print("Error: ssh client not found. Make sure OpenSSH is installed.", file=sys.stderr)
        sys.exit(1)
    print(f"[exit status: {result.returncode}]")
    return result


def ssh_write_secret(hostname, username, port, remote_path, value):
    """Create a remote secret file with umask 077 (never scp-then-chmod).

    The value is streamed over stdin so it never enters an argv, no TTY is
    allocated (so the line discipline cannot echo it), and the remote umask
    makes the newly created file 0600. An existing file is re-tightened to 0600.
    """
    ssh_cmd = os.environ.get("SSH_CMD", "ssh")
    remote_cmd = f"umask 077; cat > {remote_path} && chmod 600 {remote_path}"
    full_cmd = (ssh_cmd.split() + ssh_identity_flags()
                + known_hosts.ssh_options()
                + ["-p", f"{port}", f"{username}@{hostname}", remote_cmd])
    print(f"\n>>> Writing secret to: {username}@{hostname}:{remote_path}")
    try:
        result = subprocess.run(full_cmd, input=value + "\n", text=True, check=True)
    except FileNotFoundError:
        print("Error: ssh client not found. Make sure OpenSSH is installed.", file=sys.stderr)
        sys.exit(1)
    print(f"[exit status: {result.returncode}]")


def run_ssh_commands(hostname, username, port, commands):
    for cmd in commands:
        ssh_run(hostname, username, port, cmd, capture=False)


def ssh_capture_rc(hostname, username, port, cmd):
    """Run a remote probe and return (returncode, trimmed stdout).

    Unlike ssh_run this never raises on a non-zero exit and never prints the
    raw output. The exit status is preserved so safety probes never mistake a
    dropped connection (255) or a missing tool for a successful empty result.
    """
    ssh_cmd = os.environ.get("SSH_CMD", "ssh")
    full_cmd = (ssh_cmd.split() + ssh_identity_flags()
                + known_hosts.ssh_options()
                + ["-p", f"{port}", "-t", f"{username}@{hostname}", cmd])
    print(f"\n>>> Checking: {cmd}")
    try:
        result = subprocess.run(full_cmd, text=True, capture_output=True)
    except FileNotFoundError:
        print("Error: ssh client not found. Make sure OpenSSH is installed.", file=sys.stderr)
        sys.exit(1)
    return (result.returncode, (result.stdout or "").strip())


def ssh_capture(hostname, username, port, cmd):
    """Compatibility wrapper: trimmed stdout only ('' on any failure)."""
    return ssh_capture_rc(hostname, username, port, cmd)[1]


NVME_MOUNT = "/mnt/nvme"
INSTANCE_STORE_MODEL = "Amazon EC2 NVMe Instance Storage"
NO_INSTANCE_STORE_MESSAGE = (
    "no Amazon EC2 NVMe Instance Storage device found; "
    "set NVME_DEVICE=/dev/nvmeXn1 explicitly"
)

_DEVICE_PATH_RE = re.compile(r"^/dev/[A-Za-z0-9._+/-]+$")
_NVME_WHOLE_DISK_RE = re.compile(r"^/dev/nvme[0-9]+n[0-9]+$")
_NVME_PARTITION_RE = re.compile(r"^/dev/nvme[0-9]+n[0-9]+p[0-9]+$")
_NVME_NAME_RE = re.compile(r"^nvme([0-9]+)n([0-9]+)$")


def parse_nvme_mode(argv):
    """'auto' (reuse an existing filesystem, else format), 'reuse', or 'format'."""
    saw_format = False
    saw_reuse = False
    for arg in argv[1:]:
        if arg in ("--select-only", "--dry-run"):
            continue
        if arg == "--no-format":
            saw_reuse = True
        elif arg == "--format":
            saw_format = True
        else:
            sys.exit(f"unknown argument: {arg} (expected --format or --no-format)")
    if saw_format and saw_reuse:
        sys.exit("--format and --no-format are mutually exclusive")
    if saw_format:
        return "format"
    if saw_reuse:
        return "reuse"
    return "auto"


def normalize_model(model):
    """Collapse whitespace and casefold so padded/tabbed probes compare equal."""
    if model is None:
        return ""
    return " ".join(str(model).split()).casefold()


def is_instance_store(model):
    return normalize_model(model) == normalize_model(INSTANCE_STORE_MODEL)


def _numeric_disk_key(name):
    match = _NVME_NAME_RE.match(name)
    if not match:
        return None
    return (int(match.group(1)), int(match.group(2)))


def select_instance_store_device(disks):
    """Pick the numerically lowest whole-disk instance store from (name, model)."""
    matches = []
    for name, model in disks:
        key = _numeric_disk_key(name)
        if key is not None and is_instance_store(model):
            matches.append((key, name))
    if not matches:
        return None
    matches.sort(key=lambda item: item[0])
    selected = matches[0][1]
    extras = [name for _, name in matches[1:]]
    if extras:
        print(
            "warning: multiple Amazon EC2 NVMe Instance Storage devices found; "
            f"using /dev/{selected}. Unmounted: "
            + ", ".join(f"/dev/{name}" for name in extras)
            + ". Set NVME_DEVICE to choose a different one.",
            file=sys.stderr,
        )
    return f"/dev/{selected}"


def _reject_partition(path):
    if _NVME_PARTITION_RE.match(path):
        sys.exit(f"refusing: {path} is a partition; pass the whole disk")


def validate_device_path(path):
    """Reject metacharacters, traversal and partitions before any remote use."""
    if not path:
        sys.exit("refusing: an empty device path was given")
    if ".." in path.split("/"):
        sys.exit(f"refusing: {path} contains a path traversal component")
    if not _DEVICE_PATH_RE.match(path):
        sys.exit(f"refusing: {path} is not a valid device path")
    _reject_partition(path)
    return path


def _normalize_device_candidate(value):
    value = value.strip()
    if not value:
        sys.exit("refusing: an empty device path was given")
    candidate = value if value.startswith("/dev/") else "/dev/" + value
    validate_device_path(candidate)
    return candidate


def _realpath_device(hostname, username, port, candidate, probe):
    rc, resolved = probe(
        hostname, username, port, f"realpath -e {shlex.quote(candidate)}")
    if rc != 0 or not resolved.strip():
        sys.exit(f"refusing: {candidate} is not an existing block device")
    return resolved.strip()


def _require_whole_nvme_disk(hostname, username, port, path, probe, display):
    _reject_partition(path)
    if not _NVME_WHOLE_DISK_RE.match(path):
        sys.exit(f"refusing: {display} is not a whole nvme disk; pass the whole disk")
    rc, _ = probe(hostname, username, port, f"test -b {shlex.quote(path)}")
    if rc != 0:
        sys.exit(f"refusing: {path} is not an existing block device")
    return path


def _resolve_override(hostname, username, port, value, probe):
    candidate = _normalize_device_candidate(value)
    resolved = _realpath_device(hostname, username, port, candidate, probe)
    return _require_whole_nvme_disk(
        hostname, username, port, resolved, probe, value)


def _parse_nvme_id_ctrl_model(stdout):
    for line in stdout.splitlines():
        match = re.match(r"^\s*mn\s*:\s*(.*?)\s*$", line, re.IGNORECASE)
        if match:
            return match.group(1)
    return ""


def _device_model(hostname, username, port, name, probe):
    """Model via the nvme CLI, falling back to sysfs on absence/failure/mismatch."""
    rc, stdout = probe(
        hostname, username, port, f"nvme id-ctrl {shlex.quote('/dev/' + name)}")
    if rc == 0:
        model = _parse_nvme_id_ctrl_model(stdout)
        if is_instance_store(model):
            return model
    rc, stdout = probe(
        hostname, username, port,
        f"cat {shlex.quote('/sys/block/' + name + '/device/model')}")
    if rc == 0:
        return stdout.strip()
    return ""


def resolve_nvme_device(hostname, username, port, probe):
    """NVME_DEVICE override, else the numeric first instance-store whole disk."""
    override = os.environ.get("NVME_DEVICE", "").strip()
    if override:
        return _resolve_override(hostname, username, port, override, probe)

    rc, stdout = probe(hostname, username, port, "lsblk -dnrno NAME,TYPE,MODEL")
    if rc != 0:
        sys.exit("refusing: could not verify candidate disks (lsblk failed)")
    disks = []
    for line in stdout.splitlines():
        fields = line.split(None, 2)
        if len(fields) < 2 or fields[1] != "disk":
            continue
        name = fields[0]
        if _numeric_disk_key(name) is None:
            continue
        model = fields[2].strip() if len(fields) > 2 else ""
        if not is_instance_store(model):
            model = _device_model(hostname, username, port, name, probe)
        disks.append((name, model))
    return select_instance_store_device(disks)


def _parse_key_value_rows(stdout):
    return [dict(re.findall(r'(\w+)="([^"]*)"', line))
            for line in stdout.splitlines()
            if re.findall(r'(\w+)="([^"]*)"', line)]


def _strip_btrfs_suffix(source):
    return re.sub(r"\[[^\]]*\]$", "", source.strip())


def _basename(device):
    return os.path.basename(device.rstrip("/"))


def _root_disk_names(hostname, username, port, probe, label):
    """Every disk/partition name from / to its whole-disk ancestor."""
    rc, root_source = probe(
        hostname, username, port, "findmnt -n -o SOURCE --mountpoint /")
    if rc != 0 or not root_source.strip():
        sys.exit(f"refusing: could not verify {label} (findmnt root failed)")
    root_source = _strip_btrfs_suffix(root_source)
    if root_source.startswith("/dev/"):
        rc, resolved = probe(
            hostname, username, port, f"realpath -e {shlex.quote(root_source)}")
        if rc == 0 and resolved.strip():
            root_source = resolved.strip()
    rc, chain = probe(
        hostname, username, port,
        f"lsblk -P -s -n -o NAME,PKNAME {shlex.quote(root_source)}")
    if rc != 0:
        sys.exit(f"refusing: could not verify {label} (lsblk root ancestors failed)")
    names = {_basename(root_source)}
    for row in _parse_key_value_rows(chain):
        if row.get("NAME"):
            names.add(row["NAME"])
        if row.get("PKNAME"):
            names.add(row["PKNAME"])
    return names


def assert_safe_nvme_target(hostname, username, port, dev, probe):
    """Fail closed unless `dev` is an unmounted, unpartitioned non-root disk."""
    rc, _ = probe(hostname, username, port, f"test -b {shlex.quote(dev)}")
    if rc != 0:
        sys.exit(f"refusing: {dev} is not an existing block device")

    root_names = _root_disk_names(hostname, username, port, probe, dev)
    if _basename(dev) in root_names:
        sys.exit(f"refusing to format {dev}: it backs the root filesystem")

    rc, target = probe(
        hostname, username, port,
        f"findmnt -n -o TARGET --source {shlex.quote(dev)}")
    if rc == 0 and target.strip():
        sys.exit(f"refusing to format {dev}: it is mounted at {target.strip()}")
    if rc not in (0, 1):
        sys.exit(f"refusing: could not verify {dev} (findmnt target failed)")

    rc, rows_out = probe(
        hostname, username, port,
        f"lsblk -P -n -o MOUNTPOINT,NAME,TYPE,FSTYPE,PTTYPE {shlex.quote(dev)}")
    if rc != 0:
        sys.exit(f"refusing: could not verify {dev} (lsblk failed)")
    children = []
    for index, row in enumerate(_parse_key_value_rows(rows_out)):
        name = row.get("NAME", "")
        if row.get("MOUNTPOINT"):
            sys.exit(
                f"refusing to format {dev}: it is mounted at {row['MOUNTPOINT']}")
        if index > 0 and name:
            children.append(name)
        elif row.get("PTTYPE") and name and name != _basename(dev):
            children.append(name)
        elif row.get("PTTYPE") and not children:
            children.append(name or _basename(dev))
    if children:
        sys.exit(f"refusing to format {dev}: it has partitions "
                 f"({', '.join(dict.fromkeys(children))})")

    rc, swap_out = probe(
        hostname, username, port, "swapon --show=NAME --noheadings")
    if rc != 0:
        sys.exit(f"refusing: could not verify {dev} (swapon failed)")
    swapped = {_basename(line.strip())
               for line in swap_out.splitlines() if line.strip()}
    if _basename(dev) in swapped:
        sys.exit(f"refusing to format {dev}: it is in use as swap")


def _parse_findmnt_source_fstype(stdout):
    parts = stdout.strip().split(None, 1)
    source = parts[0] if parts else ""
    fstype = parts[1].strip() if len(parts) > 1 else ""
    return source, fstype


def _prompt_for_format_device(hostname, username, port, selected, probe, input_fn):
    if input_fn is input and not sys.stdin.isatty():
        sys.exit("refusing: --format requires an interactive terminal")
    try:
        answer = input_fn(f"Enter the device to format [{selected}]: ").strip()
    except (EOFError, KeyboardInterrupt):
        sys.exit("refusing: no device was entered for --format")
    if not answer:
        return selected
    candidate = _normalize_device_candidate(answer)
    resolved = _realpath_device(hostname, username, port, candidate, probe)
    return _require_whole_nvme_disk(
        hostname, username, port, resolved, probe, answer)


def _confirm_destruction(dev, input_fn):
    if input_fn is input and not sys.stdin.isatty():
        sys.exit("refusing: --format requires an interactive confirmation")
    try:
        answer = input_fn(
            f"Type 'yes' to destroy the filesystem on {dev}: ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        sys.exit("refusing: --format was not confirmed")
    if answer not in ("", "yes", "y"):
        sys.exit("refusing: --format was not confirmed")


def _mount_commands(dev, username):
    return [
        f"sudo mkdir -p {shlex.quote(NVME_MOUNT)}",
        f"sudo mount {shlex.quote(dev)} {shlex.quote(NVME_MOUNT)}",
        f"sudo chown {shlex.quote(username)}:{shlex.quote(username)} "
        f"{shlex.quote(NVME_MOUNT)}",
    ]


def _format_commands(dev, username):
    return [
        f"sudo mkfs.ext4 -F {shlex.quote(dev)}",
        *_mount_commands(dev, username),
    ]


def _run_remote(hostname, username, port, cmd):
    """Default command runner for prepare_nvme: raises on a non-zero exit."""
    ssh_run(hostname, username, port, cmd, capture=False)


def prepare_nvme(hostname, username, port, mode,
                 probe=None, run=None, input_fn=input):
    """Prepare /mnt/nvme non-destructively, after a fail-closed safety check."""
    probe = ssh_capture_rc if probe is None else probe
    run = _run_remote if run is None else run
    nvme_mount = NVME_MOUNT

    rc, mounted = probe(
        hostname, username, port,
        f"findmnt -n -o SOURCE,FSTYPE --mountpoint {shlex.quote(nvme_mount)}")
    if rc == 0 and mounted.strip():
        source, fstype = _parse_findmnt_source_fstype(mounted)
        if mode == "format":
            sys.exit(f"refusing to format: {nvme_mount} is already mounted "
                     f"from {source}")
        if fstype != "ext4":
            sys.exit(f"refusing: {nvme_mount} is mounted from {source} with "
                     f"{fstype or 'an unknown filesystem'}; expected ext4")
        root_names = _root_disk_names(hostname, username, port, probe, nvme_mount)
        if _basename(source) in root_names:
            sys.exit(f"refusing to keep {nvme_mount}: {source} backs the root "
                     "filesystem")
        model = _device_model(hostname, username, port, _basename(source), probe)
        if not is_instance_store(model):
            print(f"warning: {nvme_mount} is mounted from {source}, which is not "
                  "an Amazon EC2 NVMe Instance Storage device.", file=sys.stderr)
        print(f"\n{nvme_mount} is already mounted from {source} ({fstype}); "
              "keeping it (NVME_DEVICE is ignored, no mkfs, no mount).\n")
        return
    if rc not in (0, 1):
        sys.exit(f"refusing: could not verify {nvme_mount} (findmnt failed)")

    rc, entries = probe(
        hostname, username, port,
        f"ls -A {shlex.quote(nvme_mount)} 2>/dev/null || true")
    if rc == 0 and entries.strip():
        sys.exit(f"refusing: {nvme_mount} is an unmounted non-empty directory; "
                 "back up or move its contents before running setup")

    dev = resolve_nvme_device(hostname, username, port, probe)
    if dev is None:
        sys.exit(NO_INSTANCE_STORE_MESSAGE)

    if mode == "format":
        dev = _prompt_for_format_device(
            hostname, username, port, dev, probe, input_fn)

    assert_safe_nvme_target(hostname, username, port, dev, probe)

    rc, fs_value = probe(
        hostname, username, port, f"blkid -o value -s TYPE {shlex.quote(dev)}")
    if rc == 0:
        fs_type = fs_value.strip()
    elif rc == 2:
        fs_type = ""
    else:
        sys.exit(f"refusing: could not verify {dev} (blkid failed)")

    if mode == "reuse":
        if not fs_type:
            sys.exit(f"--no-format requested but {dev} has no filesystem to reuse")
        commands = _mount_commands(dev, username)
    elif mode == "format":
        print(f"\n*** WIPING {dev}: an explicit --format was requested. ***\n")
        _confirm_destruction(dev, input_fn)
        rc, _ = probe(hostname, username, port, f"test -b {shlex.quote(dev)}")
        if rc != 0:
            sys.exit(f"refusing: {dev} disappeared before mkfs")
        commands = _format_commands(dev, username)
    elif fs_type:
        print(f"\nReusing the existing {fs_type} filesystem on {dev}.\n")
        commands = _mount_commands(dev, username)
    else:
        print(f"\nNo filesystem found on {dev}; formatting it.\n")
        commands = _format_commands(dev, username)

    for command in commands:
        run(hostname, username, port, command)


def scp_to_remote(local_path, hostname, username, port, remote_path):
    scp_cmd = os.environ.get("SCP_CMD", "scp")
    # scp uses -P (uppercase) for the port, unlike ssh's -p.
    full_cmd = (scp_cmd.split() + ssh_identity_flags()
                + known_hosts.scp_options()
                + ["-P", f"{port}", local_path, f"{username}@{hostname}:{remote_path}"])
    print(f"\n>>> Uploading: {local_path} -> {username}@{hostname}:{remote_path}")
    try:
        subprocess.run(full_cmd, text=True, check=True)
    except FileNotFoundError:
        print("Error: scp client not found. Make sure OpenSSH is installed.", file=sys.stderr)
        sys.exit(1)


def describe_instance_id_for_host(hostname):
    """Best-effort recovery of the EC2 instance id behind an explicit host.

    Returns the id, or "" when no running/pending instance matches or the AWS
    CLI is unavailable. A lookup failure must never fail setup: pruning the
    host from the dedicated store already handles the reused-key case.
    """
    filters = (
        f"Name=ip-address,Values={hostname}",
        f"Name=dns-name,Values={hostname}",
    )
    for instance_filter in filters:
        try:
            proc = subprocess.run(
                ["aws", "--profile", PROFILE, "ec2", "describe-instances",
                 "--filters", instance_filter,
                 "Name=instance-state-name,Values=running,pending",
                 "--query", "Reservations[].Instances[].InstanceId",
                 "--output", "text"],
                text=True, capture_output=True, timeout=15)
        except (FileNotFoundError, subprocess.TimeoutExpired):
            return ""
        if proc.returncode != 0:
            continue
        ids = (proc.stdout or "").split()
        if ids and ids[0] != "None":
            return ids[0]
    return ""


def bind_target_instance(hostname):
    """Record host -> instance id so a later relaunch self-heals its stale key.

    INSTANCE_ID is used directly when launch passes it through the handoff;
    otherwise the id is recovered by lookup. A failed lookup only warns.
    """
    instance_id = os.environ.get("INSTANCE_ID", "").strip()
    if not instance_id:
        instance_id = describe_instance_id_for_host(hostname)
    if not instance_id:
        print(f"note: could not resolve an instance id for {hostname}; relying on "
              f"accept-new (a reused host key must be cleared manually)",
              file=sys.stderr)
        return
    try:
        known_hosts.bind_host_instance(hostname, instance_id)
    except known_hosts.KnownHostsError as exc:
        print(f"warning: could not record the instance binding: {exc}",
              file=sys.stderr)


def resolve_source():
    """Where the deployment tar comes from, and the name it lands under.

    Precedence:
      1. DEPLOYMENT_SRC -- s3://..., https://..., http://..., or a local path.
         The on-box filename is derived from the source basename; DEPLOYMENT
         is an explicit override and, when set, must agree with that basename.
      2. legacy $S3_BUCKET/$DEPLOYMENT, defaulting to DEFAULT_DEPLOYMENT.

    Returns (src, deployment).
    """
    src = os.environ.get("DEPLOYMENT_SRC", "").strip()
    explicit = os.environ.get("DEPLOYMENT", "").strip()

    if src:
        source_basename = os.path.basename(urlparse(src).path)
        deployment = explicit or source_basename
        if not deployment:
            sys.exit("DEPLOYMENT_SRC has no filename; set DEPLOYMENT explicitly.")
        if explicit and explicit != source_basename:
            print(
                f"warning: DEPLOYMENT={explicit!r} differs from the source "
                f"basename {source_basename!r}; using the explicit name "
                f"{explicit!r}.",
                file=sys.stderr,
            )
        return src, deployment

    bucket = os.environ.get("S3_BUCKET", "").strip()
    if not bucket or "<bucket-name>" in bucket:
        sys.exit(
            "No deployment source. Set DEPLOYMENT_SRC to an s3:// URI, an "
            "https:// URL (e.g. a GitHub release asset), or a local file path."
        )
    deployment = explicit or DEFAULT_DEPLOYMENT
    return f"{bucket}/{deployment}", deployment

def resolve_twitch_key():
    """Operator-supplied Twitch stream key (secret), or None.

    Precedence: TWITCH_STREAM_KEY env, then TWITCH_STREAM_KEY_FILE contents.
    """
    key = os.environ.get("TWITCH_STREAM_KEY", "").strip()
    if key:
        return key
    key_file = os.environ.get("TWITCH_STREAM_KEY_FILE", "").strip()
    if key_file:
        path = os.path.expanduser(key_file)
        if not os.path.isfile(path):
            sys.exit(f"TWITCH_STREAM_KEY_FILE not found: {path}")
        with open(path) as fh:
            return fh.read().strip()
    return None


def transfer_twitch_key(key, hostname, username, port):
    """Stream the key over stdin to a file created with umask 077.

    Previously scp wrote the destination under the remote default umask and a
    second `chmod 600` closed the window; creating it 0600 from the first byte
    removes that exposure and keeps the value out of argv entirely.
    """
    ssh_write_secret(hostname, username, port, "/mnt/nvme/twitch-stream-key", key)


def resolve_ddns_password():
    """Operator-supplied Namecheap Dynamic DNS password (secret), or None.

    Precedence: DDNS_PASSWORD env, then DDNS_PASSWORD_FILE contents.
    """
    password = os.environ.get("DDNS_PASSWORD", "").strip()
    if password:
        return password
    password_file = os.environ.get("DDNS_PASSWORD_FILE", "").strip()
    if password_file:
        path = os.path.expanduser(password_file)
        if not os.path.isfile(path):
            sys.exit(f"DDNS_PASSWORD_FILE not found: {path}")
        with open(path) as fh:
            return fh.read().strip()
    return None


def transfer_ddns_password(password, hostname, username, port):
    """Write the password to a local 0600 temp file, scp it to the box, then scrub locally."""
    import stat
    import tempfile
    fd, tmp = tempfile.mkstemp(prefix="ddns-password-")
    try:
        os.fchmod(fd, stat.S_IRUSR | stat.S_IWUSR)  # 0600
        with os.fdopen(fd, "w") as fh:
            fh.write(password + "\n")
        scp_to_remote(tmp, hostname, username, port, "/mnt/nvme/ddns-password")
    finally:
        os.remove(tmp)
    ssh_run(hostname, username, port, "chmod 600 /mnt/nvme/ddns-password")


def resolve_ddns_config():
    """Operator-supplied Dynamic DNS settings, with the bundled defaults.

    Returns (ENABLE_DDNS, DDNS_HOST, DDNS_DOMAIN). These are non-secret operator
    settings (root .env) injected at deploy time, mirroring the Twitch stream key.
    """
    enable_ddns = os.environ.get("ENABLE_DDNS", "").strip() or "false"
    ddns_host = os.environ.get("DDNS_HOST", "").strip() or "strim"
    ddns_domain = os.environ.get("DDNS_DOMAIN", "").strip()
    return enable_ddns, ddns_host, ddns_domain


def _ddns_quote(value):
    """Double-quote a value for the on-box env file.

    The on-box parser strips surrounding double quotes, so double quotes (not
    single) are required; escaping backslash, double-quote, '$' and backtick
    additionally keeps the file safe to source (entrypoint.sh).
    """
    escaped = (value.replace("\\", "\\\\")
                    .replace('"', '\\"')
                    .replace("$", "\\$")
                    .replace("`", "\\`"))
    return f'"{escaped}"'


def transfer_ddns_config(enable_ddns, ddns_host, ddns_domain, hostname, username, port):
    """Write the settings to a local 0600 temp file, scp it to the box, then scrub locally."""
    import stat
    import tempfile
    fd, tmp = tempfile.mkstemp(prefix="ddns-config-")
    try:
        os.fchmod(fd, stat.S_IRUSR | stat.S_IWUSR)  # 0600
        with os.fdopen(fd, "w") as fh:
            fh.write(f"ENABLE_DDNS={_ddns_quote(enable_ddns)}\n")
            fh.write(f"DDNS_HOST={_ddns_quote(ddns_host)}\n")
            fh.write(f"DDNS_DOMAIN={_ddns_quote(ddns_domain)}\n")
        scp_to_remote(tmp, hostname, username, port, "/mnt/nvme/ddns-config")
    finally:
        os.remove(tmp)
    ssh_run(hostname, username, port, "chmod 600 /mnt/nvme/ddns-config")


def interactive():
    """True when a human is on both ends of the pipe."""
    return sys.stdin.isatty() and sys.stdout.isatty()


def confirm(prompt):
    """True iff interactive and the operator pressed enter (not EOF/Ctrl-C)."""
    if not interactive():
        return False
    try:
        input(prompt)
        return True
    except (EOFError, KeyboardInterrupt):
        print("\nskipped.")
        return False


def offer_exec_start(host, user):
    """Offer to hand off to deploy/aws/start_strimserver by replacing this
    process (execve) - the same pattern launch uses to hand off to setup.
    Returns only if the operator declines or it cannot run; on accept the
    process image is replaced and control never comes back.
    """
    start = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                         "start_strimserver")
    if not interactive() or not os.path.exists(start):
        return

    # start_strimserver requires SSH_CMD/SSH_HOST/SSH_USER; hand it exactly what
    # setup used so it starts the service on the same box.
    env = dict(os.environ)
    env["SSH_HOST"] = host
    env["SSH_USER"] = user
    env.setdefault("SSH_CMD", "ssh")

    print(f"\nabout to run, replacing this process (execve):\n"
          f"    {start}\n"
          f"(starts strimserver.service on {user}@{host}).")
    if not confirm("press enter to start strimserver (ctrl-c to skip): "):
        return

    # Replace this process. execve keeps our stdin/stdout/stderr; start_strimserver
    # is a bash script, so exec it directly and let its shebang pick the shell.
    sys.stdout.flush()
    sys.stderr.flush()
    try:
        os.execve(start, [start], env)
    except OSError as e:
        print(f"could not exec {start}: {e}")


def select_only_nvme(hostname, username, port, probe):
    """Resolve and safety-check the target, then stop before any mutation."""
    probe = ssh_capture_rc if probe is None else probe
    dev = resolve_nvme_device(hostname, username, port, probe)
    if dev is None:
        sys.exit(NO_INSTANCE_STORE_MESSAGE)
    assert_safe_nvme_target(hostname, username, port, dev, probe)
    model = _device_model(hostname, username, port, _basename(dev), probe)
    rc, size = probe(hostname, username, port,
                     f"lsblk -dnrno SIZE {shlex.quote(dev)}")
    print(f"selected device: {dev}")
    print(f"model: {model or 'unknown'}")
    print(f"size: {size.strip() if rc == 0 else 'unknown'}")
    print("safety: safe (not the root disk, unmounted, no partitions, not swap)")


def main(argv=None, env=None, probe=None, run=None, input_fn=input):
    argv = sys.argv if argv is None else argv
    env = os.environ if env is None else env
    HOST = env.get("SSH_HOST", "strimserver")
    USER = env.get("SSH_USER", "ec2-user")
    PORT = int(env.get("SSH_PORT", "22"))
    SHA256 = env.get("DEPLOYMENT_SHA256", "").strip()

    select_only = any(arg in ("--select-only", "--dry-run") for arg in argv[1:])
    nvme_mode = parse_nvme_mode(argv)

    # A relaunch can reuse the target's public IP or DNS name, leaving a stale
    # key in the dedicated store. Drop it (and, when the instance id is cheaply
    # resolvable, self-heal every host bound to the old instance) before the
    # first connection. The operator's default known_hosts file is never used.
    known_hosts.ensure_known_hosts_dir()
    try:
        known_hosts.forget_host(HOST)
    except known_hosts.KnownHostsError as exc:
        print(f"warning: could not prune {HOST} from the private store: {exc}",
              file=sys.stderr)
    bind_target_instance(HOST)

    if select_only:
        select_only_nvme(HOST, USER, PORT, probe)
        return

    SRC, DEPLOYMENT = resolve_source()
    REMOTE_TAR = f"/mnt/nvme/{DEPLOYMENT}"
    scheme = urlparse(SRC).scheme  # 's3', 'https', 'http', or '' for a local path

    # 1) prepare /mnt/nvme - non-destructive by default.
    #    * already mounted                -> keep it untouched
    #    * --format (explicit)            -> prompt, then mkfs + mount (wipe)
    #    * --no-format                    -> reuse only; error without a filesystem
    #    * auto (default)                 -> reuse an existing filesystem, else mkfs
    prepare_nvme(HOST, USER, PORT, nvme_mode,
                 probe=probe, run=run, input_fn=input_fn)

    # 2) place the deployment tar at REMOTE_TAR, by source type
    if scheme == "s3":
        ssh_run(HOST, USER, PORT, f"aws s3 cp {SRC} {REMOTE_TAR}")
    elif scheme in ("http", "https"):
        ssh_run(HOST, USER, PORT, f"curl -fSL -o {REMOTE_TAR} {SRC}")
    else:  # local path -> upload from the operator machine
        local_path = os.path.expanduser(SRC)
        if not os.path.isfile(local_path):
            sys.exit(f"Local deployment file not found: {local_path}")
        scp_to_remote(local_path, HOST, USER, PORT, REMOTE_TAR)

    # 2b) optional integrity check (works for all source types)
    if SHA256:
        ssh_run(HOST, USER, PORT, f"echo '{SHA256}  {REMOTE_TAR}' | sha256sum --check -")

    # 2c) transfer the operator's Twitch stream key (secret), if provided
    twitch_key = resolve_twitch_key()
    if twitch_key:
        transfer_twitch_key(twitch_key, HOST, USER, PORT)
    else:
        print("\nNote: no TWITCH_STREAM_KEY provided; deploying without an egress key.\n"
              "Ingest/normalize/offline will work; set the key later for Twitch egress.\n")

    # 2d) transfer the operator's Namecheap Dynamic DNS password (secret), if provided
    ddns_password = resolve_ddns_password()
    if ddns_password:
        transfer_ddns_password(ddns_password, HOST, USER, PORT)
    else:
        print("\nNote: no DDNS_PASSWORD provided; deploying without Dynamic DNS registration.\n"
              "strim.example.com will not resolve to this box; set the password later\n"
              "to register it with Namecheap Dynamic DNS.\n")

    # 2e) transfer the operator's Dynamic DNS settings (non-secret), if configured
    enable_ddns, ddns_host, ddns_domain = resolve_ddns_config()
    if enable_ddns == "true" or ddns_domain:
        transfer_ddns_config(enable_ddns, ddns_host, ddns_domain, HOST, USER, PORT)
    else:
        print("\nNote: no ENABLE_DDNS / DDNS_DOMAIN provided; deploying with Dynamic DNS\n"
              "disabled (the bundled default). The box is reachable by public IP only;\n"
              "set ENABLE_DDNS / DDNS_HOST / DDNS_DOMAIN to register a Dynamic DNS record.\n")

    # 3) extract + hand off to deploy.sh
    run_ssh_commands(HOST, USER, PORT, [
        # Remove stale bundle helpers before extraction so a leftover
        # lib/deploy.sh from a prior bundle cannot shadow the new one.
        "cd /mnt/nvme && rm -f lib/deploy.sh lib/nvidia.sh",
        f"cd /mnt/nvme && tar -xvf {DEPLOYMENT}",
        f"cd /mnt/nvme && rm -f {DEPLOYMENT}",
        "cd /mnt/nvme && chmod +x deploy.sh",
        "cd /mnt/nvme && chmod +x setup-gpu.sh",
        "cd /mnt/nvme && chmod +x lib/nvidia.sh",
        "cd /mnt/nvme && chmod +x lib/deploy.sh",
        "cd /mnt/nvme && ./deploy.sh",
    ])

    # 4) offer to start the service, replacing this process (execve)
    offer_exec_start(HOST, USER)


if __name__ == "__main__":
    main()
