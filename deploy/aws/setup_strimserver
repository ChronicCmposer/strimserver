#!/usr/bin/env python3
import os
import re
import shlex
import subprocess
import sys
from urllib.parse import urlparse

import known_hosts


PROFILE = os.environ.get("AWS_PROFILE", "").strip() or "strimserver"
DEFAULT_DEPLOYMENT = "strimserver-deployment-go-amd64.tar"

# deploy.sh exit-code taxonomy (see CONTRACT.md "Shared constants"). setup
# propagates the deploy rc verbatim and prints the matching one-line meaning.
DEPLOY_TAXONOMY = {
    0: "deploy complete (DDNS verified, or DDNS disabled)",
    1: "deploy failed before M1; nothing after M1 has happened",
    3: "DDNS stage failed (the deploy named the failing stage above)",
    4: "DDNS backstop timeout fired; the wedged unit was stopped",
    5: "another deploy holds the lock",
    129: "interrupted; any in-flight DDNS unit was stopped",
    130: "interrupted; any in-flight DDNS unit was stopped",
    143: "interrupted; any in-flight DDNS unit was stopped",
}
CONNECTION_LOST_MESSAGE = (
    "connection lost, remote state unknown; rerun setup_strimserver. "
    "The deploy wrote its output to /mnt/nvme/logs/deploy-<timestamp>.log "
    "and its exit code to /mnt/nvme/logs/deploy-last.rc."
)
DNS_UNVERIFIED_HINT = (
    "strimserver is installed but DNS is unverified; start manually with "
    "`ssh {user}@{host} sudo systemctl start strimserver.service` if acceptable"
)
SIGNAL_EXIT_CODES = (129, 130, 143)


def ssh_identity_flags():
    """['-i', <path>] when SSH_IDENTITY is set, else [] - ssh/scp then rely
    on the agent / default keys, exactly as before."""
    identity = os.environ.get("SSH_IDENTITY", "").strip()
    if not identity:
        return []
    return ["-i", identity]


# Local transport bounds. Every ssh/scp invocation must be able to give up: a
# stalled TCP path would otherwise hang Python forever. The defaults are
# per-operation; SETUP_SSH_TIMEOUT (seconds) overrides all of them so tests can
# exercise the timeout path in ~1s. run_deploy is deliberately exempt: a real
# deploy is legitimately long and is bounded on the remote side by deploy.sh's
# own backstop, while the keepalives make a dead transport exit 255.
#
# SSH_STOP_TIMEOUT must exceed the remote unit-stop bound (120s) plus the
# `timeout -k 5` kill grace; otherwise the local transport would kill a wedged
# stop before its remote rc 124/137 could be observed, hiding the remediation.
SSH_RUN_TIMEOUT = 180
SSH_PROBE_TIMEOUT = 60
SSH_SECRET_TIMEOUT = 60
SSH_STOP_TIMEOUT = 180
SSH_COPY_TIMEOUT = 300

# Keepalives so an idle-but-dead transport is detected instead of blocking.
SSH_KEEPALIVE_OPTIONS = (
    "-o", "ConnectTimeout=10",
    "-o", "ServerAliveInterval=15",
    "-o", "ServerAliveCountMax=4",
)


def _ssh_timeout(default_seconds):
    """The local subprocess timeout for one ssh/scp call.

    SETUP_SSH_TIMEOUT overrides every operation (handy for tests); an invalid
    or non-positive value falls back to the per-operation default.
    """
    override = os.environ.get("SETUP_SSH_TIMEOUT", "").strip()
    if not override:
        return default_seconds
    try:
        seconds = float(override)
    except ValueError:
        return default_seconds
    return seconds if seconds > 0 else default_seconds


def _ssh_client_options(known_hosts_options):
    """Identity, known-hosts policy and keepalives shared by ssh and scp.

    Both transports take the same `-o` options; sharing one builder is what
    keeps the identity flag, host-key policy and liveness keepalives from
    drifting between the ssh call sites and the scp upload.
    """
    return (ssh_identity_flags()
            + known_hosts_options
            + list(SSH_KEEPALIVE_OPTIONS))


def _ssh_common_args():
    """The ssh argv prefix every ssh invocation shares (before the destination).

    scp builds its argv from the same `_ssh_client_options` list (it only adds
    its own client and `-P` port flag), so the keepalives cannot drift between
    the ssh call sites and the upload path.
    """
    return (os.environ.get("SSH_CMD", "ssh").split()
            + _ssh_client_options(known_hosts.ssh_options()))


def _scp_common_args():
    """The scp argv prefix, sharing ssh's identity/known-hosts/keepalives."""
    return (os.environ.get("SCP_CMD", "scp").split()
            + _ssh_client_options(known_hosts.scp_options()))


def _run_ssh(full_cmd, timeout, cmd, **run_kwargs):
    """subprocess.run with a bound, converting transport failures cleanly.

    A missing client or a timeout stops setup with a one-line message and exit
    1 - never a traceback. Callers still handle CalledProcessError themselves
    because their recovery text differs.
    """
    try:
        return subprocess.run(full_cmd, timeout=timeout, **run_kwargs)
    except FileNotFoundError:
        print("Error: ssh client not found. Make sure OpenSSH is installed.",
              file=sys.stderr)
        sys.exit(1)
    except subprocess.TimeoutExpired:
        print(
            f"Error: ssh command timed out after {timeout:g}s: {cmd}\n"
            "setup_strimserver stopped; fix the cause and rerun.",
            file=sys.stderr,
        )
        sys.exit(1)


def ssh_run(hostname, username, port, cmd, capture=False):
    timeout = _ssh_timeout(SSH_RUN_TIMEOUT)
    full_cmd = (_ssh_common_args()
                + ["-p", f"{port}", "-t", f"{username}@{hostname}", cmd])
    print(f"\n>>> Running: {cmd}")
    try:
        result = _run_ssh(full_cmd, timeout, cmd,
                          text=True, check=True, capture_output=capture)
    except subprocess.CalledProcessError as exc:
        print(
            f"Error: remote command failed (exit {exc.returncode}): {cmd}\n"
            "setup_strimserver stopped; fix the cause and rerun.",
            file=sys.stderr,
        )
        sys.exit(1)
    print(f"[exit status: {result.returncode}]")
    return result


def ssh_write_secret(hostname, username, port, remote_path, value):
    """Create a remote secret file with umask 077 (never scp-then-chmod).

    The value is streamed over stdin so it never enters an argv, no TTY is
    allocated (so the line discipline cannot echo it), and the remote umask
    makes the newly created file 0600. An existing file is re-tightened to 0600.
    """
    remote_cmd = f"umask 077; cat > {remote_path} && chmod 600 {remote_path}"
    timeout = _ssh_timeout(SSH_SECRET_TIMEOUT)
    full_cmd = (_ssh_common_args()
                + ["-p", f"{port}", f"{username}@{hostname}", remote_cmd])
    print(f"\n>>> Writing secret to: {username}@{hostname}:{remote_path}")
    try:
        result = _run_ssh(full_cmd, timeout, remote_cmd,
                          input=value + "\n", text=True, check=True)
    except subprocess.CalledProcessError as exc:
        print(
            f"Error: writing the secret failed (exit {exc.returncode}): {remote_path}\n"
            "setup_strimserver stopped; fix the cause and rerun.",
            file=sys.stderr,
        )
        sys.exit(1)
    print(f"[exit status: {result.returncode}]")


def run_ssh_commands(hostname, username, port, commands):
    for cmd in commands:
        ssh_run(hostname, username, port, cmd, capture=False)


def run_deploy(hostname, username, port, cmd):
    """Run ./deploy.sh over ssh and return its remote status verbatim.

    This is deliberately not `check=True`: the deploy rc is part of the
    contract, so setup must capture (and later propagate) 1/3/4/5/129/130/143
    and ssh's 255 instead of collapsing them into its own exit 1.
    """
    full_cmd = (_ssh_common_args()
                + ["-p", f"{port}", "-t", f"{username}@{hostname}", cmd])
    print(f"\n>>> Running: {cmd}")
    # No local timeout: deploy.sh is legitimately long and owns its own remote
    # backstop. The keepalives make a dead transport exit 255, which is handled.
    try:
        result = subprocess.run(full_cmd, text=True, check=False)
    except FileNotFoundError:
        print("Error: ssh client not found. Make sure OpenSSH is installed.",
              file=sys.stderr)
        sys.exit(1)
    print(f"[exit status: {result.returncode}]")
    return result.returncode


def report_deploy_failure(rc, hostname, username):
    """Print the taxonomy meaning for a non-zero deploy rc (no traceback)."""
    if rc == 255:
        print(f"\nError: {CONNECTION_LOST_MESSAGE}", file=sys.stderr)
        return
    if rc in SIGNAL_EXIT_CODES:
        print(f"\nError: {DEPLOY_TAXONOMY[rc]}", file=sys.stderr)
        return
    print(f"\nError: {DEPLOY_TAXONOMY.get(rc, f'deploy failed with exit code {rc}')}",
          file=sys.stderr)
    if rc in (3, 4):
        print(DNS_UNVERIFIED_HINT.format(user=username, host=hostname),
              file=sys.stderr)


def ssh_capture_rc(hostname, username, port, cmd, timeout=None):
    """Run a remote probe and return (returncode, trimmed stdout).

    Unlike ssh_run this never raises on a non-zero exit and never prints the
    raw output. The exit status is preserved so safety probes never mistake a
    dropped connection (255) or a missing tool for a successful empty result.

    `timeout` overrides the local bound (seconds) for probes whose remote
    command is itself generously bounded - notably unit stops, where the local
    bound must outlast the remote 120s stop before rc 124/137 can be seen.
    """
    limit = _ssh_timeout(SSH_PROBE_TIMEOUT if timeout is None else timeout)
    full_cmd = (_ssh_common_args()
                + ["-p", f"{port}", "-t", f"{username}@{hostname}", cmd])
    print(f"\n>>> Checking: {cmd}")
    result = _run_ssh(full_cmd, limit, cmd, text=True, capture_output=True)
    return (result.returncode, (result.stdout or "").strip())


def ssh_capture(hostname, username, port, cmd):
    """Compatibility wrapper: trimmed stdout only ('' on any failure)."""
    return ssh_capture_rc(hostname, username, port, cmd)[1]


NVME_MOUNT = "/mnt/nvme"
INSTANCE_STORE_MODEL = "Amazon EC2 NVMe Instance Storage"
NO_INSTANCE_STORE_MESSAGE = (
    "no Amazon EC2 NVMe Instance Storage device found; "
    "set NVME_DEVICE=/dev/nvmeXn1 explicitly"
)

_DEVICE_PATH_RE = re.compile(r"^/dev/[A-Za-z0-9._+/-]+$")
_NVME_WHOLE_DISK_RE = re.compile(r"^/dev/nvme[0-9]+n[0-9]+$")
_NVME_PARTITION_RE = re.compile(r"^/dev/nvme[0-9]+n[0-9]+p[0-9]+$")
_NVME_NAME_RE = re.compile(r"^nvme([0-9]+)n([0-9]+)$")


def parse_nvme_mode(argv):
    """'auto' (reuse an existing filesystem, else format), 'reuse', or 'format'."""
    saw_format = False
    saw_reuse = False
    for arg in argv[1:]:
        if arg in ("--select-only", "--dry-run"):
            continue
        if arg == "--no-format":
            saw_reuse = True
        elif arg == "--format":
            saw_format = True
        else:
            sys.exit(f"unknown argument: {arg} (expected --format or --no-format)")
    if saw_format and saw_reuse:
        sys.exit("--format and --no-format are mutually exclusive")
    if saw_format:
        return "format"
    if saw_reuse:
        return "reuse"
    return "auto"


def normalize_model(model):
    """Collapse whitespace and casefold so padded/tabbed probes compare equal."""
    if model is None:
        return ""
    return " ".join(str(model).split()).casefold()


def is_instance_store(model):
    return normalize_model(model) == normalize_model(INSTANCE_STORE_MODEL)


def _numeric_disk_key(name):
    match = _NVME_NAME_RE.match(name)
    if not match:
        return None
    return (int(match.group(1)), int(match.group(2)))


def select_instance_store_device(disks):
    """Pick the numerically lowest whole-disk instance store from (name, model)."""
    matches = []
    for name, model in disks:
        key = _numeric_disk_key(name)
        if key is not None and is_instance_store(model):
            matches.append((key, name))
    if not matches:
        return None
    matches.sort(key=lambda item: item[0])
    selected = matches[0][1]
    extras = [name for _, name in matches[1:]]
    if extras:
        print(
            "warning: multiple Amazon EC2 NVMe Instance Storage devices found; "
            f"using /dev/{selected}. Unmounted: "
            + ", ".join(f"/dev/{name}" for name in extras)
            + ". Set NVME_DEVICE to choose a different one.",
            file=sys.stderr,
        )
    return f"/dev/{selected}"


def _reject_partition(path):
    if _NVME_PARTITION_RE.match(path):
        sys.exit(f"refusing: {path} is a partition; pass the whole disk")


def validate_device_path(path):
    """Reject metacharacters, traversal and partitions before any remote use."""
    if not path:
        sys.exit("refusing: an empty device path was given")
    if ".." in path.split("/"):
        sys.exit(f"refusing: {path} contains a path traversal component")
    if not _DEVICE_PATH_RE.match(path):
        sys.exit(f"refusing: {path} is not a valid device path")
    _reject_partition(path)
    return path


def _normalize_device_candidate(value):
    value = value.strip()
    if not value:
        sys.exit("refusing: an empty device path was given")
    candidate = value if value.startswith("/dev/") else "/dev/" + value
    validate_device_path(candidate)
    return candidate


def _realpath_device(hostname, username, port, candidate, probe):
    rc, resolved = probe(
        hostname, username, port, f"realpath -e {shlex.quote(candidate)}")
    if rc != 0 or not resolved.strip():
        sys.exit(f"refusing: {candidate} is not an existing block device")
    return resolved.strip()


def _require_whole_nvme_disk(hostname, username, port, path, probe, display):
    _reject_partition(path)
    if not _NVME_WHOLE_DISK_RE.match(path):
        sys.exit(f"refusing: {display} is not a whole nvme disk; pass the whole disk")
    rc, _ = probe(hostname, username, port, f"test -b {shlex.quote(path)}")
    if rc != 0:
        sys.exit(f"refusing: {path} is not an existing block device")
    return path


def _resolve_override(hostname, username, port, value, probe):
    candidate = _normalize_device_candidate(value)
    resolved = _realpath_device(hostname, username, port, candidate, probe)
    return _require_whole_nvme_disk(
        hostname, username, port, resolved, probe, value)


def _parse_nvme_id_ctrl_model(stdout):
    for line in stdout.splitlines():
        match = re.match(r"^\s*mn\s*:\s*(.*?)\s*$", line, re.IGNORECASE)
        if match:
            return match.group(1)
    return ""


def _device_model(hostname, username, port, name, probe):
    """Model via the nvme CLI, falling back to sysfs on absence/failure/mismatch."""
    rc, stdout = probe(
        hostname, username, port, f"nvme id-ctrl {shlex.quote('/dev/' + name)}")
    if rc == 0:
        model = _parse_nvme_id_ctrl_model(stdout)
        if is_instance_store(model):
            return model
    rc, stdout = probe(
        hostname, username, port,
        f"cat {shlex.quote('/sys/block/' + name + '/device/model')}")
    if rc == 0:
        return stdout.strip()
    return ""


def resolve_nvme_device(hostname, username, port, probe):
    """NVME_DEVICE override, else the numeric first instance-store whole disk."""
    override = os.environ.get("NVME_DEVICE", "").strip()
    if override:
        return _resolve_override(hostname, username, port, override, probe)

    rc, stdout = probe(hostname, username, port, "lsblk -dnrno NAME,TYPE,MODEL")
    if rc != 0:
        sys.exit("refusing: could not verify candidate disks "
                 f"(lsblk failed: {_probe_detail(rc, stdout)})")
    disks = []
    for line in stdout.splitlines():
        fields = line.split(None, 2)
        if len(fields) < 2 or fields[1] != "disk":
            continue
        name = fields[0]
        if _numeric_disk_key(name) is None:
            continue
        model = fields[2].strip() if len(fields) > 2 else ""
        if not is_instance_store(model):
            model = _device_model(hostname, username, port, name, probe)
        disks.append((name, model))
    return select_instance_store_device(disks)


def _parse_key_value_rows(stdout):
    return [dict(re.findall(r'(\w+)="([^"]*)"', line))
            for line in stdout.splitlines()
            if re.findall(r'(\w+)="([^"]*)"', line)]


def _strip_btrfs_suffix(source):
    return re.sub(r"\[[^\]]*\]$", "", source.strip())


def _basename(device):
    return os.path.basename(device.rstrip("/"))


def _root_disk_names(hostname, username, port, probe, label):
    """Every disk/partition name from / to its whole-disk ancestor."""
    rc, root_source = probe(
        hostname, username, port, "findmnt -n -o SOURCE --mountpoint /")
    if rc != 0 or not root_source.strip():
        sys.exit(f"refusing: could not verify {label} (findmnt root failed)")
    root_source = _strip_btrfs_suffix(root_source)
    if root_source.startswith("/dev/"):
        rc, resolved = probe(
            hostname, username, port, f"realpath -e {shlex.quote(root_source)}")
        if rc == 0 and resolved.strip():
            root_source = resolved.strip()
    rc, chain = probe(
        hostname, username, port,
        f"lsblk -P -s -n -o NAME,PKNAME {shlex.quote(root_source)}")
    if rc != 0:
        sys.exit(f"refusing: could not verify {label} (lsblk root ancestors failed)")
    names = {_basename(root_source)}
    for row in _parse_key_value_rows(chain):
        if row.get("NAME"):
            names.add(row["NAME"])
        if row.get("PKNAME"):
            names.add(row["PKNAME"])
    return names


def assert_safe_nvme_target(hostname, username, port, dev, probe):
    """Fail closed unless `dev` is an unmounted, unpartitioned non-root disk."""
    rc, _ = probe(hostname, username, port, f"test -b {shlex.quote(dev)}")
    if rc != 0:
        sys.exit(f"refusing: {dev} is not an existing block device")

    root_names = _root_disk_names(hostname, username, port, probe, dev)
    if _basename(dev) in root_names:
        sys.exit(f"refusing to format {dev}: it backs the root filesystem")

    rc, target = probe(
        hostname, username, port,
        f"findmnt -n -o TARGET --source {shlex.quote(dev)}")
    if rc == 0 and target.strip():
        sys.exit(f"refusing to format {dev}: it is mounted at {target.strip()}")
    if rc not in (0, 1):
        sys.exit(f"refusing: could not verify {dev} "
                 f"(findmnt target failed: {_probe_detail(rc, target)})")

    rc, rows_out = probe(
        hostname, username, port,
        f"lsblk -P -n -o MOUNTPOINT,NAME,TYPE,FSTYPE,PTTYPE {shlex.quote(dev)}")
    if rc != 0:
        sys.exit(f"refusing: could not verify {dev} "
                 f"(lsblk failed: {_probe_detail(rc, rows_out)})")
    children = []
    for index, row in enumerate(_parse_key_value_rows(rows_out)):
        name = row.get("NAME", "")
        if row.get("MOUNTPOINT"):
            sys.exit(
                f"refusing to format {dev}: it is mounted at {row['MOUNTPOINT']}")
        if index > 0 and name:
            children.append(name)
        elif row.get("PTTYPE") and name and name != _basename(dev):
            children.append(name)
        elif row.get("PTTYPE") and not children:
            children.append(name or _basename(dev))
    if children:
        sys.exit(f"refusing to format {dev}: it has partitions "
                 f"({', '.join(dict.fromkeys(children))})")

    rc, swap_out = probe(
        hostname, username, port, "swapon --show=NAME --noheadings")
    if rc != 0:
        sys.exit(f"refusing: could not verify {dev} "
                 f"(swapon failed: {_probe_detail(rc, swap_out)})")
    swapped = {_basename(line.strip())
               for line in swap_out.splitlines() if line.strip()}
    if _basename(dev) in swapped:
        sys.exit(f"refusing to format {dev}: it is in use as swap")


def _parse_findmnt_source_fstype(stdout):
    parts = stdout.strip().split(None, 1)
    source = parts[0] if parts else ""
    fstype = parts[1].strip() if len(parts) > 1 else ""
    return source, fstype


def _prompt_for_format_device(hostname, username, port, selected, probe, input_fn):
    if input_fn is input and not sys.stdin.isatty():
        sys.exit("refusing: --format requires an interactive terminal")
    try:
        answer = input_fn(f"Enter the device to format [{selected}]: ").strip()
    except (EOFError, KeyboardInterrupt):
        sys.exit("refusing: no device was entered for --format")
    if not answer:
        return selected
    candidate = _normalize_device_candidate(answer)
    resolved = _realpath_device(hostname, username, port, candidate, probe)
    return _require_whole_nvme_disk(
        hostname, username, port, resolved, probe, answer)


def _confirm_destruction(dev, input_fn):
    if input_fn is input and not sys.stdin.isatty():
        sys.exit("refusing: --format requires an interactive confirmation")
    try:
        answer = input_fn(
            f"Type 'yes' to destroy the filesystem on {dev}: ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        sys.exit("refusing: --format was not confirmed")
    if answer not in ("", "yes", "y"):
        sys.exit("refusing: --format was not confirmed")


def _mount_commands(dev, username):
    return [
        f"sudo mkdir -p {shlex.quote(NVME_MOUNT)}",
        f"sudo mount {shlex.quote(dev)} {shlex.quote(NVME_MOUNT)}",
        f"sudo chown {shlex.quote(username)}:{shlex.quote(username)} "
        f"{shlex.quote(NVME_MOUNT)}",
    ]


def _format_commands(dev, username):
    return [
        f"sudo mkfs.ext4 -F {shlex.quote(dev)}",
        *_mount_commands(dev, username),
    ]


ALLOWLIST_WIPE_NAMES = ("nvidia-rpm", "containerd", "containerd-state")
REPO_UNITS = (
    "strimserver.service",
    "strim-ddns.timer",
    "strim-ddns.service",
    "strim-ddns-verify.service",
)
RESUME_MARKER = "/var/lib/strimserver/driver-upgrade.state"
_CONTAINERD_STOP = ("containerd.service", "containerd.socket")

# Every wipe-phase probe is time-bounded on the remote side, so a host with a
# wedged systemd/D-Bus (exactly the state that motivates a wipe) fails closed
# instead of hanging setup forever. Unit stops get a generous bound because a
# legitimate containerd stop may take up to TimeoutStopSec; a stop that hits
# the bound is a failure (rc 124/137), never a benign "absent unit".
_WIPE_PROBE_TIMEOUT = "timeout -k 5 10"
_UNIT_STOP_TIMEOUT_SECONDS = 120
_UNIT_STOP_TIMEOUT_CODES = (124, 137)

# Manager-independent KillMode fallback: `systemctl show` can fail transiently
# or for manager-query-specific reasons while the unit files remain readable,
# so resolve the value from disk then. This does NOT rescue a fully wedged
# manager: the repo-unit stops run earlier and would normally refuse there.
# Precedence mirrors systemd: full unit copies win /etc over /run over
# /usr/lib, drop-ins attach to whichever base wins, are searched across the
# same three directories, and the LAST KillMode assignment in lexical drop-in
# order wins.
_CONTAINERD_FULL_UNIT_PATHS = (
    "/etc/systemd/system/containerd.service",
    "/run/systemd/system/containerd.service",
    "/usr/lib/systemd/system/containerd.service",
)
_CONTAINERD_DROPIN_DIRS = (
    "/etc/systemd/system/containerd.service.d",
    "/run/systemd/system/containerd.service.d",
    "/usr/lib/systemd/system/containerd.service.d",
)
# Compatibility aliases (the highest- and lowest-priority paths).
_LOCAL_CONTAINERD_UNIT = _CONTAINERD_FULL_UNIT_PATHS[0]
_DISTRO_CONTAINERD_UNIT = _CONTAINERD_FULL_UNIT_PATHS[-1]
_CONTAINERD_DROPIN_DIR = _CONTAINERD_DROPIN_DIRS[0]
_KILLMODE_ASSIGNMENT_RE = re.compile(r"^\s*KillMode\s*=\s*(\S*)\s*$",
                                     re.IGNORECASE)


def _probe_detail(rc, out):
    """One-line `rc=..., output: ...` so a refusal never hides its evidence."""
    detail = (out or "").strip()
    return f"rc={rc}, output: {detail or 'none'}"


def _killmode_last_assignment(text):
    """The last `KillMode=` value in a unit/drop-in body, or None."""
    value = None
    for raw_line in text.splitlines():
        match = _KILLMODE_ASSIGNMENT_RE.match(raw_line.split("#", 1)[0])
        if match:
            value = match.group(1)
    return value


def _remote_path_status(hostname, username, port, probe, path):
    """Whether a remote path exists: ("present"|"absent"|"error", rc, out).

    `test -e` is the narrowest existence test: rc 1 therefore means true ENOENT
    (including a broken symlink), while any other rc is a probe failure. This is
    what lets callers distinguish an absent file from an existing-but-unreadable
    one instead of treating every rc 1 as "missing".
    """
    rc, out = probe(
        hostname, username, port,
        f"sudo {_WIPE_PROBE_TIMEOUT} test -e {shlex.quote(path)} 2>&1")
    if rc == 0:
        return "present", rc, out
    if rc == 1:
        return "absent", rc, out
    return "error", rc, out


def _read_containerd_unit_file(hostname, username, port, probe, path):
    """Read one unit/drop-in file bounded+sudo'd: (status, rc, text).

    `status` is "ok" (read), "missing" (true ENOENT) or "error" (anything else:
    unreadable, a directory, missing tool, transport failure). Existence is
    classified first so cat's rc 1 on an existing path is an error, never
    silently "missing".
    """
    path_status, rc, out = _remote_path_status(
        hostname, username, port, probe, path)
    if path_status == "absent":
        return "missing", rc, out
    if path_status == "error":
        return "error", rc, out
    rc, out = probe(
        hostname, username, port,
        f"sudo {_WIPE_PROBE_TIMEOUT} cat {shlex.quote(path)} 2>&1")
    if rc == 0:
        return "ok", rc, out
    return "error", rc, out


def _list_dropin_dir(hostname, username, port, probe, directory):
    """List one drop-in directory: (status, rc, text, sorted names).

    A missing directory is "absent"; a path that exists but is not a directory,
    or any listing failure, is "error" so the caller fails closed.
    """
    rc, out = probe(
        hostname, username, port,
        f"sudo {_WIPE_PROBE_TIMEOUT} test -d {shlex.quote(directory)} 2>&1")
    if rc == 1:
        path_status, erc, eout = _remote_path_status(
            hostname, username, port, probe, directory)
        if path_status == "absent":
            return "absent", erc, eout, []
        if path_status == "error":
            return "error", erc, eout, []
        return "error", rc, (
            f"{directory} exists but is not a directory "
            f"({_probe_detail(rc, out)})"), []
    if rc != 0:
        return "error", rc, out, []
    rc, out = probe(
        hostname, username, port,
        f"sudo {_WIPE_PROBE_TIMEOUT} ls -1 {shlex.quote(directory)} 2>&1")
    if rc != 0:
        return "error", rc, out, []
    names = sorted(name.strip() for name in out.splitlines()
                   if name.strip().endswith(".conf"))
    return "ok", rc, out, names


def _list_containerd_dropins(hostname, username, port, probe):
    """Sorted *.conf drop-in paths across the systemd search path.

    Directories are searched /etc, /run, /usr/lib in systemd priority order; a
    same-named file in a higher-priority directory shadows the lower ones. The
    merged set is returned in lexical order so the caller's last-assignment-wins
    rule matches systemd. A missing directory is normal; an existing
    non-directory or any listing failure is an error the caller must not ignore.
    """
    selected = {}
    for directory in _CONTAINERD_DROPIN_DIRS:
        status, rc, text, names = _list_dropin_dir(
            hostname, username, port, probe, directory)
        if status == "absent":
            continue
        if status == "error":
            return "error", rc, [], text
        for name in names:
            selected.setdefault(name, os.path.join(directory, name))
    paths = [selected[name] for name in sorted(selected)]
    return "ok", 0, paths, ""


def _read_containerd_base_unit(hostname, username, port, probe, diagnostics):
    """The effective unit body: the first full copy in systemd priority order.

    Precedence is /etc, then /run, then the /usr/lib unit. A higher-priority
    file that exists but is unreadable is ambiguous, so refuse rather than
    silently falling through to a lower-precedence copy.
    """
    for path in _CONTAINERD_FULL_UNIT_PATHS:
        status, rc, text = _read_containerd_unit_file(
            hostname, username, port, probe, path)
        if status == "ok":
            return text, path
        if status == "missing":
            diagnostics.append(f"{path}: missing (rc={rc})")
            continue
        diagnostics.append(f"{path}: unreadable ({_probe_detail(rc, text)})")
        return None, None
    return None, None


def _read_killmode_from_unit_files(hostname, username, port, probe):
    """Resolve KillMode from the unit and its drop-ins without the manager.

    Returns (value, source, diagnostic). `value` is None when the files are
    missing, unreadable or carry no KillMode, i.e. the caller must refuse.
    """
    diagnostics = []
    base_text, base_source = _read_containerd_base_unit(
        hostname, username, port, probe, diagnostics)
    if base_text is None:
        return None, None, "; ".join(diagnostics) or "no unit files found"

    status, rc, paths, text = _list_containerd_dropins(
        hostname, username, port, probe)
    if status == "error":
        diagnostics.append(
            f"drop-in listing failed ({_probe_detail(rc, text)})")
        return None, None, "; ".join(diagnostics)

    value, source = None, None
    assignment = _killmode_last_assignment(base_text)
    if assignment is not None:
        value, source = assignment, base_source
    for path in paths:
        status, rc, dropin = _read_containerd_unit_file(
            hostname, username, port, probe, path)
        if status != "ok":
            diagnostics.append(
                f"{path}: unreadable ({_probe_detail(rc, dropin)})")
            return None, None, "; ".join(diagnostics)
        assignment = _killmode_last_assignment(dropin)
        if assignment is not None:
            value, source = assignment, path
    return value, source, "; ".join(diagnostics) or "no KillMode assignment"


def _allowlist_paths():
    return {f"{NVME_MOUNT}/{name}" for name in ALLOWLIST_WIPE_NAMES}


def _is_allowlisted_mount(target):
    return any(target == path or target.startswith(path + "/")
               for path in _allowlist_paths())


def _parse_ctr_tasks(stdout):
    """Task ids from `ctr ... tasks list`; skip the header and blank lines."""
    task_ids = []
    for line in stdout.splitlines():
        fields = line.split()
        if not fields or fields[0].upper() == "TASK":
            continue
        task_ids.append(fields[0])
    return task_ids


def _warn_on_resume_marker(hostname, username, port, probe):
    rc, out = probe(hostname, username, port,
                    f"{_WIPE_PROBE_TIMEOUT} test -e {shlex.quote(RESUME_MARKER)} 2>&1")
    if rc == 0:
        print(
            f"\nWARNING: {RESUME_MARKER} is present; a driver upgrade is "
            "half-done. The allowlist wipe proceeds but the nvidia-rpm stage "
            "is removed, so re-running setup-gpu.sh will re-download it. The "
            "marker is left untouched.\n",
            file=sys.stderr,
        )
    elif rc != 1:
        sys.exit(f"refusing: could not check for {RESUME_MARKER} "
                 f"({_probe_detail(rc, out)}); inspect it manually, then rerun "
                 "setup_strimserver")


# systemd reports an absent unit (a first setup run against a fresh launch has
# not installed the repo units yet) with these phrases. Only these are benign;
# every other non-zero stop is a real failure and must stop the wipe.
_UNIT_ABSENT_MARKERS = ("not loaded", "not found", "no such file")


def _unit_is_absent(detail):
    lowered = detail.lower()
    if "not loaded" in lowered:
        return True
    # "not found"/"no such file" only count when the diagnostic names a unit,
    # so a missing binary ("systemctl: command not found") still fails closed.
    return "unit" in lowered and any(
        marker in lowered
        for marker in _UNIT_ABSENT_MARKERS if marker != "not loaded")


def _stop_unit(hostname, username, port, probe, unit):
    """Stop one unit, tolerating an absent unit but not a failed stop.

    The diagnostic is captured (`2>&1`) so an absent unit can be distinguished
    from a genuine failure; a failed stop fails closed with a remediation hint.
    """
    rc, out = probe(
        hostname, username, port,
        f"sudo timeout -k 5 {_UNIT_STOP_TIMEOUT_SECONDS} systemctl stop "
        f"{unit} 2>&1",
        timeout=SSH_STOP_TIMEOUT)
    if rc == 0:
        return
    detail = out.strip()
    # A timed-out stop means systemd/D-Bus is wedged. Check the rc FIRST: the
    # timeout's diagnostic can resemble an absent unit, and treating a wedged
    # stop as "nothing to stop" would let the wipe race a live containerd.
    if rc in _UNIT_STOP_TIMEOUT_CODES:
        sys.exit(
            f"refusing: stopping {unit} timed out (exit {rc}); systemd or "
            "D-Bus may be wedged. Reboot the instance, then rerun "
            "setup_strimserver"
        )
    if _unit_is_absent(detail):
        print(f"Wipe: {unit} is not loaded; nothing to stop ({detail}).",
              file=sys.stderr)
        return
    sys.exit(
        f"refusing: could not stop {unit} (exit {rc}): "
        f"{detail or 'no diagnostic output'}; stop it manually, then rerun "
        "setup_strimserver"
    )


def _stop_repo_units(hostname, username, port, probe):
    print("\nWipe: stopping repo units before the allowlist cleanup: "
          + ", ".join(REPO_UNITS))
    for unit in REPO_UNITS:
        _stop_unit(hostname, username, port, probe, unit)


def _verify_containerd_killmode(hostname, username, port, probe):
    """Verify containerd KillMode=process, from the manager or the unit files.

    The manager is authoritative when it answers. If `systemctl show` fails
    transiently or for a manager-query-specific reason, fall back to reading the
    unit and its drop-ins from disk. This does not rescue a fully wedged
    manager - the repo-unit stops run first and normally refuse there - but it
    keeps a manager that simply cannot answer this query from blocking a wipe
    whose safety precondition is still determinable. Every refusal names the rc
    and captured output that produced it.
    """
    rc, out = probe(
        hostname, username, port,
        f"sudo {_WIPE_PROBE_TIMEOUT} systemctl show -p KillMode "
        f"containerd.service 2>&1")
    show_detail = _probe_detail(rc, out)
    if rc == 0:
        killmode = out.strip().split("=", 1)[-1].strip()
        if killmode == "process":
            return
        sys.exit(
            f"refusing: containerd KillMode is {killmode or 'unknown'!r}, "
            "expected 'process'; without it shims survive the containerd stop. "
            f"(systemctl show: {show_detail}). Restore KillMode=process in the "
            "containerd.service unit (the AL2023 default), then rerun "
            "setup_strimserver"
        )

    value, source, file_detail = _read_killmode_from_unit_files(
        hostname, username, port, probe)
    if value is None:
        sys.exit(
            "refusing: could not verify containerd KillMode before the wipe "
            f"(systemctl show: {show_detail}; unit files: {file_detail}). "
            "Restore KillMode=process in the containerd.service unit (the "
            "AL2023 default), then rerun setup_strimserver"
        )
    if value != "process":
        sys.exit(
            f"refusing: containerd KillMode is {value!r} (from {source}), "
            "expected 'process'; without it shims survive the containerd stop. "
            f"(systemctl show: {show_detail}; unit files: {file_detail}). "
            "Restore KillMode=process in the containerd.service unit (the "
            "AL2023 default), then rerun setup_strimserver"
        )
    print("Wipe: containerd KillMode=process verified from "
          f"{source} (systemctl show unavailable).")


def _kill_containerd_tasks(hostname, username, port, probe, run):
    rc, out = probe(
        hostname, username, port,
        "sudo timeout -k 5 10 ctr -n strimserver tasks list")
    if rc != 0:
        print("warning: could not list strimserver containerd tasks; the "
              "shim check below remains authoritative.", file=sys.stderr)
        return
    task_ids = _parse_ctr_tasks(out)
    print("Wipe: killing and deleting containerd tasks in namespace "
          f"strimserver: {', '.join(task_ids) if task_ids else 'none'}")
    for task_id in task_ids:
        quoted = shlex.quote(task_id)
        run(hostname, username, port,
            f"sudo timeout -k 5 10 ctr -n strimserver tasks kill -s KILL {quoted}")
        run(hostname, username, port,
            f"sudo timeout -k 5 10 ctr -n strimserver containers delete {quoted}")


def _stop_containerd(hostname, username, port, probe):
    print("Wipe: stopping " + " and ".join(_CONTAINERD_STOP))
    for unit in _CONTAINERD_STOP:
        _stop_unit(hostname, username, port, probe, unit)


def _refuse_surviving_shims(hostname, username, port, probe):
    rc, out = probe(hostname, username, port,
                    f"{_WIPE_PROBE_TIMEOUT} pgrep -a containerd-shim 2>&1")
    if rc == 0 and out.strip():
        sys.exit(
            "refusing: containerd-shim process(es) are still alive after the "
            f"containerd stop ({out.strip()}); reboot the instance, then rerun "
            "setup_strimserver"
        )
    if rc not in (0, 1):
        sys.exit(
            "refusing: could not verify containerd-shim processes "
            f"({_probe_detail(rc, out)}); reboot the instance, then rerun "
            "setup_strimserver"
        )


def _enumerate_nvme_mounts(hostname, username, port, probe):
    rc, out = probe(hostname, username, port,
                    f"{_WIPE_PROBE_TIMEOUT} findmnt -rn -o TARGET 2>&1")
    if rc not in (0, 1):
        sys.exit(
            "refusing: could not enumerate mount targets (findmnt failed: "
            f"{_probe_detail(rc, out)}); inspect mounts manually, then rerun "
            "setup_strimserver"
        )
    targets = [line.strip() for line in out.splitlines() if line.strip()]
    return targets


def _unmount_allowlisted_mounts(hostname, username, port, probe, run):
    targets = _enumerate_nvme_mounts(hostname, username, port, probe)
    if NVME_MOUNT in targets:
        sys.exit(f"refusing: {NVME_MOUNT} became a mount target while the "
                 "volume was expected to be unmounted")
    nvme_targets = [t for t in targets if t.startswith(NVME_MOUNT + "/")]
    outsiders = [t for t in nvme_targets if not _is_allowlisted_mount(t)]
    if outsiders:
        sys.exit(
            f"refusing: mount target(s) under {NVME_MOUNT} outside the "
            f"allowlist: {', '.join(outsiders)}; inspect and unmount them "
            "manually before running setup"
        )
    ordered = sorted(nvme_targets, reverse=True)
    print("Wipe: unmounting allowlisted targets deepest-first: "
          + (", ".join(ordered) if ordered else "none"))
    for target in ordered:
        try:
            run(hostname, username, port, f"sudo umount {shlex.quote(target)}")
        except (subprocess.CalledProcessError, OSError) as exc:
            sys.exit(f"refusing: could not unmount {target}: {exc}")
    remaining = [t for t in _enumerate_nvme_mounts(hostname, username, port, probe)
                 if t.startswith(NVME_MOUNT + "/")]
    if remaining:
        sys.exit(
            f"refusing: mount(s) remain under {NVME_MOUNT} after unmount: "
            f"{', '.join(remaining)}"
        )


def _remove_allowlisted_paths(hostname, username, port, run):
    print("Wipe: removing allowlist: " + ", ".join(ALLOWLIST_WIPE_NAMES))
    for name in ALLOWLIST_WIPE_NAMES:
        path = f"{NVME_MOUNT}/{name}"
        run(hostname, username, port,
            f"sudo rm -rf --one-file-system {shlex.quote(path)}")


def _assert_wipe_complete(hostname, username, port, probe):
    for name in ALLOWLIST_WIPE_NAMES:
        path = f"{NVME_MOUNT}/{name}"
        rc, out = probe(hostname, username, port,
                        f"{_WIPE_PROBE_TIMEOUT} test -e {shlex.quote(path)} 2>&1")
        if rc == 0:
            sys.exit(f"refusing: {path} still exists after the allowlist wipe")
        if rc != 1:
            sys.exit(
                f"refusing: could not verify that {path} was removed "
                f"({_probe_detail(rc, out)}); inspect it manually, then rerun "
                "setup_strimserver"
            )
    # The image-side cleanup permits /mnt/nvme to be absent; _mount_commands
    # recreates it. Test for a directory first, then classify a negative result:
    # true ENOENT is "absent" (empty), while a path that exists as something
    # else (regular file, symlink target) is refused naming what it is. Only a
    # real directory is listed, and a listing failure still fails closed.
    rc, out = probe(hostname, username, port,
                    f"{_WIPE_PROBE_TIMEOUT} test -d {shlex.quote(NVME_MOUNT)} 2>&1")
    if rc == 1:
        path_status, erc, eout = _remote_path_status(
            hostname, username, port, probe, NVME_MOUNT)
        if path_status == "absent":
            print(f"Wipe: {NVME_MOUNT} is absent; treating it as empty "
                  "(it will be recreated at mount time).")
            return
        if path_status == "error":
            sys.exit(
                f"refusing: could not determine whether {NVME_MOUNT} exists "
                f"after the wipe ({_probe_detail(erc, eout)}); inspect it "
                "manually"
            )
        kind_rc, kind_out = probe(
            hostname, username, port,
            f"{_WIPE_PROBE_TIMEOUT} stat -c %F {shlex.quote(NVME_MOUNT)} 2>&1")
        kind = kind_out.strip() if kind_rc == 0 and kind_out.strip() else (
            "a non-directory path")
        sys.exit(
            f"refusing: {NVME_MOUNT} exists but is not a directory "
            f"({kind}); move it aside or remove it manually, then rerun "
            "setup_strimserver"
        )
    if rc != 0:
        sys.exit(
            f"refusing: could not determine whether {NVME_MOUNT} exists after "
            f"the wipe ({_probe_detail(rc, out)}); inspect it manually"
        )
    rc, entries = probe(
        hostname, username, port,
        f"{_WIPE_PROBE_TIMEOUT} ls -A {shlex.quote(NVME_MOUNT)} 2>&1")
    if rc != 0:
        sys.exit(
            f"refusing: could not verify {NVME_MOUNT} is empty after the wipe "
            f"(ls failed: {_probe_detail(rc, entries)}); inspect the directory "
            "manually"
        )
    if entries.strip():
        sys.exit(
            f"refusing: {NVME_MOUNT} is an unmounted non-empty directory after "
            "the allowlist wipe; unknown entries or leftovers remain "
            f"({', '.join(entries.split())}). Back up or move its contents "
            "before running setup"
        )


def wipe_unmounted_nvme(hostname, username, port, probe, run):
    """Fail-closed exact-name allowlist wipe for the unmounted branch."""
    _warn_on_resume_marker(hostname, username, port, probe)
    _stop_repo_units(hostname, username, port, probe)
    _verify_containerd_killmode(hostname, username, port, probe)
    _kill_containerd_tasks(hostname, username, port, probe, run)
    _stop_containerd(hostname, username, port, probe)
    _refuse_surviving_shims(hostname, username, port, probe)
    _unmount_allowlisted_mounts(hostname, username, port, probe, run)
    _remove_allowlisted_paths(hostname, username, port, run)
    _assert_wipe_complete(hostname, username, port, probe)


def _run_remote(hostname, username, port, cmd):
    """Default command runner for prepare_nvme: raises on a non-zero exit."""
    ssh_run(hostname, username, port, cmd, capture=False)


def prepare_nvme(hostname, username, port, mode,
                 probe=None, run=None, input_fn=input):
    """Prepare /mnt/nvme non-destructively, after a fail-closed safety check."""
    probe = ssh_capture_rc if probe is None else probe
    run = _run_remote if run is None else run
    nvme_mount = NVME_MOUNT

    rc, mounted = probe(
        hostname, username, port,
        f"findmnt -n -o SOURCE,FSTYPE --mountpoint {shlex.quote(nvme_mount)}")
    if rc == 0 and mounted.strip():
        source, fstype = _parse_findmnt_source_fstype(mounted)
        if mode == "format":
            sys.exit(f"refusing to format: {nvme_mount} is already mounted "
                     f"from {source}")
        if fstype != "ext4":
            sys.exit(f"refusing: {nvme_mount} is mounted from {source} with "
                     f"{fstype or 'an unknown filesystem'}; expected ext4")
        root_names = _root_disk_names(hostname, username, port, probe, nvme_mount)
        if _basename(source) in root_names:
            sys.exit(f"refusing to keep {nvme_mount}: {source} backs the root "
                     "filesystem")
        model = _device_model(hostname, username, port, _basename(source), probe)
        if not is_instance_store(model):
            print(f"warning: {nvme_mount} is mounted from {source}, which is not "
                  "an Amazon EC2 NVMe Instance Storage device.", file=sys.stderr)
        print(f"\n{nvme_mount} is already mounted from {source} ({fstype}); "
              "keeping it (NVME_DEVICE is ignored, no mkfs, no mount).\n")
        return
    if rc not in (0, 1):
        sys.exit(f"refusing: could not verify {nvme_mount} "
                 f"(findmnt failed: {_probe_detail(rc, mounted)})")

    # Unmounted branch: wipe the exact-name allowlist (fail-closed on anything
    # outside it) before resolving the device and mounting the real volume.
    wipe_unmounted_nvme(hostname, username, port, probe, run)

    dev = resolve_nvme_device(hostname, username, port, probe)
    if dev is None:
        sys.exit(NO_INSTANCE_STORE_MESSAGE)

    if mode == "format":
        dev = _prompt_for_format_device(
            hostname, username, port, dev, probe, input_fn)

    assert_safe_nvme_target(hostname, username, port, dev, probe)

    rc, fs_value = probe(
        hostname, username, port, f"blkid -o value -s TYPE {shlex.quote(dev)}")
    if rc == 0:
        fs_type = fs_value.strip()
    elif rc == 2:
        fs_type = ""
    else:
        sys.exit(f"refusing: could not verify {dev} "
                 f"(blkid failed: {_probe_detail(rc, fs_value)})")

    if mode == "reuse":
        if not fs_type:
            sys.exit(f"--no-format requested but {dev} has no filesystem to reuse")
        commands = _mount_commands(dev, username)
    elif mode == "format":
        print(f"\n*** WIPING {dev}: an explicit --format was requested. ***\n")
        _confirm_destruction(dev, input_fn)
        rc, _ = probe(hostname, username, port, f"test -b {shlex.quote(dev)}")
        if rc != 0:
            sys.exit(f"refusing: {dev} disappeared before mkfs")
        commands = _format_commands(dev, username)
    elif fs_type:
        print(f"\nReusing the existing {fs_type} filesystem on {dev}.\n")
        commands = _mount_commands(dev, username)
    else:
        print(f"\nNo filesystem found on {dev}; formatting it.\n")
        commands = _format_commands(dev, username)

    for command in commands:
        run(hostname, username, port, command)


def scp_to_remote(local_path, hostname, username, port, remote_path):
    # scp uses -P (uppercase) for the port, unlike ssh's -p; the identity,
    # known-hosts and keepalive options come from the shared builder.
    full_cmd = (_scp_common_args()
                + ["-P", f"{port}", local_path,
                   f"{username}@{hostname}:{remote_path}"])
    timeout = _ssh_timeout(SSH_COPY_TIMEOUT)
    print(f"\n>>> Uploading: {local_path} -> {username}@{hostname}:{remote_path}")
    try:
        subprocess.run(full_cmd, timeout=timeout, text=True, check=True)
    except FileNotFoundError:
        print("Error: scp client not found. Make sure OpenSSH is installed.", file=sys.stderr)
        sys.exit(1)
    except subprocess.TimeoutExpired:
        print(
            f"Error: scp command timed out after {timeout:g}s: {local_path} -> "
            f"{username}@{hostname}:{remote_path}\n"
            "setup_strimserver stopped; fix the cause and rerun.",
            file=sys.stderr,
        )
        sys.exit(1)
    except subprocess.CalledProcessError as exc:
        print(
            f"Error: upload failed (exit {exc.returncode}): {local_path} -> "
            f"{username}@{hostname}:{remote_path}\n"
            "setup_strimserver stopped; fix the cause and rerun.",
            file=sys.stderr,
        )
        sys.exit(1)


def describe_instance_id_for_host(hostname):
    """Best-effort recovery of the EC2 instance id behind an explicit host.

    Returns the id, or "" when no running/pending instance matches or the AWS
    CLI is unavailable. A lookup failure must never fail setup: pruning the
    host from the dedicated store already handles the reused-key case.
    """
    filters = (
        f"Name=ip-address,Values={hostname}",
        f"Name=dns-name,Values={hostname}",
    )
    for instance_filter in filters:
        try:
            proc = subprocess.run(
                ["aws", "--profile", PROFILE, "ec2", "describe-instances",
                 "--filters", instance_filter,
                 "Name=instance-state-name,Values=running,pending",
                 "--query", "Reservations[].Instances[].InstanceId",
                 "--output", "text"],
                text=True, capture_output=True, timeout=15)
        except (FileNotFoundError, subprocess.TimeoutExpired):
            return ""
        if proc.returncode != 0:
            continue
        ids = (proc.stdout or "").split()
        if ids and ids[0] != "None":
            return ids[0]
    return ""


def bind_target_instance(hostname):
    """Record host -> instance id so a later relaunch self-heals its stale key.

    INSTANCE_ID is used directly when launch passes it through the handoff;
    otherwise the id is recovered by lookup. A failed lookup only warns.
    """
    instance_id = os.environ.get("INSTANCE_ID", "").strip()
    if not instance_id:
        instance_id = describe_instance_id_for_host(hostname)
    if not instance_id:
        print(f"note: could not resolve an instance id for {hostname}; relying on "
              f"accept-new (a reused host key must be cleared manually)",
              file=sys.stderr)
        return
    try:
        known_hosts.bind_host_instance(hostname, instance_id)
    except known_hosts.KnownHostsError as exc:
        print(f"warning: could not record the instance binding: {exc}",
              file=sys.stderr)


def resolve_source():
    """Where the deployment tar comes from, and the name it lands under.

    Precedence:
      1. DEPLOYMENT_SRC -- s3://..., https://..., http://..., or a local path.
         The on-box filename is derived from the source basename; DEPLOYMENT
         is an explicit override and, when set, must agree with that basename.
      2. legacy $S3_BUCKET/$DEPLOYMENT, defaulting to DEFAULT_DEPLOYMENT.

    Returns (src, deployment).
    """
    src = os.environ.get("DEPLOYMENT_SRC", "").strip()
    explicit = os.environ.get("DEPLOYMENT", "").strip()

    if src:
        source_basename = os.path.basename(urlparse(src).path)
        deployment = explicit or source_basename
        if not deployment:
            sys.exit("DEPLOYMENT_SRC has no filename; set DEPLOYMENT explicitly.")
        if explicit and explicit != source_basename:
            print(
                f"warning: DEPLOYMENT={explicit!r} differs from the source "
                f"basename {source_basename!r}; using the explicit name "
                f"{explicit!r}.",
                file=sys.stderr,
            )
        return src, deployment

    bucket = os.environ.get("S3_BUCKET", "").strip()
    if not bucket or "<bucket-name>" in bucket:
        sys.exit(
            "No deployment source. Set DEPLOYMENT_SRC to an s3:// URI, an "
            "https:// URL (e.g. a GitHub release asset), or a local file path."
        )
    deployment = explicit or DEFAULT_DEPLOYMENT
    return f"{bucket}/{deployment}", deployment

def resolve_twitch_key():
    """Operator-supplied Twitch stream key (secret), or None.

    Precedence: TWITCH_STREAM_KEY env, then TWITCH_STREAM_KEY_FILE contents.
    """
    key = os.environ.get("TWITCH_STREAM_KEY", "").strip()
    if key:
        return key
    key_file = os.environ.get("TWITCH_STREAM_KEY_FILE", "").strip()
    if key_file:
        path = os.path.expanduser(key_file)
        if not os.path.isfile(path):
            sys.exit(f"TWITCH_STREAM_KEY_FILE not found: {path}")
        with open(path) as fh:
            return fh.read().strip()
    return None


def transfer_twitch_key(key, hostname, username, port):
    """Stream the key over stdin to a file created with umask 077.

    Previously scp wrote the destination under the remote default umask and a
    second `chmod 600` closed the window; creating it 0600 from the first byte
    removes that exposure and keeps the value out of argv entirely.
    """
    ssh_write_secret(hostname, username, port, "/mnt/nvme/twitch-stream-key", key)


def resolve_ddns_password():
    """Operator-supplied Namecheap Dynamic DNS password (secret), or None.

    Precedence: DDNS_PASSWORD env, then DDNS_PASSWORD_FILE contents.
    """
    password = os.environ.get("DDNS_PASSWORD", "").strip()
    if password:
        return password
    password_file = os.environ.get("DDNS_PASSWORD_FILE", "").strip()
    if password_file:
        path = os.path.expanduser(password_file)
        if not os.path.isfile(path):
            sys.exit(f"DDNS_PASSWORD_FILE not found: {path}")
        with open(path) as fh:
            return fh.read().strip()
    return None


def transfer_ddns_password(password, hostname, username, port):
    """Write the password to a local 0600 temp file, scp it to the box, then scrub locally."""
    import stat
    import tempfile
    fd, tmp = tempfile.mkstemp(prefix="ddns-password-")
    try:
        os.fchmod(fd, stat.S_IRUSR | stat.S_IWUSR)  # 0600
        with os.fdopen(fd, "w") as fh:
            fh.write(password + "\n")
        scp_to_remote(tmp, hostname, username, port, "/mnt/nvme/ddns-password")
    finally:
        os.remove(tmp)
    ssh_run(hostname, username, port, "chmod 600 /mnt/nvme/ddns-password")


def resolve_ddns_config():
    """Operator-supplied Dynamic DNS settings, with the bundled defaults.

    Returns (ENABLE_DDNS, DDNS_HOST, DDNS_DOMAIN). These are non-secret operator
    settings (root .env) injected at deploy time, mirroring the Twitch stream key.
    """
    enable_ddns = os.environ.get("ENABLE_DDNS", "").strip() or "false"
    ddns_host = os.environ.get("DDNS_HOST", "").strip() or "strim"
    ddns_domain = os.environ.get("DDNS_DOMAIN", "").strip()
    return enable_ddns, ddns_host, ddns_domain


def _ddns_quote(value):
    """Double-quote a value for the on-box env file.

    The on-box parser strips surrounding double quotes, so double quotes (not
    single) are required; escaping backslash, double-quote, '$' and backtick
    additionally keeps the file safe to source (entrypoint.sh).
    """
    escaped = (value.replace("\\", "\\\\")
                    .replace('"', '\\"')
                    .replace("$", "\\$")
                    .replace("`", "\\`"))
    return f'"{escaped}"'


def transfer_ddns_config(enable_ddns, ddns_host, ddns_domain, hostname, username, port):
    """Write the settings to a local 0600 temp file, scp it to the box, then scrub locally."""
    import stat
    import tempfile
    fd, tmp = tempfile.mkstemp(prefix="ddns-config-")
    try:
        os.fchmod(fd, stat.S_IRUSR | stat.S_IWUSR)  # 0600
        with os.fdopen(fd, "w") as fh:
            fh.write(f"ENABLE_DDNS={_ddns_quote(enable_ddns)}\n")
            fh.write(f"DDNS_HOST={_ddns_quote(ddns_host)}\n")
            fh.write(f"DDNS_DOMAIN={_ddns_quote(ddns_domain)}\n")
        scp_to_remote(tmp, hostname, username, port, "/mnt/nvme/ddns-config")
    finally:
        os.remove(tmp)
    ssh_run(hostname, username, port, "chmod 600 /mnt/nvme/ddns-config")


def interactive():
    """True when a human is on both ends of the pipe."""
    return sys.stdin.isatty() and sys.stdout.isatty()


def confirm(prompt):
    """True iff interactive and the operator pressed enter (not EOF/Ctrl-C)."""
    if not interactive():
        return False
    try:
        input(prompt)
        return True
    except (EOFError, KeyboardInterrupt):
        print("\nskipped.")
        return False


def offer_exec_start(host, user):
    """Offer to hand off to deploy/aws/start_strimserver by replacing this
    process (execve) - the same pattern launch uses to hand off to setup.
    Returns only if the operator declines or it cannot run; on accept the
    process image is replaced and control never comes back.
    """
    start = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                         "start_strimserver")
    if not interactive() or not os.path.exists(start):
        return

    # start_strimserver requires SSH_CMD/SSH_HOST/SSH_USER; hand it exactly what
    # setup used so it starts the service on the same box.
    env = dict(os.environ)
    env["SSH_HOST"] = host
    env["SSH_USER"] = user
    env.setdefault("SSH_CMD", "ssh")

    print(f"\nabout to run, replacing this process (execve):\n"
          f"    {start}\n"
          f"(starts strimserver.service on {user}@{host}).")
    if not confirm("press enter to start strimserver (ctrl-c to skip): "):
        return

    # Replace this process. execve keeps our stdin/stdout/stderr; start_strimserver
    # is a bash script, so exec it directly and let its shebang pick the shell.
    sys.stdout.flush()
    sys.stderr.flush()
    try:
        os.execve(start, [start], env)
    except OSError as e:
        print(f"could not exec {start}: {e}")


def select_only_nvme(hostname, username, port, probe):
    """Resolve and safety-check the target, then stop before any mutation."""
    probe = ssh_capture_rc if probe is None else probe
    dev = resolve_nvme_device(hostname, username, port, probe)
    if dev is None:
        sys.exit(NO_INSTANCE_STORE_MESSAGE)
    assert_safe_nvme_target(hostname, username, port, dev, probe)
    model = _device_model(hostname, username, port, _basename(dev), probe)
    rc, size = probe(hostname, username, port,
                     f"lsblk -dnrno SIZE {shlex.quote(dev)}")
    print(f"selected device: {dev}")
    print(f"model: {model or 'unknown'}")
    print(f"size: {size.strip() if rc == 0 else 'unknown'}")
    print("safety: safe (not the root disk, unmounted, no partitions, not swap)")


def main(argv=None, env=None, probe=None, run=None, input_fn=input):
    argv = sys.argv if argv is None else argv
    env = os.environ if env is None else env
    HOST = env.get("SSH_HOST", "strimserver")
    USER = env.get("SSH_USER", "ec2-user")
    PORT = int(env.get("SSH_PORT", "22"))
    SHA256 = env.get("DEPLOYMENT_SHA256", "").strip()

    select_only = any(arg in ("--select-only", "--dry-run") for arg in argv[1:])
    nvme_mode = parse_nvme_mode(argv)

    # A relaunch can reuse the target's public IP or DNS name, leaving a stale
    # key in the dedicated store. Drop it (and, when the instance id is cheaply
    # resolvable, self-heal every host bound to the old instance) before the
    # first connection. The operator's default known_hosts file is never used.
    known_hosts.ensure_known_hosts_dir()
    try:
        known_hosts.forget_host(HOST)
    except known_hosts.KnownHostsError as exc:
        print(f"warning: could not prune {HOST} from the private store: {exc}",
              file=sys.stderr)
    bind_target_instance(HOST)

    if select_only:
        select_only_nvme(HOST, USER, PORT, probe)
        return

    SRC, DEPLOYMENT = resolve_source()
    REMOTE_TAR = f"/mnt/nvme/{DEPLOYMENT}"
    scheme = urlparse(SRC).scheme  # 's3', 'https', 'http', or '' for a local path

    # 1) prepare /mnt/nvme - non-destructive by default.
    #    * already mounted                -> keep it untouched
    #    * --format (explicit)            -> prompt, then mkfs + mount (wipe)
    #    * --no-format                    -> reuse only; error without a filesystem
    #    * auto (default)                 -> reuse an existing filesystem, else mkfs
    prepare_nvme(HOST, USER, PORT, nvme_mode,
                 probe=probe, run=run, input_fn=input_fn)

    # 2) place the deployment tar at REMOTE_TAR, by source type
    if scheme == "s3":
        ssh_run(HOST, USER, PORT, f"aws s3 cp {SRC} {REMOTE_TAR}")
    elif scheme in ("http", "https"):
        ssh_run(HOST, USER, PORT, f"curl -fSL -o {REMOTE_TAR} {SRC}")
    else:  # local path -> upload from the operator machine
        local_path = os.path.expanduser(SRC)
        if not os.path.isfile(local_path):
            sys.exit(f"Local deployment file not found: {local_path}")
        scp_to_remote(local_path, HOST, USER, PORT, REMOTE_TAR)

    # 2b) optional integrity check (works for all source types)
    if SHA256:
        ssh_run(HOST, USER, PORT, f"echo '{SHA256}  {REMOTE_TAR}' | sha256sum --check -")

    # 2c) transfer the operator's Twitch stream key (secret), if provided
    twitch_key = resolve_twitch_key()
    if twitch_key:
        transfer_twitch_key(twitch_key, HOST, USER, PORT)
    else:
        print("\nNote: no TWITCH_STREAM_KEY provided; deploying without an egress key.\n"
              "Ingest/normalize/offline will work; set the key later for Twitch egress.\n")

    # 2d) transfer the operator's Namecheap Dynamic DNS password (secret), if provided
    ddns_password = resolve_ddns_password()
    if ddns_password:
        transfer_ddns_password(ddns_password, HOST, USER, PORT)
    else:
        print("\nNote: no DDNS_PASSWORD provided; deploying without Dynamic DNS registration.\n"
              "strim.example.com will not resolve to this box; set the password later\n"
              "to register it with Namecheap Dynamic DNS.\n")

    # 2e) transfer the operator's Dynamic DNS settings (non-secret), if configured
    enable_ddns, ddns_host, ddns_domain = resolve_ddns_config()
    if enable_ddns == "true" or ddns_domain:
        transfer_ddns_config(enable_ddns, ddns_host, ddns_domain, HOST, USER, PORT)
    else:
        print("\nNote: no ENABLE_DDNS / DDNS_DOMAIN provided; deploying with Dynamic DNS\n"
              "disabled (the bundled default). The box is reachable by public IP only;\n"
              "set ENABLE_DDNS / DDNS_HOST / DDNS_DOMAIN to register a Dynamic DNS record.\n")

    # 3) extract + hand off to deploy.sh
    run_ssh_commands(HOST, USER, PORT, [
        # Remove stale bundle helpers before extraction so a leftover
        # lib/deploy.sh from a prior bundle cannot shadow the new one.
        "cd /mnt/nvme && rm -f lib/deploy.sh lib/nvidia.sh",
        f"cd /mnt/nvme && tar -xvf {DEPLOYMENT}",
        f"cd /mnt/nvme && rm -f {DEPLOYMENT}",
        "cd /mnt/nvme && chmod +x deploy.sh",
        "cd /mnt/nvme && chmod +x setup-gpu.sh",
        "cd /mnt/nvme && chmod +x lib/nvidia.sh",
        "cd /mnt/nvme && chmod +x lib/deploy.sh",
    ])

    # 3b) run deploy.sh and propagate its exit status verbatim. A non-zero
    #     status prints the taxonomy one-liner and skips offer_exec_start.
    deploy_rc = run_deploy(HOST, USER, PORT, "cd /mnt/nvme && ./deploy.sh")
    if deploy_rc != 0:
        report_deploy_failure(deploy_rc, HOST, USER)
        sys.exit(deploy_rc)

    # 4) offer to start the service, replacing this process (execve)
    offer_exec_start(HOST, USER)


if __name__ == "__main__":
    main()
