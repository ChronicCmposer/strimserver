#!/usr/bin/env bash
#
# deploy/aws/provision-account -- admin-run bootstrap for the strimserver
# service account.
#
# Run this ONCE with an AWS administrator's ambient credentials, and again only
# when the account's access key must be re-issued. It is the only strimserver
# script that needs admin rights; everything afterwards runs as the scoped
# [strimserver] identity (deploy/aws/deploy-infra and the launch tooling).
#
# Each run, in order:
#   1. Gate on the ADMIN identity via ambient `aws sts get-caller-identity` (no
#      --profile): an exported AWS_PROFILE / AWS_DEFAULT_PROFILE is ignored
#      (env -u), so the gate can never silently switch to the operator. Unless
#      --yes, it asks for confirmation before mutating anything.
#   2. Deploy the strimserver OPERATOR stack (idempotent) with those admin
#      credentials. The stack creates the IAM user, its operator policy, the
#      instance role/profile and the Image Builder roles, so the [strimserver]
#      profile cannot deploy it. The regional network/Image Builder stack is
#      NOT deployed here: deploy-infra owns it (and its OPERATOR_CIDR /
#      S3_BUCKET_NAME / CreateNetwork / EnableExperimentalSsh inputs).
#   3. Ensure IAM user `strimserver` has exactly ONE access key. Without
#      --rotate a still-valid key already referenced by the profile is reused, so
#      a re-run is a no-op; with --rotate the new key is created FIRST, the
#      profile is written, and only then is the old key deleted.
#   4. Write the key to the [strimserver] section of the shared credentials file
#      and `[profile strimserver] region = <region>` to the config file. Each
#      file is backed up (timestamped) before it is touched, every unrelated
#      section is preserved, and mode 0600 is enforced.
#   5. Assert the profile resolves to arn:...:user/strimserver. A key minted
#      moments earlier can be rejected by STS as not-yet-valid
#      (InvalidClientTokenId), so that one transient error is retried with a
#      bounded backoff before failing.
#   6. Print a summary and the next step: run deploy/aws/deploy-infra WITHOUT
#      admin credentials (the [strimserver] profile).
#
# AWS_SHARED_CREDENTIALS_FILE and AWS_CONFIG_FILE are honored (defaults
# $HOME/.aws/credentials and $HOME/.aws/config). PROVISION_ASSERT_RETRY_DELAY
# overrides the assertion backoff (seconds) so tests run fast.
# OPERATOR_STACK_NAME overrides the operator stack name (default
# strimserver-operator); CFN_STACK_NAME is the INFRA stack name and is ignored.
#
# Usage:
#   deploy/aws/provision-account [--stack-name S] [--region R] [--profile P]
#                                [--rotate] [--yes]
#
# License: proprietary (see LICENSE). All rights reserved.

set -euo pipefail
umask 077

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE="${SCRIPT_DIR}/strimserver-operator.yaml"

IAM_USER="strimserver"
# The INFRA stack name: the literal that .env.example assigns to CFN_STACK_NAME.
# The operator stack must never reuse it (they are different stacks/templates).
INFRA_STACK_NAME="strimserver"
# Deliberately does NOT read CFN_STACK_NAME: operators source .env.example, which
# sets CFN_STACK_NAME to the INFRA stack, and inheriting it here once deployed the
# operator template into the infra stack. Only OPERATOR_STACK_NAME overrides this.
STACK_NAME="${OPERATOR_STACK_NAME:-strimserver-operator}"
PROJECT_NAME="${PROJECT_NAME:-strimserver}"
REGION="${AWS_REGION:-us-east-2}"
PROFILE="${AWS_PROFILE:-strimserver}"
# Optional operator-stack passthroughs. Both are omitted unless explicitly set,
# so the template Default stays authoritative (movienight item 205).
S3_BUCKET_NAME="${S3_BUCKET_NAME:-}"
ENABLE_SESSION_MANAGER="${ENABLE_SESSION_MANAGER-}"
ROTATE=0
ASSUME_YES=0

# Bounded retry budget for the post-provision identity assertion. IAM is
# eventually consistent, so a freshly minted key may not be valid at STS yet.
ASSERT_RETRY_ATTEMPTS=6
ASSERT_RETRY_DELAY="${PROVISION_ASSERT_RETRY_DELAY:-2}"

CREDENTIALS_FILE="${AWS_SHARED_CREDENTIALS_FILE:-${HOME}/.aws/credentials}"
CONFIG_FILE="${AWS_CONFIG_FILE:-${HOME}/.aws/config}"

log() { printf 'provision-account: %s\n' "$*" >&2; }
die() { printf 'provision-account: ERROR: %s\n' "$*" >&2; exit 1; }
warn() { printf 'provision-account: WARNING: %s\n' "$*" >&2; }

usage() {
  cat <<'EOF'
Usage: deploy/aws/provision-account [options]

Bootstraps the strimserver service account from an AWS administrator's ambient
credentials. Idempotent: a second run reuses the existing access key and leaves
the profile untouched.

Options:
  --stack-name S   CloudFormation operator stack name
                   (default: strimserver-operator, or OPERATOR_STACK_NAME)
  --region R       AWS region (default: us-east-2)
  --profile P      AWS profile to install (default: strimserver)
  --rotate         mint a new access key, update the profile, then delete the
                   old key (default: reuse the existing key)
  --yes            skip the admin-identity confirmation prompt
  -h, --help       show this help

Environment:
  OPERATOR_STACK_NAME  operator stack name (default: strimserver-operator).
                       CFN_STACK_NAME (the INFRA stack name from .env.example) is
                       intentionally ignored here. The operator stack name must
                       NOT equal the infra stack name ('strimserver').
  S3_BUCKET_NAME       optional; passed as DeploymentBucketName when non-empty
  ENABLE_SESSION_MANAGER  optional true/false; passed as EnableSessionManager
                       only when explicitly set (template Default: true)

Deploys ONLY the account-global operator template (IAM user, operator policy,
instance role/profile and Image Builder roles). The regional network/Image
Builder stack is deployed afterwards by deploy/aws/deploy-infra as the
[strimserver] profile; its OPERATOR_CIDR / S3_BUCKET_NAME / CreateNetwork /
EnableExperimentalSsh environment inputs do NOT apply here.
EOF
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "'$1' not found on PATH"
}

# aws_admin: the aws CLI with the ambient ADMIN credentials, ignoring an
# exported AWS_PROFILE/AWS_DEFAULT_PROFILE. The gate, the stack deploy, and the
# IAM key steps run before the [strimserver] profile exists (and create it), so
# they must never silently switch to the operator identity.
aws_admin() {
  env -u AWS_PROFILE -u AWS_DEFAULT_PROFILE aws "$@"
}

parse_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --stack-name)
        [ "$#" -ge 2 ] && [ -n "$2" ] || die "--stack-name requires a value"
        STACK_NAME="$2"; shift 2 ;;
      --stack-name=*)
        STACK_NAME="${1#*=}"; [ -n "$STACK_NAME" ] || die "--stack-name requires a value"; shift ;;
      --region)
        [ "$#" -ge 2 ] && [ -n "$2" ] || die "--region requires a value"
        REGION="$2"; shift 2 ;;
      --region=*)
        REGION="${1#*=}"; [ -n "$REGION" ] || die "--region requires a value"; shift ;;
      --profile)
        [ "$#" -ge 2 ] && [ -n "$2" ] || die "--profile requires a value"
        PROFILE="$2"; shift 2 ;;
      --profile=*)
        PROFILE="${1#*=}"; [ -n "$PROFILE" ] || die "--profile requires a value"; shift ;;
      --rotate) ROTATE=1; shift ;;
      --yes) ASSUME_YES=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown argument: $1 (try --help)" ;;
    esac
  done
}

validate_assert_retry_delay() {
  [[ "$ASSERT_RETRY_DELAY" =~ ^[0-9]+$ ]] \
    || die "PROVISION_ASSERT_RETRY_DELAY must be a non-negative integer (got '${ASSERT_RETRY_DELAY}')"
}

# reject_infra_stack_name: the operator stack and the infra stack are different
# templates and must never share a name. This guards against the historical leak
# (CFN_STACK_NAME from .env.example) and against a mistyped override.
reject_infra_stack_name() {
  [ "$STACK_NAME" != "$INFRA_STACK_NAME" ] || die "operator stack must not share the infra stack name '${INFRA_STACK_NAME}'; set OPERATOR_STACK_NAME or pass --stack-name to a distinct operator stack name"
}

gate_admin_identity() {
  local arn reply
  arn="$(aws_admin sts get-caller-identity --query 'Arn' --output text --region "$REGION")" \
    || die "failed to read the admin identity from ambient credentials (aws sts get-caller-identity)"
  [ -n "$arn" ] && [ "$arn" != "None" ] \
    || die "could not parse the admin ARN from sts get-caller-identity"
  ADMIN_ARN="$arn"
  log "admin identity: ${ADMIN_ARN}"

  [ "$ASSUME_YES" -eq 1 ] && return 0

  printf 'Provision the strimserver service account with this admin identity? [y/N] ' >&2
  read -r reply || true
  case "$reply" in
    y|Y|yes|YES) return 0 ;;
    *) die "aborted: admin identity not confirmed" ;;
  esac
}

validate_session_manager() {
  case "$ENABLE_SESSION_MANAGER" in
    ""|true|false) ;;
    *) die "ENABLE_SESSION_MANAGER must be 'true' or 'false' (got '${ENABLE_SESSION_MANAGER}')" ;;
  esac
}

deploy_stack() {
  local -a overrides=("ProjectName=${PROJECT_NAME}")
  # Pass ONLY explicitly-set optional values; otherwise the template Default is
  # authoritative (EnableSessionManager defaults to true in the template).
  if [ -n "$S3_BUCKET_NAME" ]; then
    overrides+=("DeploymentBucketName=${S3_BUCKET_NAME}")
  fi
  if [ -n "$ENABLE_SESSION_MANAGER" ]; then
    overrides+=("EnableSessionManager=${ENABLE_SESSION_MANAGER}")
  fi
  log "deploying operator stack '${STACK_NAME}' in ${REGION}"
  aws_admin cloudformation deploy \
    --template-file "$TEMPLATE" \
    --stack-name "$STACK_NAME" \
    --region "$REGION" \
    --capabilities CAPABILITY_NAMED_IAM \
    --parameter-overrides "${overrides[@]}" \
    || die "cloudformation deploy failed for stack '${STACK_NAME}'"
}

require_iam_user() {
  aws_admin iam get-user --user-name "$IAM_USER" --region "$REGION" >/dev/null \
    || die "IAM user '${IAM_USER}' not found after the stack deploy"
}

profile_key_id() { # profile_key_id <profile> -> key id in [<profile>], or empty
  local profile="$1"
  [ -f "$CREDENTIALS_FILE" ] || return 0
  awk -v hdr="[${profile}]" '
    $0 == hdr { in_sec = 1; next }
    /^\[/     { in_sec = 0 }
    in_sec && /^[[:space:]]*aws_access_key_id[[:space:]]*=/ {
      line = $0; sub(/^[^=]*=[[:space:]]*/, "", line); print line; exit
    }' "$CREDENTIALS_FILE"
}

backup_file() { # backup_file <file>: timestamped 0600 copy, only if it exists
  local file="$1" stamp dest
  [ -f "$file" ] || return 0
  stamp="$(date +%Y%m%d%H%M%S)"
  dest="${file}.bak.${stamp}"
  cp -p "$file" "$dest"
  chmod 600 "$dest" || die "could not restrict the backup ${dest} to mode 0600"
  log "backed up ${file} -> ${dest}"
}

upsert_ini_section() { # upsert_ini_section <file> <header> <body>
  local file="$1" header="$2" body="$3" tmp
  tmp="$(mktemp "${file}.tmp.XXXXXX")" \
    || die "could not create a temp file beside ${file}"
  if [ -f "$file" ]; then
    # Drop the old section (header through the next header); keep the rest.
    awk -v hdr="$header" '
      /^\[/ {
        line = $0; sub(/\r+$/, "", line); sub(/[[:space:]]+$/, "", line)
        in_sec = (line == hdr) ? 1 : 0
      }
      !in_sec { print }
    ' "$file" >"$tmp"
  fi
  printf '%s\n%s\n' "$header" "$body" >>"$tmp"
  if ! chmod 600 "$tmp"; then
    rm -f "$tmp"
    die "could not restrict ${file} to mode 0600"
  fi
  mv "$tmp" "$file"
}

config_region_is_current() { # 0 when [profile <profile>] already has region = REGION
  local profile="$1"
  [ -f "$CONFIG_FILE" ] || return 1
  awk -v hdr="[profile ${profile}]" -v want_region="$REGION" '
    /^\[/ {
      line = $0; sub(/\r+$/, "", line); sub(/[[:space:]]+$/, "", line)
      in_sec = (line == hdr) ? 1 : 0
      next
    }
    in_sec {
      line = $0
      sub(/\r+$/, "", line)
      sub(/^[[:space:]]+/, "", line)
      sub(/[[:space:]]+$/, "", line)
      sub(/[[:space:]]*=[[:space:]]*/, "=", line)
      if (line == "region=" want_region) { found = 1; exit }
    }
    END { exit(found ? 0 : 1) }
  ' "$CONFIG_FILE"
}

write_config_region() { # write_config_region <profile>
  local profile="$1"
  config_region_is_current "$profile" && return 0
  backup_file "$CONFIG_FILE"
  upsert_ini_section "$CONFIG_FILE" "[profile ${profile}]" "region = ${REGION}"
  chmod 600 "$CONFIG_FILE" || die "could not restrict ${CONFIG_FILE} to mode 0600"
}

write_profile() { # write_profile <profile>
  local profile="$1"
  backup_file "$CREDENTIALS_FILE"
  upsert_ini_section "$CREDENTIALS_FILE" "[${profile}]" \
"aws_access_key_id = ${NEW_ACCESS_KEY_ID}
aws_secret_access_key = ${NEW_SECRET_ACCESS_KEY}"
  chmod 600 "$CREDENTIALS_FILE" || die "could not restrict ${CREDENTIALS_FILE} to mode 0600"
  write_config_region "$profile"
}

create_new_access_key() { # create_new_access_key <user>
  local user="$1" fields
  fields="$(aws_admin iam create-access-key --user-name "$user" \
    --region "$REGION" --query 'AccessKey.[AccessKeyId,SecretAccessKey]' --output text)" \
    || die "failed to create an access key for user '${user}'"
  read -r NEW_ACCESS_KEY_ID NEW_SECRET_ACCESS_KEY <<<"$fields"
  [ -n "$NEW_ACCESS_KEY_ID" ] && [ -n "$NEW_SECRET_ACCESS_KEY" ] \
    || die "create-access-key returned no credentials"
}

delete_access_keys_except() { # delete_access_keys_except <user> <keep-id> [id...]
  local user="$1" keep="$2"; shift 2
  local id
  for id in "$@"; do
    [ "$id" = "$keep" ] && continue
    aws_admin iam delete-access-key --user-name "$user" \
      --access-key-id "$id" --region "$REGION" \
      || die "failed to delete access key '${id}'"
  done
}

# ensure_single_access_key <user> <profile>: leave exactly ONE key on <user> and
# its id+secret in [<profile>]. Sets ENSURED_ACCESS_KEY_ID to the key that ended
# up in the profile (minted or reused).
ensure_single_access_key() {
  local user="$1" profile="$2"
  local keys_text existing_id keep_id id
  local -a ids=()

  keys_text="$(aws_admin iam list-access-keys --user-name "$user" \
    --region "$REGION" --query 'AccessKeyMetadata[].AccessKeyId' --output text)" \
    || die "failed to list access keys for user '${user}'"
  read -r -a ids <<<"$keys_text" || true

  # keep_id: the profile's key when it still exists on the user. IAM permits at
  # most TWO access keys, so this is also the key a rotation must preserve until
  # the profile is rewritten.
  existing_id="$(profile_key_id "$profile")"
  keep_id=""
  if [ -n "$existing_id" ]; then
    for id in ${ids[@]+"${ids[@]}"}; do
      [ "$id" = "$existing_id" ] && keep_id="$id"
    done
  fi

  if [ "$ROTATE" -eq 1 ]; then
    log "rotating the access key for user '${user}'"
    # IAM rejects a third key with LimitExceeded, so prune every key except the
    # profile's current one BEFORE minting; it stays valid until the profile is
    # rewritten.
    if (( ${#ids[@]} > 0 )); then
      delete_access_keys_except "$user" "$keep_id" "${ids[@]}"
    fi
    create_new_access_key "$user"
    write_profile "$profile"
    if [ -n "$keep_id" ]; then
      delete_access_keys_except "$user" "" "$keep_id"
    fi
    ENSURED_ACCESS_KEY_ID="$NEW_ACCESS_KEY_ID"
    return 0
  fi

  # Reuse the profile's key when it still exists: a second run is a no-op (no
  # new key, no profile rewrite). Surplus keys are removed here too, so the
  # exactly-ONE-key invariant holds on the reuse path.
  if [ -n "$keep_id" ]; then
    log "reusing access key ${keep_id:0:4}**** for profile '${profile}'"
    delete_access_keys_except "$user" "$keep_id" "${ids[@]+"${ids[@]}"}"
    write_config_region "$profile"
    ENSURED_ACCESS_KEY_ID="$keep_id"
    return 0
  fi

  if (( ${#ids[@]} > 0 )); then
    log "removing ${#ids[@]} stale access key(s) for user '${user}'"
  fi
  delete_access_keys_except "$user" "" "${ids[@]+"${ids[@]}"}"
  create_new_access_key "$user"
  write_profile "$profile"
  ENSURED_ACCESS_KEY_ID="$NEW_ACCESS_KEY_ID"
}

# assert_identity <profile> <expected-user> <arn-out-var>: prove the profile
# resolves to :user/<expected-user>. A key minted moments ago can be rejected by
# STS with InvalidClientTokenId (IAM eventual consistency): retry that ONE
# transient error with a bounded backoff. Any other error fails immediately, and
# a resolved-but-wrong identity is never retried because it cannot correct itself.
assert_identity() {
  local profile="$1" expected_user="$2" out_var="$3"
  local attempt arn err errfile
  errfile="$(mktemp)"
  for (( attempt = 1; attempt <= ASSERT_RETRY_ATTEMPTS; attempt++ )); do
    if arn="$(aws --profile "$profile" sts get-caller-identity \
          --region "$REGION" --query 'Arn' --output text 2>"$errfile")"; then
      rm -f "$errfile"
      [[ "$arn" == *":user/${expected_user}" ]] \
        || die "profile '${profile}' resolved to '${arn}'; expected an ARN ending in :user/${expected_user}"
      printf -v "$out_var" '%s' "$arn"
      return 0
    fi
    err="$(cat "$errfile")"

    if [[ "$err" != *InvalidClientTokenId* ]]; then
      rm -f "$errfile"
      die "could not resolve profile '${profile}' (is '${CREDENTIALS_FILE}' configured?): ${err:-<no stderr>}"
    fi
    if (( attempt == ASSERT_RETRY_ATTEMPTS )); then
      die "profile '${profile}' was written, but its new access key is still not valid after ${ASSERT_RETRY_ATTEMPTS} attempts (IAM eventual consistency): ${err:-<no stderr>}"
    fi
    warn "profile '${profile}' access key not valid yet (InvalidClientTokenId); retrying in ${ASSERT_RETRY_DELAY}s (attempt ${attempt}/${ASSERT_RETRY_ATTEMPTS})"
    sleep "$ASSERT_RETRY_DELAY"
  done
}

print_summary() {
  printf '\n'
  log "provisioned the strimserver service account"
  printf '  admin identity : %s\n' "$ADMIN_ARN"
  printf '  operator user  : %s\n' "$OPERATOR_ARN"
  printf '  profile        : %s (%s)\n' "$PROFILE" "$CREDENTIALS_FILE"
  printf '  config         : %s\n' "$CONFIG_FILE"
  printf '  region         : %s\n' "$REGION"
  printf '  stack          : %s\n' "$STACK_NAME"
  printf '  next           : run deploy/aws/deploy-infra without admin credentials (AWS_PROFILE=%s)\n' "$PROFILE"
  printf '                   it deploys the regional infra stack (network + Image Builder)\n'
}

main() {
  parse_args "$@"
  validate_assert_retry_delay
  validate_session_manager
  reject_infra_stack_name
  require_cmd aws

  mkdir -p "$(dirname "$CREDENTIALS_FILE")" "$(dirname "$CONFIG_FILE")"

  gate_admin_identity
  deploy_stack
  require_iam_user
  ensure_single_access_key "$IAM_USER" "$PROFILE"
  assert_identity "$PROFILE" "$IAM_USER" OPERATOR_ARN
  print_summary
}

main "$@"
