#!/usr/bin/env bash
#
# deploy/aws/deploy-infra -- deploy the strimserver durable CloudFormation stack
# as the project-scoped [strimserver] service account.
#
# RUN MODEL
#   Once, with an AWS administrator's ambient credentials:
#     deploy/aws/provision-account
#   It creates the account-global operator stack (IAM user, operator policy,
#   instance role/profile and Image Builder roles) and the [strimserver]
#   access key. Afterwards every operation -- this script (which deploys the
#   REGIONAL infra template) and the launch tooling -- runs as that profile.
#   deploy-infra NO LONGER uses admin credentials and NEVER rotates an access
#   key (that lives in provision-account).
#
# WHY LIVE PARAMETERS ARE RE-PASSED
#   `aws cloudformation deploy` treats any parameter omitted from
#   --parameter-overrides as "reset to the template default". An update that only
#   wanted to bump one value would silently clear VpcId, ports, the bucket, the
#   Image Builder URLs, etc. When the stack already exists this script therefore
#   reads every live parameter from describe-stacks and re-passes it verbatim,
#   applying only explicit overrides:
#     OPERATOR_CIDR        -> OperatorCidr + IngestCidr
#     S3_BUCKET_NAME       -> DeploymentBucketName
#     NVIDIA_DRIVER_FLOOR  -> NvidiaDriverFloor (must match lib/nvidia.sh)
#     CREATE_NETWORK       -> CreateNetwork (explicit only; defaults to the live value)
#     ENABLE_EXPERIMENTAL_SSH -> EnableExperimentalSsh (explicit only; defaults to live)
#   On first create (no stack) it passes the env values and otherwise lets the
#   template defaults apply (NvidiaDriverFloor is always pinned to lib/nvidia.sh).
#
# POST-DEPLOY CONTRACT
#   * Stack status must be CREATE_COMPLETE or UPDATE_COMPLETE.
#   * The live NvidiaDriverFloor parameter must equal NVIDIA_DRIVER_FLOOR from
#     deploy/aws/lib/nvidia.sh. A floor bump that updates the library but not the
#     stack (or a hand-edited parameter) fails loud here.
#   * The BakedImagePipeline must exist, so a rebuild can be triggered.
#
# Usage:
#   deploy/aws/deploy-infra [--stack-name S] [--region R] [--profile P]
#
# License: proprietary (see LICENSE). All rights reserved.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE="${SCRIPT_DIR}/strimserver-infra.yaml"

# NVIDIA_DRIVER_FLOOR is the canonical version-floor contract. Capture an
# explicit env override before sourcing the library (which assigns the floor),
# then always compare the deployed value against the library's floor.
NVIDIA_DRIVER_FLOOR_OVERRIDE="${NVIDIA_DRIVER_FLOOR:-}"
# shellcheck source=lib/nvidia.sh
source "${SCRIPT_DIR}/lib/nvidia.sh"
EXPECTED_FLOOR="$NVIDIA_DRIVER_FLOOR"

STACK_NAME="${CFN_STACK_NAME:-strimserver}"
REGION="${AWS_REGION:-${AWS_DEFAULT_REGION:-us-east-2}}"
PROFILE="${AWS_PROFILE:-strimserver}"
OPERATOR_CIDR="${OPERATOR_CIDR:-}"
S3_BUCKET_NAME="${S3_BUCKET_NAME:-}"
# Explicit network overlays are honored only when set; otherwise the live value
# (or, on first create, the template default) is used.
CREATE_NETWORK="${CREATE_NETWORK-}"
ENABLE_EXPERIMENTAL_SSH="${ENABLE_EXPERIMENTAL_SSH-}"
PIPELINE_NAME="strimserver-baked"

log() { printf 'deploy-infra: %s\n' "$*" >&2; }
die() { printf 'deploy-infra: ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: deploy/aws/deploy-infra [options]

Deploys the strimserver stack as the [strimserver] service account. Run
deploy/aws/provision-account once (with admin credentials) first.

Options:
  --stack-name S   CloudFormation stack name (default: strimserver)
  --region R       AWS region (default: us-east-2)
  --profile P      AWS profile (default: $AWS_PROFILE, else strimserver)
  -h, --help       show this help

Overrides (environment): OPERATOR_CIDR, S3_BUCKET_NAME, NVIDIA_DRIVER_FLOOR,
CREATE_NETWORK, ENABLE_EXPERIMENTAL_SSH. Existing stack parameters are otherwise
preserved verbatim.
EOF
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "'$1' not found on PATH"
}

parse_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --stack-name)
        [ "$#" -ge 2 ] && [ -n "$2" ] || die "--stack-name requires a value"
        STACK_NAME="$2"; shift 2 ;;
      --stack-name=*)
        STACK_NAME="${1#*=}"; [ -n "$STACK_NAME" ] || die "--stack-name requires a value"; shift ;;
      --region)
        [ "$#" -ge 2 ] && [ -n "$2" ] || die "--region requires a value"
        REGION="$2"; shift 2 ;;
      --region=*)
        REGION="${1#*=}"; [ -n "$REGION" ] || die "--region requires a value"; shift ;;
      --profile)
        [ "$#" -ge 2 ] && [ -n "$2" ] || die "--profile requires a value"
        PROFILE="$2"; shift 2 ;;
      --profile=*)
        PROFILE="${1#*=}"; [ -n "$PROFILE" ] || die "--profile requires a value"; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown argument: $1 (try --help)" ;;
    esac
  done
}

aws_run() {
  aws --profile "$PROFILE" --region "$REGION" "$@"
}

require_strimserver_identity() {
  local arn
  arn="$(aws_run sts get-caller-identity --query 'Arn' --output text)" \
    || die "not authenticated for profile '$PROFILE'; run deploy/aws/provision-account first"
  case "$arn" in
    *:user/strimserver) log "operator identity: ${arn}" ;;
    *) die "profile '$PROFILE' authenticated as '$arn', expected ...:user/strimserver. Run deploy/aws/provision-account (with admin credentials) first." ;;
  esac
}

# describe_parameters: one `Key<TAB>Value` line per live parameter. A missing
# stack is not an error here -- it selects the first-create path.
describe_parameters() {
  aws_run cloudformation describe-stacks \
    --stack-name "$STACK_NAME" \
    --query 'Stacks[0].Parameters[].[ParameterKey,ParameterValue]' \
    --output text 2>/dev/null
}

validate_bool() { # validate_bool <name> <value>
  case "$2" in
    true|false) ;;
    *) die "$1 must be 'true' or 'false' (got '$2')" ;;
  esac
}

# build_parameters: sets PARAM_ARGS to the complete --parameter-overrides list.
# STACK_EXISTS is 0 on first create, 1 when live parameters were loaded.
build_parameters() {
  local live key value
  local -a keys=()
  declare -A params=()

  STACK_EXISTS=0
  if live="$(describe_parameters)"; then
    STACK_EXISTS=1
    while IFS=$'\t' read -r key value; do
      [ -n "$key" ] && params["$key"]="$value"
    done <<<"$live"
  fi

  if [ -n "$OPERATOR_CIDR" ]; then
    params[OperatorCidr]="$OPERATOR_CIDR"
    params[IngestCidr]="$OPERATOR_CIDR"
  elif [ "$STACK_EXISTS" -eq 0 ]; then
    die "OPERATOR_CIDR is required on first create (it becomes OperatorCidr and IngestCidr)"
  fi

  if [ -n "$S3_BUCKET_NAME" ]; then
    params[DeploymentBucketName]="$S3_BUCKET_NAME"
  fi

  params[NvidiaDriverFloor]="${NVIDIA_DRIVER_FLOOR_OVERRIDE:-$EXPECTED_FLOOR}"

  if [ -n "$CREATE_NETWORK" ]; then
    validate_bool CREATE_NETWORK "$CREATE_NETWORK"
    params[CreateNetwork]="$CREATE_NETWORK"
  fi
  if [ -n "$ENABLE_EXPERIMENTAL_SSH" ]; then
    validate_bool ENABLE_EXPERIMENTAL_SSH "$ENABLE_EXPERIMENTAL_SSH"
    params[EnableExperimentalSsh]="$ENABLE_EXPERIMENTAL_SSH"
  fi

  PARAM_ARGS=()
  for key in "${!params[@]}"; do
    keys+=("$key")
  done
  # Stable order makes logs/diffs readable and the deploy reproducible.
  while IFS= read -r key; do
    PARAM_ARGS+=("${key}=${params[$key]}")
  done < <(printf '%s\n' ${keys[@]+"${keys[@]}"} | sort)
}

deploy_stack() {
  local mode="first create"
  [ "$STACK_EXISTS" -eq 1 ] && mode="existing stack"
  log "deploying stack '${STACK_NAME}' in ${REGION} as profile '${PROFILE}' (${mode})"
  aws_run cloudformation deploy \
    --template-file "$TEMPLATE" \
    --stack-name "$STACK_NAME" \
    --capabilities CAPABILITY_NAMED_IAM \
    --parameter-overrides "${PARAM_ARGS[@]}" \
    || die "cloudformation deploy failed for stack '${STACK_NAME}'"
}

verify_stack_status() {
  local status
  status="$(aws_run cloudformation describe-stacks \
    --stack-name "$STACK_NAME" \
    --query 'Stacks[0].StackStatus' --output text)" \
    || die "could not read the stack status for '${STACK_NAME}'"
  case "$status" in
    CREATE_COMPLETE|UPDATE_COMPLETE) log "stack status: ${status}" ;;
    *) die "stack '${STACK_NAME}' is in status '${status}', expected CREATE_COMPLETE or UPDATE_COMPLETE" ;;
  esac
}

verify_nvidia_floor() {
  local live_floor
  live_floor="$(describe_parameters \
    | awk -F'\t' '$1 == "NvidiaDriverFloor" { print $2 }')" \
    || die "could not read the live NvidiaDriverFloor parameter"
  [ -n "$live_floor" ] \
    || die "stack '${STACK_NAME}' has no NvidiaDriverFloor parameter; the version-floor contract is missing"
  [ "$live_floor" = "$EXPECTED_FLOOR" ] \
    || die "NvidiaDriverFloor drift: stack reports '${live_floor}' but deploy/aws/lib/nvidia.sh pins '${EXPECTED_FLOOR}'. Update lib/nvidia.sh and the stack together."
  log "NvidiaDriverFloor matches lib/nvidia.sh (${EXPECTED_FLOOR})"
}

verify_image_pipeline() {
  local pipelines
  pipelines="$(aws_run imagebuilder list-image-pipelines \
    --query 'imagePipelineList[].name' --output text)" \
    || die "could not list Image Builder pipelines"
  grep -qw "$PIPELINE_NAME" <<<"$pipelines" \
    || die "Image Builder pipeline '${PIPELINE_NAME}' (BakedImagePipeline) not found; the stack did not create the baked-AMI pipeline"
  log "Image Builder pipeline present: ${PIPELINE_NAME}"
}

main() {
  parse_args "$@"
  require_cmd aws
  require_strimserver_identity
  build_parameters
  deploy_stack
  verify_stack_status
  verify_nvidia_floor
  verify_image_pipeline
  log "done. Stack '${STACK_NAME}' is updated as the [${PROFILE}] service account."
}

main "$@"
