#!/usr/bin/env bash
# deploy-infra: deploy the strimserver durable CloudFormation stack, then
# ensure the strimserver IAM service account has a usable access key and write
# it to the project-scoped [strimserver] profile.
#
# RUN WITH YOUR OWN ADMINISTRATOR CREDENTIALS. Re-runnable but NOT idempotent:
# the stack deploy is declarative (a no-op when nothing changed), while the
# access-key step deliberately ROTATES to exactly one fresh key and rewrites the
# [strimserver] section of the local ~/.aws/credentials each run (an IAM secret
# can only be shown once). Each run, in order:
#   1. creates the new key FIRST, so a failed create leaves the old key intact
#      and the operator is never left with zero keys;
#   2. writes the [strimserver] credentials + [profile strimserver] region
#      (backed up first; every other profile is preserved verbatim);
#   3. deletes the now-superseded old key(s); and
#   4. asserts the new key authenticates as arn:...:user/strimserver.
# All strimserver tooling then selects this profile via AWS_PROFILE (default
# strimserver).
set -euo pipefail

# --- Env-driven tunables (empty = omit / use defaults) ------------------------
OPERATOR_CIDR="${OPERATOR_CIDR:-}"
S3_BUCKET_NAME="${S3_BUCKET_NAME:-}"
IAM_USER="${IAM_USER:-strimserver}"
CFN_STACK_NAME="${CFN_STACK_NAME:-strimserver}"
# The dedicated operator profile this script provisions. Honors an explicit
# AWS_PROFILE (the variable every strimserver tooling script pins); defaults to
# [strimserver]. Deliberately NOT exported: the stack deploy and key creation
# run as the ambient ADMIN identity and must not be redirected to this profile.
PROFILE="${AWS_PROFILE:-strimserver}"
# ------------------------------------------------------------------------------

command -v aws >/dev/null 2>&1 \
  || { echo "deploy-infra: ERROR: aws CLI not found on PATH" >&2; exit 1; }
aws sts get-caller-identity >/dev/null \
  || { echo "deploy-infra: ERROR: not authenticated; configure AWS_PROFILE / credentials first" >&2; exit 1; }

log() { printf 'deploy-infra: %s\n' "$*" >&2; }

# backup_file <file>: timestamped copy, only when the file exists.
backup_file() {
  local file="$1" stamp
  [ -f "$file" ] || return 0
  stamp="$(date +%Y%m%d%H%M%S)"
  cp -p "$file" "${file}.bak.${stamp}"
  log "backed up $file -> ${file}.bak.${stamp}"
}

# upsert_ini_section <file> <header> <body>: replace the named INI section (its
# header through the next header), preserving every other section verbatim.
upsert_ini_section() {
  local file="$1" header="$2" body="$3" tmp
  tmp="${file}.tmp.$$"
  if [ -f "$file" ]; then
    # Normalize a trailing CR (CRLF/Windows/WSL files) and trailing spaces
    # before the header comparison, so a padded/CRLF header is replaced in
    # place instead of being appended as a duplicate section.
    awk -v hdr="$header" '
      /^\[/ {
        line = $0
        sub(/\r+$/, "", line)
        sub(/[[:space:]]+$/, "", line)
        in_sec = (line == hdr) ? 1 : 0
      }
      !in_sec { print }
    ' "$file" >"$tmp"
  else
    : >"$tmp"
  fi
  printf '%s\n%s\n' "$header" "$body" >>"$tmp"
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$file"
}

# --- 1. Deploy the durable CloudFormation stack -------------------------------
# The stack creates an IAM user, so the named-IAM capability is required
# (CAPABILITY_IAM is a strict subset and would be redundant).
aws cloudformation deploy \
  --template-file deploy/aws/strimserver-infra.yaml \
  --stack-name "$CFN_STACK_NAME" \
  --capabilities CAPABILITY_NAMED_IAM \
  --parameter-overrides \
      CreateNetwork="true" \
      OperatorCidr="$OPERATOR_CIDR" \
      IngestCidr="$OPERATOR_CIDR" \
      EnableExperimentalSsh="true" \
      DeploymentBucketName="$S3_BUCKET_NAME"   # omit when using https/local deploy

# --- 2. Ensure the strimserver service account has a usable access key --------
# The IAM user and its read-only ssm:GetParameter policy are created by the stack
# above; CloudFormation cannot create IAM access keys, so create/rotate one here.
if ! aws iam get-user --user-name "$IAM_USER" >/dev/null 2>&1; then
  echo "deploy-infra: ERROR: IAM user '$IAM_USER' not found after stack deploy" >&2
  exit 1
fi

OLD_KEYS="$(aws iam list-access-keys --user-name "$IAM_USER" \
  --query 'AccessKeyMetadata[].AccessKeyId' --output text)"

log "creating a fresh access key for '$IAM_USER'"
read -r ACCESS_KEY_ID SECRET < <(aws iam create-access-key --user-name "$IAM_USER" \
  --query 'AccessKey.[AccessKeyId,SecretAccessKey]' --output text)

# --- 3. Write the [strimserver] profile + region (backup first) ---------------
# The service-account key lands under [strimserver], never [default]: the ambient
# default is a different identity, and every strimserver tool pins [strimserver].
# Writing before deleting means a failure here still leaves the old key valid.
CREDENTIALS_FILE="${AWS_SHARED_CREDENTIALS_FILE:-$HOME/.aws/credentials}"
CONFIG_FILE="${AWS_CONFIG_FILE:-$HOME/.aws/config}"
mkdir -p "$(dirname "$CREDENTIALS_FILE")" "$(dirname "$CONFIG_FILE")"

backup_file "$CREDENTIALS_FILE"
upsert_ini_section "$CREDENTIALS_FILE" "[$PROFILE]" \
  "aws_access_key_id = $ACCESS_KEY_ID
aws_secret_access_key = $SECRET"

# Region for [profile strimserver]: explicit AWS_REGION/AWS_DEFAULT_REGION wins,
# else the ambient admin CLI's configured region, else the project default
# (us-east-2 -- where the pinned x86_64 AL2023 DLAMI lives). Without this the
# profile carries no region and tooling would have to pass --region everywhere.
REGION="${AWS_REGION:-${AWS_DEFAULT_REGION:-}}"
if [ -z "$REGION" ]; then
  REGION="$(aws configure get region 2>/dev/null || true)"
fi
REGION="${REGION:-us-east-2}"

backup_file "$CONFIG_FILE"
upsert_ini_section "$CONFIG_FILE" "[profile $PROFILE]" "region = $REGION"
log "wrote [$PROFILE] to $CREDENTIALS_FILE and [profile $PROFILE] region = $REGION to $CONFIG_FILE"

# --- 4. Delete the superseded key(s), only once the new key is in place -------
for key in $OLD_KEYS; do
  if [ "$key" = "$ACCESS_KEY_ID" ]; then
    continue
  fi
  log "deleting superseded access key $key"
  aws iam delete-access-key --user-name "$IAM_USER" --access-key-id "$key"
done

# --- 5. Assert the minted key really is the strimserver operator --------------
ASSERTED_ARN="$(aws --profile "$PROFILE" sts get-caller-identity \
  --query Arn --output text 2>/dev/null || true)"
case "$ASSERTED_ARN" in
  *:user/strimserver) ;;
  *)
    echo "deploy-infra: ERROR: the new [$PROFILE] profile did not authenticate as ...:user/strimserver (got '${ASSERTED_ARN:-<none>}')" >&2
    exit 1
    ;;
esac
log "verified [$PROFILE] authenticates as $ASSERTED_ARN"

log "done. The [$PROFILE] profile is written to $CREDENTIALS_FILE."
