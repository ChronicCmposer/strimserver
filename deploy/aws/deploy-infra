#!/usr/bin/env bash
#
# deploy/aws/deploy-infra -- deploy the strimserver durable CloudFormation stack
# as the project-scoped operator identity.
#
# RUN MODEL
#   Once, with an AWS administrator's ambient credentials:
#     deploy/aws/provision-account
#   It creates the account-global operator stack (IAM user, operator policy,
#   instance role/profile, permissions boundary and Image Builder roles) and
#   the operator access key. Afterwards every operation -- this script (which
#   deploys the REGIONAL infra template) and the launch tooling -- runs as that
#   profile. deploy-infra NO LONGER uses admin credentials and NEVER rotates an
#   access key (that lives in provision-account).
#
# PARAMETER PHILOSOPHY (movienight item 205)
#   The template's Default is authoritative. This script passes ONLY the
#   parameters the operator explicitly set (via environment overrides) plus the
#   ProjectName constant:
#     OPERATOR_CIDR            -> OperatorCidr + IngestCidr
#     S3_BUCKET_NAME           -> DeploymentBucketName
#     VPC_ID                   -> VpcId (existing-VPC deployment mode)
#     NVIDIA_DRIVER_FLOOR      -> NvidiaDriverFloor (must match lib/nvidia.sh)
#     CREATE_NETWORK           -> CreateNetwork
#     ENABLE_EXPERIMENTAL_SSH  -> EnableExperimentalSsh
#   Everything else is omitted, so CloudFormation keeps the template Default (or,
#   on an update, the CLI's previous-value handling). There is NO
#   describe-stacks live-parameter read / re-pass machinery: it would make the
#   template Defaults meaningless and silently pin stale values.
#
# FIRST-CREATE GUARDS
#   * OPERATOR_CIDR has no template Default (SSH/controller ingress must be
#     explicit), so it is required on first create.
#   * The template defaults CreateNetwork=false and its rule requires a VpcId in
#     that mode. We mirror that rule client-side and fail BEFORE calling AWS, so
#     a bad first create can never leave a ROLLBACK_COMPLETE stack: set
#     CREATE_NETWORK=true to have the stack create a VPC, or export VPC_ID=<vpc>.
#
# STACK == PROJECT
#   The operator policy scopes its CloudFormation stack and IAM ARNs to
#   ${ProjectName}. The infra stack is named after the project, so a mismatched
#   --stack-name would be denied authorization; it is rejected up front.
#
# DEPLOY TIMEOUT
#   `cloudformation deploy` runs under a bounded `timeout` (CFN_DEPLOY_TIMEOUT,
#   default 900s) so a hung stack operation fails loud instead of blocking.
#
# POST-DEPLOY CONTRACT
#   * Stack status must be CREATE_COMPLETE or UPDATE_COMPLETE.
#   * The live NvidiaDriverFloor parameter must equal NVIDIA_DRIVER_FLOOR from
#     deploy/aws/lib/nvidia.sh. A floor bump that updates the library but not the
#     stack (or a hand-edited parameter) fails loud here.
#   * The BakedImagePipeline must exist, so a rebuild can be triggered.
#
# Usage:
#   deploy/aws/deploy-infra [--stack-name S] [--region R] [--profile P]
#
# License: proprietary (see LICENSE). All rights reserved.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE="${SCRIPT_DIR}/strimserver-infra.yaml"

# NVIDIA_DRIVER_FLOOR is the canonical version-floor contract. Capture an
# explicit env override before sourcing the library (which assigns the floor),
# then always compare the deployed value against the library's floor.
NVIDIA_DRIVER_FLOOR_OVERRIDE="${NVIDIA_DRIVER_FLOOR:-}"
# shellcheck source=lib/nvidia.sh
source "${SCRIPT_DIR}/lib/nvidia.sh"
EXPECTED_FLOOR="$NVIDIA_DRIVER_FLOOR"

PROJECT_NAME="${PROJECT_NAME:-strimserver}"
STACK_NAME="${CFN_STACK_NAME:-strimserver}"
REGION="${AWS_REGION:-${AWS_DEFAULT_REGION:-us-east-2}}"
PROFILE="${AWS_PROFILE:-strimserver}"
OPERATOR_CIDR="${OPERATOR_CIDR:-}"
S3_BUCKET_NAME="${S3_BUCKET_NAME:-}"
VPC_ID="${VPC_ID:-}"
# Explicit overlays are honored only when set; otherwise the template Default
# (or, on update, the CLI's previous value) applies.
CREATE_NETWORK="${CREATE_NETWORK-}"
ENABLE_EXPERIMENTAL_SSH="${ENABLE_EXPERIMENTAL_SSH-}"
# Bounded deploy time; override only for unusually large stack operations.
CFN_DEPLOY_TIMEOUT="${CFN_DEPLOY_TIMEOUT:-900}"
PIPELINE_NAME="${PROJECT_NAME}-baked"

log() { printf 'deploy-infra: %s\n' "$*" >&2; }
die() { printf 'deploy-infra: ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: deploy/aws/deploy-infra [options]

Deploys the strimserver stack as the operator service account. Run
deploy/aws/provision-account once (with admin credentials) first.

The template Defaults are authoritative: this script passes ONLY the parameters
you explicitly set through the environment (below) plus ProjectName. Unset
parameters are omitted, not re-passed from the live stack.

Options:
  --stack-name S   CloudFormation stack name (default: strimserver; MUST equal
                   the project name)
  --region R       AWS region (default: us-east-2)
  --profile P      AWS profile (default: $AWS_PROFILE, else strimserver)
  -h, --help       show this help

Environment overrides (all optional except OPERATOR_CIDR on first create):
  OPERATOR_CIDR            CIDR for SSH/controller ingress (also sets IngestCidr)
  S3_BUCKET_NAME           deployment bucket name (DeploymentBucketName)
  VPC_ID                   existing VPC id (VpcId; CreateNetwork=false mode)
  NVIDIA_DRIVER_FLOOR      must match deploy/aws/lib/nvidia.sh
  CREATE_NETWORK           true to create a dedicated VPC
  ENABLE_EXPERIMENTAL_SSH  true to open the experimental OpenSSH port

First create requires a usable network: either set CREATE_NETWORK=true (the
stack creates a VPC) or export VPC_ID=<existing vpc>. This is checked before
the deploy call, so an invalid first create cannot leave a ROLLBACK_COMPLETE
stack.
EOF
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "'$1' not found on PATH"
}

parse_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --stack-name)
        [ "$#" -ge 2 ] && [ -n "$2" ] || die "--stack-name requires a value"
        STACK_NAME="$2"; shift 2 ;;
      --stack-name=*)
        STACK_NAME="${1#*=}"; [ -n "$STACK_NAME" ] || die "--stack-name requires a value"; shift ;;
      --region)
        [ "$#" -ge 2 ] && [ -n "$2" ] || die "--region requires a value"
        REGION="$2"; shift 2 ;;
      --region=*)
        REGION="${1#*=}"; [ -n "$REGION" ] || die "--region requires a value"; shift ;;
      --profile)
        [ "$#" -ge 2 ] && [ -n "$2" ] || die "--profile requires a value"
        PROFILE="$2"; shift 2 ;;
      --profile=*)
        PROFILE="${1#*=}"; [ -n "$PROFILE" ] || die "--profile requires a value"; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown argument: $1 (try --help)" ;;
    esac
  done
}

aws_run() {
  aws --profile "$PROFILE" --region "$REGION" "$@"
}

# require_project_stack_match: the operator policy scopes its CloudFormation
# stack and IAM ARNs to ${ProjectName}. The infra stack, its IAM role and its
# instance profile are all named after the project, so the stack name MUST equal
# the project name or the operator would be denied on its own stack.
require_project_stack_match() {
  [ "$STACK_NAME" = "$PROJECT_NAME" ] \
    || die "--stack-name '${STACK_NAME}' must equal the project name '${PROJECT_NAME}': the operator policy scopes its CloudFormation stack and IAM ARNs to the project name, so a differing stack name would be denied authorization"
}

require_strimserver_identity() {
  local arn
  arn="$(aws_run sts get-caller-identity --query 'Arn' --output text)" \
    || die "not authenticated for profile '$PROFILE'; run deploy/aws/provision-account first"
  case "$arn" in
    *:user/"${PROJECT_NAME}") log "operator identity: ${arn}" ;;
    *) die "profile '$PROFILE' authenticated as '$arn', expected ...:user/${PROJECT_NAME}. Run deploy/aws/provision-account (with admin credentials) first." ;;
  esac
}

stack_exists() {
  aws_run cloudformation describe-stacks --stack-name "$STACK_NAME" >/dev/null 2>&1
}

# describe_parameters: one `Key<TAB>Value` line per live parameter. Used ONLY by
# the post-deploy verification; it never feeds the deploy line.
describe_parameters() {
  aws_run cloudformation describe-stacks \
    --stack-name "$STACK_NAME" \
    --query 'Stacks[0].Parameters[].[ParameterKey,ParameterValue]' \
    --output text 2>/dev/null
}

validate_bool() { # validate_bool <name> <value>
  case "$2" in
    true|false) ;;
    *) die "$1 must be 'true' or 'false' (got '$2')" ;;
  esac
}

# build_parameters: sets PARAM_ARGS to the explicit-only --parameter-overrides.
# Nothing is read from the live stack: unset inputs are omitted so the template
# Default remains authoritative (movienight item 205).
build_parameters() {
  PARAM_ARGS=("ProjectName=${PROJECT_NAME}")

  if [ -n "$OPERATOR_CIDR" ]; then
    PARAM_ARGS+=("OperatorCidr=${OPERATOR_CIDR}" "IngestCidr=${OPERATOR_CIDR}")
  fi
  if [ -n "$S3_BUCKET_NAME" ]; then
    PARAM_ARGS+=("DeploymentBucketName=${S3_BUCKET_NAME}")
  fi
  if [ -n "$VPC_ID" ]; then
    PARAM_ARGS+=("VpcId=${VPC_ID}")
  fi
  if [ -n "$NVIDIA_DRIVER_FLOOR_OVERRIDE" ]; then
    PARAM_ARGS+=("NvidiaDriverFloor=${NVIDIA_DRIVER_FLOOR_OVERRIDE}")
  fi
  if [ -n "$CREATE_NETWORK" ]; then
    validate_bool CREATE_NETWORK "$CREATE_NETWORK"
    PARAM_ARGS+=("CreateNetwork=${CREATE_NETWORK}")
  fi
  if [ -n "$ENABLE_EXPERIMENTAL_SSH" ]; then
    validate_bool ENABLE_EXPERIMENTAL_SSH "$ENABLE_EXPERIMENTAL_SSH"
    PARAM_ARGS+=("EnableExperimentalSsh=${ENABLE_EXPERIMENTAL_SSH}")
  fi
}

# first_create_guards: fail BEFORE calling AWS when the first create cannot
# succeed. OPERATOR_CIDR has no template Default and the template's rule needs a
# VpcId when CreateNetwork=false; mirroring both here avoids a
# ROLLBACK_COMPLETE stack.
first_create_guards() {
  stack_exists && return 0

  [ -n "$OPERATOR_CIDR" ] \
    || die "OPERATOR_CIDR is required on first create (it becomes OperatorCidr and IngestCidr)"
  [ "${CREATE_NETWORK:-false}" = "true" ] || [ -n "$VPC_ID" ] \
    || die "CreateNetwork=false requires a VpcId on first create. Set CREATE_NETWORK=true to have the stack create a VPC, or export VPC_ID=<existing vpc>."
}

deploy_stack() {
  log "deploying stack '${STACK_NAME}' in ${REGION} as profile '${PROFILE}'"
  local rc=0
  timeout "$CFN_DEPLOY_TIMEOUT" \
    aws --profile "$PROFILE" --region "$REGION" cloudformation deploy \
    --template-file "$TEMPLATE" \
    --stack-name "$STACK_NAME" \
    --capabilities CAPABILITY_NAMED_IAM \
    --parameter-overrides "${PARAM_ARGS[@]}" \
    || rc=$?
  if [ "$rc" -eq 124 ]; then
    die "cloudformation deploy for stack '${STACK_NAME}' timed out after ${CFN_DEPLOY_TIMEOUT}s"
  fi
  [ "$rc" -eq 0 ] || die "cloudformation deploy failed for stack '${STACK_NAME}' (exit ${rc})"
}

verify_stack_status() {
  local status
  status="$(aws_run cloudformation describe-stacks \
    --stack-name "$STACK_NAME" \
    --query 'Stacks[0].StackStatus' --output text)" \
    || die "could not read the stack status for '${STACK_NAME}'"
  case "$status" in
    CREATE_COMPLETE|UPDATE_COMPLETE) log "stack status: ${status}" ;;
    *) die "stack '${STACK_NAME}' is in status '${status}', expected CREATE_COMPLETE or UPDATE_COMPLETE" ;;
  esac
}

verify_nvidia_floor() {
  local live_floor
  live_floor="$(describe_parameters \
    | awk -F'\t' '$1 == "NvidiaDriverFloor" { print $2 }')" \
    || die "could not read the live NvidiaDriverFloor parameter"
  [ -n "$live_floor" ] \
    || die "stack '${STACK_NAME}' has no NvidiaDriverFloor parameter; the version-floor contract is missing"
  [ "$live_floor" = "$EXPECTED_FLOOR" ] \
    || die "NvidiaDriverFloor drift: stack reports '${live_floor}' but deploy/aws/lib/nvidia.sh pins '${EXPECTED_FLOOR}'. Update lib/nvidia.sh and the stack together."
  log "NvidiaDriverFloor matches lib/nvidia.sh (${EXPECTED_FLOOR})"
}

verify_image_pipeline() {
  local pipelines
  pipelines="$(aws_run imagebuilder list-image-pipelines \
    --query 'imagePipelineList[].name' --output text)" \
    || die "could not list Image Builder pipelines"
  grep -qw "$PIPELINE_NAME" <<<"$pipelines" \
    || die "Image Builder pipeline '${PIPELINE_NAME}' (BakedImagePipeline) not found; the stack did not create the baked-AMI pipeline"
  log "Image Builder pipeline present: ${PIPELINE_NAME}"
}

main() {
  parse_args "$@"
  require_cmd aws
  require_project_stack_match
  require_strimserver_identity
  build_parameters
  first_create_guards
  deploy_stack
  verify_stack_status
  verify_nvidia_floor
  verify_image_pipeline
  log "done. Stack '${STACK_NAME}' is updated as the [${PROFILE}] service account."
}

main "$@"
