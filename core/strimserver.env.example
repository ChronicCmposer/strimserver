
# --- Controller ---
# containerd gRPC socket the controller drives
CONTAINERD_SOCKET="/containerd.sock"
CONTAINERD_NAMESPACE="strimserver"
# must match the Stream Deck plugin's base URL port
CONTROLLER_HTTP_PORT="4000"
# host dir where deploy.sh stages config/bin/video-files
STRIMSERVER_HOST_ROOT="/mnt/nvme"
# how often the reconcile ticker fires (Go duration)
CONTROLLER_RECONCILE_INTERVAL="5s"
# per-op timeout; after this an in-flight stage op is re-issued
CONTROLLER_INFLIGHT_TIMEOUT="30s"
# graceful HTTP shutdown budget
CONTROLLER_SHUTDOWN_TIMEOUT="30s"
# grace period after SIGTERM before a task is force-killed
STAGE_STOP_TIMEOUT="10s"
# per-message write deadline on /subscribe
WEBSOCKET_WRITE_TIMEOUT="5s"
# buffered capacity of the actions channel (0-255)
CONTROLLER_ACTIONS_BUFFER_SIZE="16"

# --- Stage containers ---
MEDIAMTX_CONTAINER_ID="mediamtx"
MEDIAMTX_SNAPSHOT_ID="mediamtx-snapshot"
MEDIAMTX_IMAGE_NAME="docker.io/library/mediamtx:latest"
MEDIAMTX_LOG_FILE="/mnt/nvme/logs/mediamtx.log"
NORMALIZE_CONTAINER_ID="normalize"
NORMALIZE_SNAPSHOT_ID="normalize-snapshot"
NORMALIZE_LOG_FILE="/mnt/nvme/logs/normalize.log"
EGRESS_CONTAINER_ID="scale-and-egress"
EGRESS_SNAPSHOT_ID="scale-and-egress-snapshot"
EGRESS_LOG_FILE="/mnt/nvme/logs/scale-and-egress.log"
# shared by the normalize and scale_and_egress stages
FFMPEG_IMAGE_NAME="docker.io/library/ffmpeg:latest"

# --- Media / ffmpeg ---
# nice(1) level for the ffmpeg stages
FFMPEG_NICE="-5"
FFMPEG_LOG_LEVEL="info"
MEDIAMTX_NICE="-10"
# in-container path of the bind-mounted template (envsubst input)
MEDIAMTX_CONFIG_TEMPLATE="/mediamtx.yaml.template"
# SRT ingest port; must match the local encoder
STRIMSERVER_SRT_PORT="9000"
# internal RTSP port the stages read from
STRIMSERVER_RTSP_PORT="8554"
# unix socket: mediamtx listens, normalize ffmpeg connects
NORMALIZED_MPEGTS_SOCKET="/tmp/strimserver-normalized.sock"
# >= SRT latency + jitter + read gap
MEDIAMTX_READ_TIMEOUT_DURATION="12s"
NORMALIZED_VIDEO_BITRATE="9000k"
NORMALIZED_VIDEO_MAXRATE="9000k"
NORMALIZED_VIDEO_MINRATE="9000k"
NORMALIZED_VIDEO_BUFSIZE="9000k"
NORMALIZED_AUDIO_BITRATE="320k"
# egress output height; width is derived (-2)
SCALED_VIDEO_HEIGHT_PIXELS="936"
EGRESS_VIDEO_BITRATE="2500k"
EGRESS_VIDEO_MAXRATE="2500k"
EGRESS_VIDEO_MINRATE="2500k"
EGRESS_VIDEO_BUFSIZE="2500k"
EGRESS_AUDIO_BITRATE="160k"

# --- Twitch / egress ---
TWITCH_INGEST_SERVER="ingest.global-contribute.live-video.net"
# secret; leave EMPTY in bundled builds - injected at deploy time by deploy.sh
TWITCH_STREAM_KEY=""
# true appends ?bandwidthtest=true to the RTMP URL
BANDWIDTH_TEST="false"

# --- Secrets ---
# optional; falls back to /run/secrets/srt-passphrase if unset
SRT_PUBLISH_PASSPHRASE=""
