# Phase 5: the assembly playbook checkers (check-isa.sh / check-clobbers.sh)
# wired as Bazel sh_test targets so the AGENTS.md gates ("both checkers
# green" at Gate 1 and Gate 3) are CI-able. They run natively on arm64
# targets (this repo's aarch64 dev host); amd64 wildcard builds skip them as
# incompatible, exactly like the controller_asm cc_binary they guard.
#
# The scripts themselves are committed untouched; a thin wrapper
# (asm_checker_test.sh) derives the -I include dir from the first module's
# runfiles path because Bazel's args expansion cannot compute dirname.
#
# Every target in this package is tagged `manual`: the alternate assembly
# controller (AArch64 + x86_64) is built only on explicit request, never by
# `bazel build //...` / `bazel test //...` wildcards.

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The seven asm modules plus every header the preprocessing/assembly passes
# include (cc_platform.h/cc_layout.inc + the six module headers). Each file
# is a DIRECT data prerequisite so $(rootpath ...) can expand it in args
# (Bazel does not expand location expressions through a filegroup).
ASM_MODULES = [
    "cc_util.S",
    "cc_env.S",
    "cc_json.S",
    "cc_ctr.S",
    "cc_state.S",
    "cc_http.S",
    "cc_main.S",
]

ASM_HEADERS = [
    "cc_platform.h",
    "cc_layout.inc",
    "cc_env.h",
    "cc_json.h",
    "cc_ctr.h",
    "cc_state.h",
    "cc_http.h",
    "cc_main.h",
]

# These sources are referenced cross-package by external consumers (Bazel
# forbids raw-file references across packages without exports_files).  The
# aggregate controller_asm_lib below is same-package, so it needs no export;
# the exports stay for outside callers of the alternate asm build.
exports_files(ASM_MODULES + ASM_HEADERS)

# args shape: [<checker>, <modules...>]; the wrapper prepends -I <asm dir>
# derived from the first module's runfiles path.
sh_test(
    name = "check_isa_test",
    srcs = ["asm_checker_test.sh"],
    args = ["$(rootpath check-isa.sh)"] + ["$(rootpath :%s)" % m for m in ASM_MODULES],
    data = ["check-isa.sh"] + ASM_MODULES + ASM_HEADERS,
    target_compatible_with = ["@platforms//cpu:aarch64"],
    tags = ["manual"],
)

sh_test(
    name = "check_clobbers_test",
    srcs = ["asm_checker_test.sh"],
    args = ["$(rootpath check-clobbers.sh)"] + ["$(rootpath :%s)" % m for m in ASM_MODULES],
    data = ["check-clobbers.sh"] + ASM_MODULES + ASM_HEADERS,
    target_compatible_with = ["@platforms//cpu:aarch64"],
    tags = ["manual"],
)

# check-translation.sh scans the x86_64 modules for the mechanical AArch64 ->
# SysV translation-bug classes (scaled-index loads, ret-without-%rax, chained
# calls without %rax->%rdi re-threading) and the class-D RPC-sequence check
# (missing image/snapshot parent-chain), which ALSO reads the shared C layer
# (//core/controller/alternate/c:cc_ctr.c).  The AArch64 modules are detected
# and skipped (N/A, exit 0), so this test is green on arm64 while the same
# script drives the x86_64 suite's check_translation_x86_64_test below; the
# C-layer class-D candidates surface on both hosts (the bug lives in the
# shared C layer, independent of the port).
sh_test(
    name = "check_translation_test",
    srcs = ["asm_checker_test.sh"],
    args = ["$(rootpath check-translation.sh)"] + ["$(rootpath :%s)" % m for m in ASM_MODULES] + ["$(rootpath //core/controller/alternate/c:cc_ctr.c)"],
    data = ["check-translation.sh"] + ASM_MODULES + ASM_HEADERS + ["//core/controller/alternate/c:cc_ctr.c"],
    target_compatible_with = ["@platforms//cpu:aarch64"],
    tags = ["manual"],
)

test_suite(
    name = "phase5_checkers",
    tests = [
        ":check_isa_test",
        ":check_clobbers_test",
        ":check_translation_test",
    ],
    tags = ["manual"],
)

# =============================================================================
# Phase 5.2: the x86-64-v4 port (parallel tree under x86_64/).
#
# The AArch64 modules above are translated to GNU as AT&T syntax for the
# x86-64-v4 port (AVX2 cap — no zmm/k/AMX, no AVX-512 — SysV ABI, target
# g4dn.xlarge).  The x86 modules live in the x86_64/ subdirectory so the
# AArch64 checkers' `find -name 'cc_*.S'` glob never picks them up, and the
# AArch64 exports_files above are untouched.
#
# All seven modules have landed. The run-path differential is GREEN
# byte-for-byte vs the AArch64 reference on every function it exercises
# (env_fail_invalid/env_fail_missing, main_build_layout, http_is_null,
# http_badjson_lit, http_str_value; http_badjson_msg runs to completion with
# two documented out-of-contract classifier divergences — see the
# http_badjson_msg header in x86_64/cc_http.S — that intentionally match the
# AArch64 original to preserve x86<->AArch64 byte parity). All per-module
# cc_library targets AND the aggregate controller_asm_lib_x86_64 are live
# (hard rule 9 satisfied: every run-path module now passes Gate 3). The
# per-module checker sh_tests (one per module per checker) are generated from
# X86_64_LANDED_MODULES and stay fully active — gating the BUILD of a module
# must NOT disable its checker tests.
# =============================================================================

# The seven x86-64 modules.
X86_64_ASM_MODULES = [
    "x86_64/cc_util.S",
    "x86_64/cc_env.S",
    "x86_64/cc_json.S",
    "x86_64/cc_ctr.S",
    "x86_64/cc_state.S",
    "x86_64/cc_http.S",
    "x86_64/cc_main.S",
]

# cc_platform_x86_64.h (x86-specific) plus the shared headers the x86 modules
# include unchanged: cc_layout.inc (byte-identical on x86-64 — struct
# layouts and pointer widths match) and the six arch-neutral module-header
# CPP constants.  Note: cc_env.h still carries the AArch64 movz/movk
# MOV_DUR_MIN/MOV_DUR_HOUR macros; those now live in cc_platform_x86_64.h,
# so the cc_env.S translation must not redefine them.
X86_64_ASM_HEADERS = [
    "x86_64/cc_platform_x86_64.h",
    "cc_layout.inc",
    "cc_env.h",
    "cc_json.h",
    "cc_ctr.h",
    "cc_state.h",
    "cc_http.h",
    "cc_main.h",
]

exports_files(X86_64_ASM_MODULES + X86_64_ASM_HEADERS)

# ---------------------------------------------------------------------------
# Per-module compile targets — the Phase-3 parallelization enabler.  Each
# module is compiled independently (`bazel build //core/controller/alternate/asm:cc_X_x86_64`)
# so one agent's module never waits on (or breaks) another's.  The aggregate
# controller_asm_lib_x86_64 below is the all-seven link unit; per-module
# checker sh_tests join phase5_checkers_x86_64 when the x86 checker scripts
# land.
# ---------------------------------------------------------------------------
X86_64_ASM_COPTS = [
    "-Wall",
    "-Wextra",
    # ISA floor x86-64-v4 with the AVX-512 feature set the floor implies
    # explicitly disabled (the cap is AVX2 — no zmm/k/AMX, target
    # g4dn.xlarge). These MUST live on the asm compilation itself: x86 gas
    # accepts everything by default, so a floor/cap only on the C-only
    # cc_binary would leave the .S modules ungated. Shared by every
    # per-module cc_library and the aggregate so the gate cannot be missed.
    "-march=x86-64-v4",
    "-mno-avx512f",
    "-mno-avx512vl",
    "-mno-avx512bw",
    "-mno-avx512dq",
    "-mno-avx512cd",
]

cc_library(
    name = "cc_util_x86_64",
    srcs = ["x86_64/cc_util.S"],
    hdrs = X86_64_ASM_HEADERS,
    copts = X86_64_ASM_COPTS,
    target_compatible_with = ["@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
    tags = ["manual"],
)

cc_library(
    name = "cc_env_x86_64",
    srcs = ["x86_64/cc_env.S"],
    hdrs = X86_64_ASM_HEADERS,
    copts = X86_64_ASM_COPTS,
    target_compatible_with = ["@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
    tags = ["manual"],
)

cc_library(
    name = "cc_json_x86_64",
    srcs = ["x86_64/cc_json.S"],
    hdrs = X86_64_ASM_HEADERS,
    copts = X86_64_ASM_COPTS,
    target_compatible_with = ["@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
    tags = ["manual"],
)

cc_library(
    name = "cc_ctr_x86_64",
    srcs = ["x86_64/cc_ctr.S"],
    hdrs = X86_64_ASM_HEADERS,
    copts = X86_64_ASM_COPTS,
    target_compatible_with = ["@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
    tags = ["manual"],
)

cc_library(
    name = "cc_state_x86_64",
    srcs = ["x86_64/cc_state.S"],
    hdrs = X86_64_ASM_HEADERS,
    copts = X86_64_ASM_COPTS,
    target_compatible_with = ["@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
    tags = ["manual"],
)

cc_library(
    name = "cc_http_x86_64",
    srcs = ["x86_64/cc_http.S"],
    hdrs = X86_64_ASM_HEADERS,
    copts = X86_64_ASM_COPTS,
    target_compatible_with = ["@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
    tags = ["manual"],
)

cc_library(
    name = "cc_main_x86_64",
    srcs = ["x86_64/cc_main.S"],
    hdrs = X86_64_ASM_HEADERS,
    copts = X86_64_ASM_COPTS,
    target_compatible_with = ["@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
    tags = ["manual"],
)

# Aggregate asm-side library: all seven modules, mirroring the AArch64
# controller_asm_lib shape.  This is the link unit the controller_asm_x86_64
# binary below depends on (it moved here from //core/controller together with
# the binary).
cc_library(
    name = "controller_asm_lib_x86_64",
    srcs = X86_64_ASM_MODULES,
    hdrs = X86_64_ASM_HEADERS,
    copts = X86_64_ASM_COPTS,
    target_compatible_with = ["@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
    tags = ["manual"],
)

# The x86_64 checker suite.  check-clobbers-x86_64.sh and check-isa-x86_64.sh
# have both landed; each module gets its own per-module sh_test so a module
# is checked independently in parallel (the Phase-3 enabler).
#
# NOTE: check-isa-x86_64.sh assembles the module under -march=x86-64-v4 with
# the host `cc`, so it needs an x86_64 toolchain — it passes natively in CI
# (amd64) and on amd64 dev hosts, and is skipped on arm64 platforms via
# target_compatible_with.  On an aarch64 dev host it reports the host cc's
# "unknown value for -march" (an environment limitation, not a module
# finding); the clobber test runs anywhere.
X86_64_LANDED_MODULES = [
    "x86_64/cc_util.S",
    "x86_64/cc_env.S",
    "x86_64/cc_json.S",
    "x86_64/cc_ctr.S",
    "x86_64/cc_state.S",
    "x86_64/cc_http.S",
    "x86_64/cc_main.S",
]

[
    sh_test(
        name = "check_isa_%s_x86_64_test" % name,
        srcs = ["asm_checker_test.sh"],
        args = [
            "$(rootpath check-isa-x86_64.sh)",
            "$(rootpath :%s)" % path,
        ],
        data = ["check-isa-x86_64.sh", path] + X86_64_ASM_HEADERS,
        target_compatible_with = ["@platforms//cpu:x86_64"],
        tags = ["manual"],
    )
    for name, path in [
        ("cc_util", "x86_64/cc_util.S"),
        ("cc_env", "x86_64/cc_env.S"),
        ("cc_json", "x86_64/cc_json.S"),
        ("cc_ctr", "x86_64/cc_ctr.S"),
        ("cc_state", "x86_64/cc_state.S"),
        ("cc_http", "x86_64/cc_http.S"),
        ("cc_main", "x86_64/cc_main.S"),
    ]
    if path in X86_64_LANDED_MODULES
]

[
    sh_test(
        name = "check_clobbers_%s_x86_64_test" % name,
        srcs = ["asm_checker_test.sh"],
        args = [
            "$(rootpath check-clobbers-x86_64.sh)",
            "$(rootpath :%s)" % path,
        ],
        data = ["check-clobbers-x86_64.sh", path] + X86_64_ASM_HEADERS,
        target_compatible_with = ["@platforms//cpu:x86_64"],
        tags = ["manual"],
    )
    for name, path in [
        ("cc_util", "x86_64/cc_util.S"),
        ("cc_env", "x86_64/cc_env.S"),
        ("cc_json", "x86_64/cc_json.S"),
        ("cc_ctr", "x86_64/cc_ctr.S"),
        ("cc_state", "x86_64/cc_state.S"),
        ("cc_http", "x86_64/cc_http.S"),
        ("cc_main", "x86_64/cc_main.S"),
    ]
    if path in X86_64_LANDED_MODULES
]

# The translation-bug scanner: one sh_test over ALL seven x86_64 modules (the
# per-module checker tests above guard ISA/clobbers; this one guards the
# AArch64 -> SysV translation classes) PLUS the shared C layer for the class-D
# RPC-sequence check (missing image/snapshot parent-chain).  It is source-only
# (no assembler), so it runs on amd64 hosts in CI and on amd64/aarch64 dev
# hosts alike; the target_compatible_with keeps it out of the aarch64-only
# wildcard builds that skip the x86_64 checker suite (the arm64 suite runs the
# same script via check_translation_test above, where the AArch64 modules are
# skipped).
sh_test(
    name = "check_translation_x86_64_test",
    srcs = ["asm_checker_test.sh"],
    args = ["$(rootpath check-translation.sh)"] + ["$(rootpath :%s)" % p for p in X86_64_ASM_MODULES] + ["$(rootpath //core/controller/alternate/c:cc_ctr.c)"],
    data = ["check-translation.sh"] + X86_64_ASM_MODULES + X86_64_ASM_HEADERS + ["//core/controller/alternate/c:cc_ctr.c"],
    target_compatible_with = ["@platforms//cpu:x86_64"],
    tags = ["manual"],
)

test_suite(
    name = "phase5_checkers_x86_64",
    tests = [
        "check_%s_%s_x86_64_test" % (checker, name)
        for checker in ("isa", "clobbers")
        for name, path in [
            ("cc_util", "x86_64/cc_util.S"),
            ("cc_env", "x86_64/cc_env.S"),
            ("cc_json", "x86_64/cc_json.S"),
            ("cc_ctr", "x86_64/cc_ctr.S"),
            ("cc_state", "x86_64/cc_state.S"),
            ("cc_http", "x86_64/cc_http.S"),
            ("cc_main", "x86_64/cc_main.S"),
        ]
        if path in X86_64_LANDED_MODULES
    ] + [
        "check_translation_x86_64_test",
    ],
    tags = ["manual"],
)

# =============================================================================
# Phase 4.8 / 5.2: the aggregate libraries and binaries.
#
# controller_asm_lib + controller_asm (AArch64) and controller_asm_x86_64
# (x86-64-v4) moved here from //core/controller together with the asm
# sources; the x86 aggregate controller_asm_lib_x86_64 already lived in this
# package (it is the link unit the x86 binary depends on).  All are tagged
# manual: the alternate assembly controller is built only on explicit
# request, never by `bazel build //...` wildcards.
#
# -Werror policy: the C files are proven clean under -Wall -Wextra -Werror,
# so the cc_binary keeps it. The .S files are compiled by the toolchain's
# assembler-with-cpp and assembler warnings are toolchain-sensitive (a
# different host gcc could emit one), so -Werror stays OFF the asm
# cc_library; -Wall -Wextra still surfaces anything, and the real asm gates
# are check-isa.sh / check-clobbers.sh.
# =============================================================================

# AArch64 aggregate: all seven asm modules as one library (the link unit
# controller_asm depends on).  The srcs/hdrs are the same-package source
# files exported above.
cc_library(
    name = "controller_asm_lib",
    srcs = [
        "//core/controller/alternate/asm:cc_util.S",
        "//core/controller/alternate/asm:cc_env.S",
        "//core/controller/alternate/asm:cc_json.S",
        "//core/controller/alternate/asm:cc_ctr.S",
        "//core/controller/alternate/asm:cc_state.S",
        "//core/controller/alternate/asm:cc_http.S",
        "//core/controller/alternate/asm:cc_main.S",
    ],
    hdrs = [
        "//core/controller/alternate/asm:cc_platform.h",
        "//core/controller/alternate/asm:cc_layout.inc",
        "//core/controller/alternate/asm:cc_env.h",
        "//core/controller/alternate/asm:cc_json.h",
        "//core/controller/alternate/asm:cc_ctr.h",
        "//core/controller/alternate/asm:cc_state.h",
        "//core/controller/alternate/asm:cc_http.h",
        "//core/controller/alternate/asm:cc_main.h",
    ],
    copts = [
        "-Wall",
        "-Wextra",
    ],
    target_compatible_with = ["@platforms//cpu:aarch64"],
    visibility = ["//visibility:public"],
    tags = ["manual"],
)

# AArch64 binary: the seven asm modules plus the vendored C protocol layer
# (cc_grpc/cc_ctr/cc_http). cc_main.S exports `main` as a one-instruction
# tail call to cc_main_entry, so the standard crt0 entry works unchanged.
# Cross-language linkage is plain extern symbols; no registration is needed.
#
# core/controller/alternate/c is its own Bazel package, so its sources are
# referenced by label. cc_binary has no hdrs attribute; the C headers and
# the Huffman include are declared in srcs as non-compiled inputs
# (same-dir quote includes resolve regardless, this just makes the
# dependency explicit).
cc_binary(
    name = "controller_asm",
    srcs = [
        "//core/controller/alternate/c:cc_grpc.c",
        "//core/controller/alternate/c:cc_ctr.c",
        "//core/controller/alternate/c:cc_http.c",
        "//core/controller/alternate/c:cc_grpc.h",
        "//core/controller/alternate/c:cc_ctr.h",
        "//core/controller/alternate/c:cc_http.h",
        "//core/controller/alternate/c:cc_grpc_huff.inc",
    ],
    copts = [
        "-std=gnu11",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    # Static link: the controller image is FROM scratch and ships a
    # statically-linked Go controller, so the asm controller must also need
    # no loader/libs at runtime (avoids the known arm64 loader-basename gap).
    # The host toolchain has libc.a/libm.a/libpthread.a/libdl.a (glibc static
    # archives), so -static links clean; ldd reports "not a dynamic
    # executable".
    linkopts = [
        "-lm",
        "-ldl",
        "-lpthread",
        "-static",
    ],
    target_compatible_with = ["@platforms//cpu:aarch64"],
    visibility = ["//visibility:public"],
    tags = ["manual"],
    deps = [
        ":controller_asm_lib",
        "//third_party/protobuf-c:runtime",
        "//third_party/containerd-api:codecs",
        "//third_party/libwebsockets:libwebsockets",
    ],
)

# =============================================================================
# Phase 5.2: controller_asm_x86_64 — the x86-64-v4 assembly controller binary.
#
# Mirror of controller_asm (Phase 4.8) for the x86-64-v4 port
# (x86_64/ subtree above): the same seven-module shape, the same vendored C
# protocol layer, the same third_party deps.  ISA floor x86-64-v4 with the
# AVX-512 features the floor would otherwise imply explicitly disabled (the
# cap is AVX2 — no zmm/k/AMX — target g4dn.xlarge), SysV ABI.  The C
# protocol layer (core/controller/alternate/c) is arch-neutral; the
# third_party C deps are already dual-arch (amd64 has no compatibility
# constraint).
#
# -Werror policy mirrors the AArch64 controller_asm: -Werror stays ON the C
# files (proven clean under -Wall -Wextra -Werror) and OFF the .S files
# (assembler warnings are toolchain-sensitive; the real asm gates are
# check-isa-x86_64.sh / check-clobbers-x86_64.sh).
#
# All seven x86_64 modules have landed and the run-path differential is GREEN
# byte-for-byte vs the AArch64 reference on every function it exercises
# (env_fail_invalid/env_fail_missing, main_build_layout, http_is_null,
# http_badjson_lit, http_str_value; http_badjson_msg runs to completion with
# two documented out-of-contract classifier divergences that intentionally
# match the AArch64 original — see the http_badjson_msg header in
# x86_64/cc_http.S).  Gate 3 is satisfied for the run-path modules.  The
# per-module checker tests in phase5_checkers_x86_64 remain fully active.
# controller_asm_x86_64 is the amd64 target of the differential harness
# (differential.sh); the arm64 image keeps shipping the AArch64 asm
# controller.
# =============================================================================

cc_binary(
    name = "controller_asm_x86_64",
    srcs = [
        "//core/controller/alternate/c:cc_grpc.c",
        "//core/controller/alternate/c:cc_ctr.c",
        "//core/controller/alternate/c:cc_http.c",
        "//core/controller/alternate/c:cc_grpc.h",
        "//core/controller/alternate/c:cc_ctr.h",
        "//core/controller/alternate/c:cc_http.h",
        "//core/controller/alternate/c:cc_grpc_huff.inc",
    ],
    # C-only copts: srcs are just the C protocol layer (arch-neutral). The ISA
    # floor/cap (-march=x86-64-v4 -mno-avx512*) lives on the asm compilation
    # itself — controller_asm_lib_x86_64 above, which compiles the .S modules.
    copts = [
        "-std=gnu11",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    # Static link: same rationale as controller_asm — the controller image
    # is FROM scratch, so the binary needs no loader/libs at runtime.
    linkopts = [
        "-lm",
        "-ldl",
        "-lpthread",
        "-static",
    ],
    target_compatible_with = ["@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
    tags = ["manual"],
    deps = [
        ":controller_asm_lib_x86_64",
        "//third_party/protobuf-c:runtime",
        "//third_party/containerd-api:codecs",
        "//third_party/libwebsockets:libwebsockets",
    ],
)