# Phase 3b: hand-written h2c/gRPC client for containerd (the C protocol
# layer the assembly controller drives).
#
# cc_grpc is a single .c/.h pair plus the Huffman table include, linked
# against //third_party/containerd-api:codecs and nothing else — a pure
# protocol layer (HTTP/2 prior-knowledge + gRPC over a unix socket, HPACK,
# flow control). The whole C layer here is genuinely portable C (byte-shift
# wire encoding, no intrinsics, no inline asm), so it builds for both
# linux_amd64 and linux_arm64: the target_compatible_with select names both
# arches explicitly (amd64: no constraint; arm64: aarch64) and keeps any
# third platform arm64-only, matching the pre-amd64-port behavior.
#
# Targets:
#   //core/controller/alternate/c:cc_grpc          the client library
#   //core/controller/alternate/c:cc_grpc_test     standalone test executable: HPACK /
#                                                  HTTP2 self-tests always; the live
#                                                  containerd block (Version, List,
#                                                  Subscribe) runs only when a daemon
#                                                  socket is reachable, else SKIPPED.

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# The translation checker (//core/controller/alternate/asm:check-translation.sh, class D
# RPC-sequence scan) reads cc_ctr.c source directly, so the raw file must be
# referenceable cross-package from the alternate/asm package's sh_test data/args.
exports_files(["cc_ctr.c"])

cc_library(
    name = "cc_grpc",
    tags = ["manual"],
    srcs = [
        "cc_grpc.c",
        "cc_grpc_huff.inc",
    ],
    hdrs = ["cc_grpc.h"],
    copts = [
        "-std=gnu11",
        "-Wall",
        "-Wextra",
    ],
    target_compatible_with = select({
        "//tools/bazel:is_amd64_target": [],
        "//tools/bazel:is_arm64_target": ["@platforms//cpu:aarch64"],
        "//conditions:default": ["@platforms//cpu:aarch64"],
    }),
    deps = ["//third_party/containerd-api:codecs"],
)

cc_test(
    name = "cc_grpc_test",
    tags = ["manual"],
    srcs = ["cc_grpc_test.c"],
    copts = [
        "-std=gnu11",
        "-Wall",
        "-Wextra",
    ],
    target_compatible_with = select({
        "//tools/bazel:is_amd64_target": [],
        "//tools/bazel:is_arm64_target": ["@platforms//cpu:aarch64"],
        "//conditions:default": ["@platforms//cpu:aarch64"],
    }),
    deps = [":cc_grpc"],
)

# ---------------------------------------------------------------------------
# Phase 4.4a: cc_ctr — the containerd operation layer (protocol/encoding half
# of the cc_ctr module; the cc_ctr.S assembly orchestration calls these).
# ---------------------------------------------------------------------------
cc_library(
    name = "cc_ctr",
    tags = ["manual"],
    srcs = ["cc_ctr.c"],
    hdrs = ["cc_ctr.h"],
    copts = [
        "-std=gnu11",
        "-Wall",
        "-Wextra",
    ],
    target_compatible_with = select({
        "//tools/bazel:is_amd64_target": [],
        "//tools/bazel:is_arm64_target": ["@platforms//cpu:aarch64"],
        "//conditions:default": ["@platforms//cpu:aarch64"],
    }),
    deps = [
        ":cc_grpc",
        "//third_party/containerd-api:codecs",
    ],
)

cc_test(
    name = "cc_ctr_test",
    tags = ["manual"],
    srcs = ["cc_ctr_test.c"],
    copts = [
        "-std=gnu11",
        "-Wall",
        "-Wextra",
    ],
    target_compatible_with = select({
        "//tools/bazel:is_amd64_target": [],
        "//tools/bazel:is_arm64_target": ["@platforms//cpu:aarch64"],
        "//conditions:default": ["@platforms//cpu:aarch64"],
    }),
    deps = [":cc_ctr"],
)

# ---------------------------------------------------------------------------
# Phase 4.6: cc_http — the HTTP/1.1 + websocket serving layer (thin C wrapper
# over the vendored libwebsockets v5.0.0 server-only static lib; the asm
# module core/controller/alternate/asm/cc_http.S owns the wire logic and is linked into
# the cc_binary at 4.8). The static lib requires -lm -ldl -lpthread.
# ---------------------------------------------------------------------------
cc_library(
    name = "cc_http",
    tags = ["manual"],
    srcs = ["cc_http.c"],
    hdrs = ["cc_http.h"],
    copts = [
        "-std=gnu11",
        "-Wall",
        "-Wextra",
    ],
    linkopts = [
        "-lm",
        "-ldl",
        "-lpthread",
    ],
    target_compatible_with = select({
        "//tools/bazel:is_amd64_target": [],
        "//tools/bazel:is_arm64_target": ["@platforms//cpu:aarch64"],
        "//conditions:default": ["@platforms//cpu:aarch64"],
    }),
    deps = ["//third_party/libwebsockets:libwebsockets"],
)