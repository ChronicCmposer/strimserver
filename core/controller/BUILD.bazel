# gazelle:prefix strimserver-controller

load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//tools/bazel:deb_file.bzl", "deb_file")
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools/bazel:go_bin.bzl", "go_bin")

exports_files(["go.mod", "go.sum"])

go_library(
    name = "controller_lib",
    srcs = [
        "container_factory.go",
        "controller.go",
        "envspec.go",
        "main.go",
        "names.go",
        "paths.go",
    ],
    importpath = "strimserver-controller",
    visibility = ["//visibility:private"],
    deps = [
        "@com_github_coder_websocket//:websocket",
        "@com_github_coder_websocket//wsjson",
        "@com_github_containerd_containerd_api//events",
        "@com_github_containerd_containerd_v2//client",
        "@com_github_containerd_containerd_v2//core/events",
        "@com_github_containerd_containerd_v2//pkg/cdi",
        "@com_github_containerd_containerd_v2//pkg/cio",
        "@com_github_containerd_containerd_v2//pkg/namespaces",
        "@com_github_containerd_containerd_v2//pkg/oci",
        "@com_github_containerd_errdefs//:errdefs",
        "@com_github_containerd_typeurl_v2//:typeurl",
        "@com_github_opencontainers_runtime_spec//specs-go",
    ],
)

# Built as a pure-Go static linux binary: pure=on matches the old
# CGO_ENABLED=0 (verified: no `import "C"` and no os/user anywhere in this
# package); -trimpath is a rules_go default; the old -ldflags='-s -w' becomes
# gc_linkopts below. No explicit goos/goarch: rules_go derives both from the
# target platform, so an amd64 target produces a linux/amd64 binary and an
# arm64 target produces a linux/arm64 binary. (rules_go's go_binary macro
# rejects a select() in goarch, and goarch must be set if goos is set, so the
# derivation must be implicit.)
go_binary(
    name = "strimserver-controller",
    embed = [":controller_lib"],
    gc_linkopts = [
        "-s",
        "-w",
    ],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "controller_test",
    srcs = [
        "container_factory_test.go",
        "controller_test.go",
    ],
    embed = [":controller_lib"],
    # pure = "on" matches the binary: this package is pure Go (verified: no
    # import "C" and no os/user anywhere in this package), so the test links
    # statically instead of dragging in the host C toolchain/libgcc.
    pure = "on",
    deps = [
        "@com_github_containerd_containerd_v2//client",
        "@com_github_containerd_containerd_v2//core/content",
        "@com_github_containerd_containerd_v2//core/containers",
        "@com_github_containerd_containerd_v2//core/events",
        "@com_github_containerd_containerd_v2//core/snapshots",
        "@com_github_containerd_containerd_v2//pkg/oci",
        "@com_github_opencontainers_image_spec//specs-go/v1:specs-go",
        "@com_github_opencontainers_runtime_spec//specs-go",
    ],
)

# --- Codegen: strimserver.env.example + the Stream Deck wire types ----------
# Replaces `make generate` / `make check-generated` (Makefile:53-59). Unlike
# the make target, `generate_test` never writes to the source tree to check
# it, and it's wired into the default `bazel test //...` set.

genrule(
    name = "env_example_gen",
    outs = ["strimserver.env.example.gen"],
    cmd = "$(location :strimserver-controller) -print-env-example > $@",
    tools = [":strimserver-controller"],
    visibility = ["//core:__pkg__"],
)

genrule(
    name = "ts_types_gen",
    outs = ["types.generated.ts.gen"],
    cmd = "$(location :strimserver-controller) -print-ts-types > $@",
    tools = [":strimserver-controller"],
    visibility = ["//tools/streamdeck-plugin/src/client:__pkg__"],
)

# write_source_files requires each destination file to live in the same
# package as the target that writes it, so the actual writes are declared
# next to their destinations (//core:write_env_example and
# //tools/streamdeck-plugin/src/client:write_ts_types) and chained here.
write_source_files(
    name = "generate",
    additional_update_targets = [
        "//core:write_env_example",
        "//tools/streamdeck-plugin/src/client:write_ts_types",
    ],
)

test_suite(
    name = "generate_test",
    tests = [
        "//core:write_env_example_test",
        "//tools/streamdeck-plugin/src/client:write_ts_types_test",
    ],
)

# --- Lint --------------------------------------------------------------
# golangci-lint pinned as a downloaded, checksummed Bazel tool (see
# @golangci_lint_linux_amd64 / @golangci_lint_linux_arm64 in MODULE.bazel)
# instead of `go install`ed over the network on every lint-enabled build.
# The filegroup selects the tool matching the target platform; the lint test
# runs on the target platform via --use_target_platform_for_tests, so it gets
# the native tool on each architecture.

filegroup(
    name = "golangci_lint_tool",
    srcs = select({
        "//tools/bazel:is_amd64_target": ["@golangci_lint_linux_amd64//:golangci-lint"],
        "//tools/bazel:is_arm64_target": ["@golangci_lint_linux_arm64//:golangci-lint"],
    }),
)

go_bin(name = "go_bin")

sh_test(
    name = "lint",
    srcs = ["lint.sh"],
    args = [
        "$(location :golangci_lint_tool)",
        "$(location :go_bin)",
        "$(location :.golangci.yml)",
    ],
    data = [
        ":golangci_lint_tool",
        ":go_bin",
        ".golangci.yml",
        "container_factory.go",
        "container_factory_test.go",
        "controller.go",
        "controller_test.go",
        "envspec.go",
        "go.mod",
        "go.sum",
        "main.go",
        "names.go",
        "paths.go",
    ],
)

# =============================================================================
# controller image (FROM scratch). Assembled by rules_oci from the Go binary
# plus dash + libc6 donor packages from the @trixie apt snapshot.
# =============================================================================

deb_file(
    name = "dash_as_sh",
    data = "@trixie//dash:data",
    path = "usr/bin/dash",
    out = "sh",
)

deb_file(
    name = "controller_ld_linux",
    data = "@trixie//libc6:data",
    path = "usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2",
    path_arm64 = "usr/lib/aarch64-linux-gnu/ld-linux-aarch64.so.1",
)

deb_file(
    name = "controller_libc_so",
    data = "@trixie//libc6:data",
    path = "usr/lib/x86_64-linux-gnu/libc.so.6",
    path_arm64 = "usr/lib/aarch64-linux-gnu/libc.so.6",
)

pkg_files(
    name = "controller_bin_sh",
    srcs = [":dash_as_sh"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/bin",
)

# The aarch64 loader's ELF interpreter path is /lib/ld-linux-aarch64.so.1 (there
# is no /lib64 on aarch64; the amd64 loader lives at /lib64/ld-linux-x86-64.so.2,
# matching the amd64 bin/sh's interpreter). :controller_ld_linux keeps the amd64
# output basename on both arches (byte-identical amd64 image), so the loader is
# placed per-arch at the exact interpreter path the dash bin/sh requests:
#  - amd64: /lib64/ld-linux-x86-64.so.2 (via :controller_lib64, unchanged)
#  - arm64: /lib/ld-linux-aarch64.so.1 (via :controller_arm64_loader_interp,
#    added to the tar only on the is_arm64_target select branch, mirroring
#    //core:ffmpeg_arm64_loader_interp)
# :controller_lib64 is emptied on arm64 so the image does NOT ship the
# amd64-basename loader at /lib64/ld-linux-x86-64.so.2 carrying aarch64 content.
pkg_files(
    name = "controller_lib64",
    srcs = select({
        "//tools/bazel:is_amd64_target": [":controller_ld_linux"],
        "//tools/bazel:is_arm64_target": [],
    }),
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/lib64",
)

pkg_files(
    name = "controller_arm64_loader_interp",
    srcs = [":controller_ld_linux"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/lib",
    renames = {":controller_ld_linux": "ld-linux-aarch64.so.1"},
)

pkg_files(
    name = "controller_libs",
    srcs = [":controller_libc_so"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = select({
        "//tools/bazel:is_amd64_target": "/lib/x86_64-linux-gnu",
        "//tools/bazel:is_arm64_target": "/lib/aarch64-linux-gnu",
    }),
)

# The image controller is platform-selected (same pattern as
# //core:mediamtx_dist_bin): BOTH amd64 and arm64 ship the statically-linked
# pure-Go controller (//core/controller:strimserver-controller — pure = "on",
# so it needs no loader/libs in the FROM-scratch image). The binary's GOARCH
# follows the target platform (amd64 target → amd64 binary, arm64 target →
# arm64 binary). Both land at the same image path /strimserver-controller.
# The assembly controller lives in the manual alternate packages
# //core/controller/alternate/asm:controller_asm (aarch64) and
# //core/controller/alternate/asm:controller_asm_x86_64, built only on
# explicit request — never as part of the image.
filegroup(
    name = "controller_bin_src",
    srcs = select({
        "//tools/bazel:is_amd64_target": [":strimserver-controller"],
        "//tools/bazel:is_arm64_target": [":strimserver-controller"],
    }),
)

pkg_files(
    name = "controller_bin",
    srcs = [":controller_bin_src"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/",
    renames = {":controller_bin_src": "strimserver-controller"},
)

pkg_files(
    name = "controller_entrypoint",
    srcs = ["entrypoint.sh"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/",
)

pkg_tar(
    name = "controller_files_tar",
    srcs = [
        ":controller_bin",
        ":controller_bin_sh",
        ":controller_entrypoint",
        ":controller_lib64",
        ":controller_libs",
    ] + select({
        "//tools/bazel:is_amd64_target": [],
        "//tools/bazel:is_arm64_target": [":controller_arm64_loader_interp"],
    }),
)

oci_image(
    name = "controller_image",
    architecture = select({
        "//tools/bazel:is_amd64_target": "amd64",
        "//tools/bazel:is_arm64_target": "arm64",
    }),
    entrypoint = ["/entrypoint.sh"],
    os = "linux",
    tars = [":controller_files_tar"],
)

oci_load(
    name = "controller_image_tarball",
    image = ":controller_image",
    repo_tags = ["docker.io/library/strimserver-controller-go:latest"],
)

sh_test(
    name = "image_smoke_test",
    srcs = ["image_smoke_test.sh"],
    args = ["$(location :controller_files_tar)"],
    data = [":controller_files_tar"],
)

# Promotes oci_load's named "tarball" output group (the raw OCI tar; the
# default output is a runnable `docker load`-style script) into a plain
# filegroup so the deployment bundles (//:strimserver_deployment_*) can depend
# on it normally.
filegroup(
    name = "controller_image_tar_file",
    srcs = [":controller_image_tarball"],
    output_group = "tarball",
    visibility = ["//visibility:public"],
)

# =============================================================================
# C controller image (FROM scratch, NO shell/donors). Wave-4: the musl-static
# C controller (//core/controller/c:strimserver-controller) is the ONLY file
# in the image and IS the entrypoint -- no /entrypoint.sh, no /bin/sh, no
# dash/libc6/ld-linux donors (the binary needs no loader or libc). The binary
# is built by the hermetic zig musl toolchain under --config=amd64 /
# --config=arm64 (or the //:c_controller_transition rules); its arch follows
# the target platform, and oci_image stamps the matching architecture -- the
# same pattern as :controller_image above.
#
# All targets here are `manual`: they pull the C binary into the graph, and a
# plain `bazel build //...` (default clang/glibc toolchain) must not build it
# (the -static glibc link would fail). The bundle graph reaches them only
# through //:c_controller_transition, which injects the zig musl config.
# =============================================================================

pkg_files(
    name = "controller_bin_c",
    srcs = ["//core/controller/c:strimserver-controller"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/",
    renames = {"//core/controller/c:strimserver-controller": "strimserver-controller"},
    tags = ["manual"],
)

pkg_tar(
    name = "controller_c_files_tar",
    srcs = [":controller_bin_c"],
    tags = ["manual"],
)

oci_image(
    name = "controller_image_c",
    architecture = select({
        "//tools/bazel:is_amd64_target": "amd64",
        "//tools/bazel:is_arm64_target": "arm64",
    }),
    entrypoint = ["/strimserver-controller"],
    os = "linux",
    tars = [":controller_c_files_tar"],
    tags = ["manual"],
)

oci_load(
    name = "controller_image_c_tarball",
    image = ":controller_image_c",
    repo_tags = ["docker.io/library/strimserver-controller-c:latest"],
    tags = ["manual"],
)

filegroup(
    name = "controller_image_c_tar_file",
    srcs = [":controller_image_c_tarball"],
    output_group = "tarball",
    visibility = ["//visibility:public"],
    tags = ["manual"],
)

sh_test(
    name = "image_c_smoke_test",
    srcs = ["image_c_smoke_test.sh"],
    args = ["$(location :controller_c_files_tar)"] + select({
        "//tools/bazel:is_amd64_target": ["amd64"],
        "//tools/bazel:is_arm64_target": ["arm64"],
    }),
    data = [":controller_c_files_tar"],
    tags = ["manual"],
)
