# gazelle:prefix strimserver-controller

load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//tools/bazel:deb_file.bzl", "deb_file")
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools/bazel:go_bin.bzl", "go_bin")

exports_files(["go.mod", "go.sum"])

go_library(
    name = "controller_lib",
    srcs = [
        "container_factory.go",
        "controller.go",
        "envspec.go",
        "main.go",
        "names.go",
        "paths.go",
    ],
    importpath = "strimserver-controller",
    visibility = ["//visibility:private"],
    deps = [
        "@com_github_coder_websocket//:websocket",
        "@com_github_coder_websocket//wsjson",
        "@com_github_containerd_containerd_api//events",
        "@com_github_containerd_containerd_v2//client",
        "@com_github_containerd_containerd_v2//core/events",
        "@com_github_containerd_containerd_v2//pkg/cdi",
        "@com_github_containerd_containerd_v2//pkg/cio",
        "@com_github_containerd_containerd_v2//pkg/namespaces",
        "@com_github_containerd_containerd_v2//pkg/oci",
        "@com_github_containerd_errdefs//:errdefs",
        "@com_github_containerd_typeurl_v2//:typeurl",
        "@com_github_opencontainers_runtime_spec//specs-go",
    ],
)

# Built as a pure-Go static linux/amd64 binary: pure=on matches the old
# CGO_ENABLED=0 (verified: no `import "C"` and no os/user anywhere in this
# package); -trimpath is a rules_go default; the old -ldflags='-s -w' becomes
# gc_linkopts below.
go_binary(
    name = "strimserver-controller",
    embed = [":controller_lib"],
    goarch = "amd64",
    goos = "linux",
    gc_linkopts = [
        "-s",
        "-w",
    ],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "controller_test",
    srcs = [
        "container_factory_test.go",
        "controller_test.go",
    ],
    embed = [":controller_lib"],
    # pure = "on" matches the binary: this package is pure Go (verified: no
    # import "C" and no os/user anywhere in this package), so the test links
    # statically instead of dragging in the host C toolchain/libgcc.
    pure = "on",
    deps = [
        "@com_github_containerd_containerd_v2//client",
        "@com_github_containerd_containerd_v2//core/content",
        "@com_github_containerd_containerd_v2//core/containers",
        "@com_github_containerd_containerd_v2//core/events",
        "@com_github_containerd_containerd_v2//core/snapshots",
        "@com_github_containerd_containerd_v2//pkg/oci",
        "@com_github_opencontainers_image_spec//specs-go/v1:specs-go",
        "@com_github_opencontainers_runtime_spec//specs-go",
    ],
)

# --- Codegen: strimserver.env.example + the Stream Deck wire types ----------
# Replaces `make generate` / `make check-generated` (Makefile:53-59). Unlike
# the make target, `generate_test` never writes to the source tree to check
# it, and it's wired into the default `bazel test //...` set.

genrule(
    name = "env_example_gen",
    outs = ["strimserver.env.example.gen"],
    cmd = "$(location :strimserver-controller) -print-env-example > $@",
    tools = [":strimserver-controller"],
    visibility = ["//core:__pkg__"],
)

genrule(
    name = "ts_types_gen",
    outs = ["types.generated.ts.gen"],
    cmd = "$(location :strimserver-controller) -print-ts-types > $@",
    tools = [":strimserver-controller"],
    visibility = ["//tools/streamdeck-plugin/src/client:__pkg__"],
)

# write_source_files requires each destination file to live in the same
# package as the target that writes it, so the actual writes are declared
# next to their destinations (//core:write_env_example and
# //tools/streamdeck-plugin/src/client:write_ts_types) and chained here.
write_source_files(
    name = "generate",
    additional_update_targets = [
        "//core:write_env_example",
        "//tools/streamdeck-plugin/src/client:write_ts_types",
    ],
)

test_suite(
    name = "generate_test",
    tests = [
        "//core:write_env_example_test",
        "//tools/streamdeck-plugin/src/client:write_ts_types_test",
    ],
)

# --- Lint --------------------------------------------------------------
# golangci-lint pinned as a downloaded, checksummed Bazel tool (see
# @golangci_lint_linux_amd64 / @golangci_lint_linux_arm64 in MODULE.bazel)
# instead of `go install`ed over the network on every lint-enabled build.
# The filegroup selects the tool matching the target platform; the lint test
# runs on the target platform via --use_target_platform_for_tests, so it gets
# the native tool on each architecture.

filegroup(
    name = "golangci_lint_tool",
    srcs = select({
        "//tools/bazel:is_amd64_target": ["@golangci_lint_linux_amd64//:golangci-lint"],
        "//tools/bazel:is_arm64_target": ["@golangci_lint_linux_arm64//:golangci-lint"],
    }),
)

go_bin(name = "go_bin")

sh_test(
    name = "lint",
    srcs = ["lint.sh"],
    args = [
        "$(location :golangci_lint_tool)",
        "$(location :go_bin)",
        "$(location :.golangci.yml)",
    ],
    data = [
        ":golangci_lint_tool",
        ":go_bin",
        ".golangci.yml",
        "container_factory.go",
        "container_factory_test.go",
        "controller.go",
        "controller_test.go",
        "envspec.go",
        "go.mod",
        "go.sum",
        "main.go",
        "names.go",
        "paths.go",
    ],
)

# =============================================================================
# controller image (FROM scratch). Assembled by rules_oci from the Go binary
# plus dash + libc6 donor packages from the @trixie apt snapshot.
# =============================================================================

deb_file(
    name = "dash_as_sh",
    data = "@trixie//dash:data",
    path = "usr/bin/dash",
    out = "sh",
)

deb_file(
    name = "controller_ld_linux",
    data = "@trixie//libc6:data",
    path = "usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2",
    path_arm64 = "usr/lib/aarch64-linux-gnu/ld-linux-aarch64.so.1",
)

deb_file(
    name = "controller_libc_so",
    data = "@trixie//libc6:data",
    path = "usr/lib/x86_64-linux-gnu/libc.so.6",
    path_arm64 = "usr/lib/aarch64-linux-gnu/libc.so.6",
)

pkg_files(
    name = "controller_bin_sh",
    srcs = [":dash_as_sh"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/bin",
)

pkg_files(
    name = "controller_lib64",
    srcs = [":controller_ld_linux"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/lib64",
)

pkg_files(
    name = "controller_libs",
    srcs = [":controller_libc_so"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = select({
        "//tools/bazel:is_amd64_target": "/lib/x86_64-linux-gnu",
        "//tools/bazel:is_arm64_target": "/lib/aarch64-linux-gnu",
    }),
)

# The image controller is platform-selected (same pattern as
# //core:mediamtx_dist_bin): amd64 ships the statically-linked x86-64-v4
# assembly controller (//core/controller:controller_asm_x86_64, Phase 5.2;
# Gate 5 satisfied — the differential harness and image smoke both pass),
# arm64 ships the statically-linked assembly controller
# (//core/controller:controller_asm, Phase 4.8). Both land at the same
# image path /strimserver-controller. Each controller_asm target is
# single-arch, so the unselected select branch is never analyzed.
filegroup(
    name = "controller_bin_src",
    srcs = select({
        "//tools/bazel:is_amd64_target": [":controller_asm_x86_64"],
        "//tools/bazel:is_arm64_target": [":controller_asm"],
    }),
)

pkg_files(
    name = "controller_bin",
    srcs = [":controller_bin_src"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/",
    renames = {":controller_bin_src": "strimserver-controller"},
)

pkg_files(
    name = "controller_entrypoint",
    srcs = ["entrypoint.sh"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/",
)

pkg_tar(
    name = "controller_files_tar",
    srcs = [
        ":controller_bin",
        ":controller_bin_sh",
        ":controller_entrypoint",
        ":controller_lib64",
        ":controller_libs",
    ],
)

oci_image(
    name = "controller_image",
    architecture = select({
        "//tools/bazel:is_amd64_target": "amd64",
        "//tools/bazel:is_arm64_target": "arm64",
    }),
    entrypoint = ["/entrypoint.sh"],
    os = "linux",
    tars = [":controller_files_tar"],
)

oci_load(
    name = "controller_image_tarball",
    image = ":controller_image",
    repo_tags = ["docker.io/library/strimserver-controller:latest"],
)

sh_test(
    name = "image_smoke_test",
    srcs = ["image_smoke_test.sh"],
    args = ["$(location :controller_files_tar)"],
    data = [":controller_files_tar"],
)

# Promotes oci_load's named "tarball" output group (the raw OCI tar; the
# default output is a runnable `docker load`-style script) into a plain
# filegroup so //:strimserver_deployment_tar can depend on it normally.
filegroup(
    name = "controller_image_tar_file",
    srcs = [":controller_image_tarball"],
    output_group = "tarball",
    visibility = ["//visibility:public"],
)

# =============================================================================
# Phase 4.8: controller_asm — the AArch64 assembly controller binary.
#
# All seven asm modules (cc_util/cc_env/cc_json/cc_ctr/cc_state/cc_http/
# cc_main .S) plus the vendored C protocol layer (cc_grpc/cc_ctr/cc_http)
# link into one binary. cc_main.S exports `main` as a one-instruction tail
# call to cc_main_entry, so the standard crt0 entry works unchanged.
# Cross-language linkage is plain extern symbols; no registration is needed.
#
# -Werror policy: the C files are proven clean under -Wall -Wextra -Werror,
# so the cc_binary keeps it. The .S files are compiled by the toolchain's
# assembler-with-cpp and assembler warnings are toolchain-sensitive (a
# different host gcc could emit one), so -Werror stays OFF the asm
# cc_library; -Wall -Wextra still surfaces anything, and the real asm gates
# are check-isa.sh / check-clobbers.sh.
# =============================================================================

cc_library(
    name = "controller_asm_lib",
    srcs = [
        "//core/controller/asm:cc_util.S",
        "//core/controller/asm:cc_env.S",
        "//core/controller/asm:cc_json.S",
        "//core/controller/asm:cc_ctr.S",
        "//core/controller/asm:cc_state.S",
        "//core/controller/asm:cc_http.S",
        "//core/controller/asm:cc_main.S",
    ],
    hdrs = [
        "//core/controller/asm:cc_platform.h",
        "//core/controller/asm:cc_layout.inc",
        "//core/controller/asm:cc_env.h",
        "//core/controller/asm:cc_json.h",
        "//core/controller/asm:cc_ctr.h",
        "//core/controller/asm:cc_state.h",
        "//core/controller/asm:cc_http.h",
        "//core/controller/asm:cc_main.h",
    ],
    copts = [
        "-Wall",
        "-Wextra",
    ],
    target_compatible_with = ["@platforms//cpu:aarch64"],
)

cc_binary(
    name = "controller_asm",
    # core/controller/c is its own Bazel package, so its sources are
    # referenced by label. cc_binary has no hdrs attribute; the C headers
    # and the Huffman include are declared in srcs as non-compiled inputs
    # (same-dir quote includes resolve regardless, this just makes the
    # dependency explicit).
    srcs = [
        "//core/controller/c:cc_grpc.c",
        "//core/controller/c:cc_ctr.c",
        "//core/controller/c:cc_http.c",
        "//core/controller/c:cc_grpc.h",
        "//core/controller/c:cc_ctr.h",
        "//core/controller/c:cc_http.h",
        "//core/controller/c:cc_grpc_huff.inc",
    ],
    copts = [
        "-std=gnu11",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    # Static link: the controller image is FROM scratch and ships a
    # statically-linked Go controller, so the asm controller must also need
    # no loader/libs at runtime (avoids the known arm64 loader-basename gap).
    # The host toolchain has libc.a/libm.a/libpthread.a/libdl.a (glibc static
    # archives), so -static links clean; ldd reports "not a dynamic
    # executable".
    linkopts = [
        "-lm",
        "-ldl",
        "-lpthread",
        "-static",
    ],
    target_compatible_with = ["@platforms//cpu:aarch64"],
    deps = [
        ":controller_asm_lib",
        "//third_party/protobuf-c:runtime",
        "//third_party/containerd-api:codecs",
        "//third_party/libwebsockets:libwebsockets",
    ],
)

# =============================================================================
# Phase 5.2: controller_asm_x86_64 — the x86-64-v4 assembly controller binary.
#
# Mirror of controller_asm (Phase 4.8) for the x86-64-v4 port
# (core/controller/asm/x86_64/): the same seven-module shape, the same
# vendored C protocol layer, the same third_party deps.  ISA floor
# x86-64-v4 with the AVX-512 features the floor would otherwise imply
# explicitly disabled (the cap is AVX2 — no zmm/k/AMX — target
# g4dn.xlarge), SysV ABI.  The C protocol layer (core/controller/c) is
# arch-neutral; the third_party C deps are already dual-arch (amd64 has no
# compatibility constraint).
#
# -Werror policy mirrors the AArch64 controller_asm: -Werror stays ON the C
# files (proven clean under -Wall -Wextra -Werror) and OFF the .S files
# (assembler warnings are toolchain-sensitive; the real asm gates are
# check-isa-x86_64.sh / check-clobbers-x86_64.sh).
#
# All seven x86_64 modules have landed and the run-path differential is GREEN
# byte-for-byte vs the AArch64 reference on every function it exercises
# (env_fail_invalid/env_fail_missing, main_build_layout, http_is_null,
# http_badjson_lit, http_str_value; http_badjson_msg runs to completion with
# two documented out-of-contract classifier divergences that intentionally
# match the AArch64 original — see the http_badjson_msg header in
# core/controller/asm/x86_64/cc_http.S). Gate 3 is satisfied for the
# run-path modules, so hard rule 9 no longer gates the binary or its
# aggregate library: both are live (no tags = ["manual"]). The per-module
# checker tests in //core/controller/asm:phase5_checkers_x86_64 remain fully
# active.  The controller image select() above now ships the x86-64 asm
# controller for amd64 (Gate 5: differential harness + image smoke both
# GREEN) and the AArch64 asm controller for arm64.
# =============================================================================

cc_library(
    name = "controller_asm_lib_x86_64",
    srcs = [
        "//core/controller/asm:x86_64/cc_util.S",
        "//core/controller/asm:x86_64/cc_env.S",
        "//core/controller/asm:x86_64/cc_json.S",
        "//core/controller/asm:x86_64/cc_ctr.S",
        "//core/controller/asm:x86_64/cc_state.S",
        "//core/controller/asm:x86_64/cc_http.S",
        "//core/controller/asm:x86_64/cc_main.S",
    ],
    hdrs = [
        "//core/controller/asm:x86_64/cc_platform_x86_64.h",
        "//core/controller/asm:cc_layout.inc",
        "//core/controller/asm:cc_env.h",
        "//core/controller/asm:cc_json.h",
        "//core/controller/asm:cc_ctr.h",
        "//core/controller/asm:cc_state.h",
        "//core/controller/asm:cc_http.h",
        "//core/controller/asm:cc_main.h",
    ],
    copts = [
        "-Wall",
        "-Wextra",
        # ISA floor x86-64-v4 with the AVX-512 feature set the floor implies
        # explicitly disabled (the cap is AVX2 — no zmm/k/AMX). This library
        # compiles the seven .S modules directly, so the floor/cap must gate
        # the asm compilation here (x86 gas accepts everything by default) —
        # mirroring X86_64_ASM_COPTS in //core/controller/asm.
        "-march=x86-64-v4",
        "-mno-avx512f",
        "-mno-avx512vl",
        "-mno-avx512bw",
        "-mno-avx512dq",
        "-mno-avx512cd",
    ],
    target_compatible_with = ["@platforms//cpu:x86_64"],
)

cc_binary(
    name = "controller_asm_x86_64",
    srcs = [
        "//core/controller/c:cc_grpc.c",
        "//core/controller/c:cc_ctr.c",
        "//core/controller/c:cc_http.c",
        "//core/controller/c:cc_grpc.h",
        "//core/controller/c:cc_ctr.h",
        "//core/controller/c:cc_http.h",
        "//core/controller/c:cc_grpc_huff.inc",
    ],
    # C-only copts: srcs are just the C protocol layer (arch-neutral). The ISA
    # floor/cap (-march=x86-64-v4 -mno-avx512*) lives on the asm compilation
    # itself — controller_asm_lib_x86_64 above, which compiles the .S modules.
    copts = [
        "-std=gnu11",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    # Static link: same rationale as controller_asm — the controller image
    # is FROM scratch, so the binary needs no loader/libs at runtime.
    linkopts = [
        "-lm",
        "-ldl",
        "-lpthread",
        "-static",
    ],
    target_compatible_with = ["@platforms//cpu:x86_64"],
    deps = [
        ":controller_asm_lib_x86_64",
        "//third_party/protobuf-c:runtime",
        "//third_party/containerd-api:codecs",
        "//third_party/libwebsockets:libwebsockets",
    ],
)
