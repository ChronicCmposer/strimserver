# =============================================================================
# ffmpeg image (FROM scratch). The binary comes from the pinned, checksummed
# @ffmpeg_dist artifact (built out-of-band by tools/ffmpeg-dist/publish.sh);
# the runtime debs below (libc6 set + libfdk-aac2t64) come from the @trixie
# apt snapshot and serve both images.
# =============================================================================

deb_file(
    name = "libdl_so",
    data = "@trixie//libc6:data",
    path = "usr/lib/x86_64-linux-gnu/libdl.so.2",
    path_arm64 = "usr/lib/aarch64-linux-gnu/libdl.so.2",
)

deb_file(
    name = "librt_so",
    data = "@trixie//libc6:data",
    path = "usr/lib/x86_64-linux-gnu/librt.so.1",
    path_arm64 = "usr/lib/aarch64-linux-gnu/librt.so.1",
)

deb_file(
    name = "libnss_dns_so",
    data = "@trixie//libc6:data",
    path = "usr/lib/x86_64-linux-gnu/libnss_dns.so.2",
    path_arm64 = "usr/lib/aarch64-linux-gnu/libnss_dns.so.2",
)

deb_file(
    name = "libnss_files_so",
    data = "@trixie//libc6:data",
    path = "usr/lib/x86_64-linux-gnu/libnss_files.so.2",
    path_arm64 = "usr/lib/aarch64-linux-gnu/libnss_files.so.2",
)

# libfdk-aac2t64 ships libfdk-aac.so.2 as a SYMLINK to libfdk-aac.so.2.0.3, and
# deb_file (tar -xzf of a single member + cp -p) cannot copy a dangling symlink
# (the target member is not extracted). Extract the real versioned file here and
# recreate the soname symlink in :libfdk_aac_soname_link below -- matching the
# Debian package layout (and the soname symlink the Debian package ships). The
# versioned filename is identical on both architectures.
deb_file(
    name = "libfdk_aac_real",
    data = "@trixie//libfdk-aac2t64:data",
    path = "usr/lib/x86_64-linux-gnu/libfdk-aac.so.2.0.3",
    path_arm64 = "usr/lib/aarch64-linux-gnu/libfdk-aac.so.2.0.3",
)

pkg_files(
    name = "ffmpeg_usr_bin",
    srcs = [
        ":busybox_bin",
        ":nice_bin",
    ],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/usr/bin",
)

pkg_files(
    name = "ffmpeg_lib64",
    srcs = [":ld_linux"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/lib64",
)

pkg_files(
    name = "ffmpeg_libs",
    srcs = [
        ":libc_so",
        ":libm_so",
        ":libdl_so",
        ":libpthread_so",
        ":librt_so",
        ":libresolv_so",
        ":libnss_dns_so",
        ":libnss_files_so",
    ],
    attributes = pkg_attributes(mode = "0755"),
    prefix = select({
        "//tools/bazel:is_amd64_target": "/lib/x86_64-linux-gnu",
        "//tools/bazel:is_arm64_target": "/lib/aarch64-linux-gnu",
    }),
)

pkg_files(
    name = "ffmpeg_fdk_libs",
    srcs = [":libfdk_aac_real"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = select({
        "//tools/bazel:is_amd64_target": "/usr/lib/x86_64-linux-gnu",
        "//tools/bazel:is_arm64_target": "/usr/lib/aarch64-linux-gnu",
    }),
)

# The Debian package ships libfdk-aac.so.2 as a symlink to the versioned file
# above. pkg_tar's `symlinks` dict cannot hold a select() (the keys of an
# attr.string_dict are not configurable in Bazel), so the soname symlink is
# declared with pkg_mklink instead: its `link_name` is an attr.string, which
# select()s between the amd64 and arm64 multiarch dirs. `target` stays the
# same relative versioned filename on both architectures, and mode 0555
# matches what pkg_tar's default mode used to stamp on the legacy symlinks
# dict entry, keeping the amd64 tar byte-identical.
pkg_mklink(
    name = "libfdk_aac_soname_link",
    link_name = select({
        "//tools/bazel:is_amd64_target": "/usr/lib/x86_64-linux-gnu/libfdk-aac.so.2",
        "//tools/bazel:is_arm64_target": "/usr/lib/aarch64-linux-gnu/libfdk-aac.so.2",
    }),
    target = "libfdk-aac.so.2.0.3",
    attributes = pkg_attributes(mode = "0555"),
)

pkg_files(
    name = "ffmpeg_nsswitch",
    srcs = [":nsswitch_conf"],
    attributes = pkg_attributes(mode = "0644"),
    prefix = "/etc",
    renames = {":nsswitch_conf": "nsswitch.conf"},
)

pkg_files(
    name = "ffmpeg_root",
    srcs = ["@ffmpeg_dist//:ffmpeg"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/",
)

pkg_tar(
    name = "ffmpeg_files_tar",
    srcs = [
        ":ffmpeg_usr_bin",
        ":ffmpeg_lib64",
        ":ffmpeg_libs",
        ":ffmpeg_fdk_libs",
        ":ffmpeg_nsswitch",
        ":ffmpeg_root",
        ":libfdk_aac_soname_link",
    ],
    symlinks = {
        "/bin/sh": "/usr/bin/busybox",
        "/usr/bin/cat": "/usr/bin/busybox",
        "/usr/bin/ln": "/usr/bin/busybox",
        "/usr/bin/mkdir": "/usr/bin/busybox",
        "/usr/bin/nc": "/usr/bin/busybox",
        "/usr/bin/rm": "/usr/bin/busybox",
        "/usr/bin/sh": "/usr/bin/busybox",
        "/usr/bin/wget": "/usr/bin/busybox",
    },
)

# rules_oci's oci_image macro only accepts `env` as a dict or a label to a
# file, and a dict cannot hold a select() (the macro stringifies values at
# load time). Generate the env file here so LD_LIBRARY_PATH can be
# arch-aware: on amd64 it is /usr/lib64 (the NVIDIA container runtime mounts
# driver libs there); on arm64 the aarch64 dynamic loader searches
# /lib/aarch64-linux-gnu for libc, so LD_LIBRARY_PATH points at the aarch64
# multiarch dir where the glibc set lands. The amd64 bytes are identical to
# the old dict literal (same key=value lines, same order, no trailing
# newline).
genrule(
    name = "ffmpeg_env",
    outs = ["ffmpeg.env.txt"],
    cmd = select({
        "//tools/bazel:is_amd64_target": "printf 'NVIDIA_VISIBLE_DEVICES=all\\nNVIDIA_DRIVER_CAPABILITIES=compute,utility,video\\nLD_LIBRARY_PATH=/usr/lib64\\nPATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' > $@",
        "//tools/bazel:is_arm64_target": "printf 'NVIDIA_VISIBLE_DEVICES=all\\nNVIDIA_DRIVER_CAPABILITIES=compute,utility,video\\nLD_LIBRARY_PATH=/lib/aarch64-linux-gnu\\nPATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' > $@",
    }),
)

oci_image(
    name = "ffmpeg_image",
    architecture = select({
        "//tools/bazel:is_amd64_target": "amd64",
        "//tools/bazel:is_arm64_target": "arm64",
    }),
    os = "linux",
    tars = [":ffmpeg_files_tar"],
    env = ":ffmpeg_env",
)

oci_load(
    name = "ffmpeg_image_tarball",
    repo_tags = ["docker.io/library/ffmpeg:latest"],
    image = ":ffmpeg_image",
)

filegroup(
    name = "ffmpeg_image_tar_file",
    srcs = [":ffmpeg_image_tarball"],
    output_group = "tarball",
    visibility = ["//visibility:public"],
)

sh_test(
    name = "ffmpeg_smoke_test",
    srcs = ["ffmpeg_smoke_test.sh"],
    args = ["$(location :ffmpeg_files_tar)"],
    data = [":ffmpeg_files_tar"],
)

filegroup(
    name = "mediamtx_image_tar_file",
    srcs = [":mediamtx_image_tarball"],
    output_group = "tarball",
    visibility = ["//visibility:public"],
)
