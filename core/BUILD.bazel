deb_file(
    name = "ld_linux",
    data = "@trixie//libc6:data",
    path = "usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2",
    path_arm64 = "usr/lib/aarch64-linux-gnu/ld-linux-aarch64.so.1",
)

deb_file(
    name = "libc_so",
    data = "@trixie//libc6:data",
    path = "usr/lib/x86_64-linux-gnu/libc.so.6",
    path_arm64 = "usr/lib/aarch64-linux-gnu/libc.so.6",
)

deb_file(
    name = "libm_so",
    data = "@trixie//libc6:data",
