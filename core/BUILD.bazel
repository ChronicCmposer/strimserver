    attributes = pkg_attributes(mode = "0755"),
    prefix = "/",
)

pkg_files(
    name = "mediamtx_entrypoint",
    srcs = ["entrypoint.mediamtx.sh"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/",
    renames = {"entrypoint.mediamtx.sh": "entrypoint.sh"},
)

pkg_tar(
    name = "mediamtx_files_tar",
    srcs = [
        ":mediamtx_entrypoint",
        ":mediamtx_lib64",
        ":mediamtx_libs",
        ":mediamtx_nsswitch",
        ":mediamtx_root",
        ":mediamtx_usr_bin",
    ],
