# --- amd64 GNU strip tool ----------------------------------------------------
# Used to cross-strip the amd64 @mediamtx_dist binary on non-x86_64 hosts by
# running it under the patched qemu-x86_64 (see mediamtx_bin_stripped below).
# The real ELF is x86_64-linux-gnu-strip (the /usr/bin/strip symlink in the
# deb points at it, and deb_file cannot copy a dangling symlink); the libs are
# the strip binary's own runtime closure. libsframe/libz/libzstd ship soname
# symlinks in the deb, so the real versioned files are extracted here and
# renamed to their sonames when the qemu sysroot is assembled in the genrule.
# libgcc_s.so.1 is also in the closure (binutils links it for stack
# unwinding); libgcc-s1 is already in the @trixie donor set transitively, so
# it costs nothing extra to supply.
deb_file(
    name = "amd64_strip_bin",
    data = "@trixie//binutils-x86-64-linux-gnu/amd64:data",
    path = "usr/bin/x86_64-linux-gnu-strip",
)

deb_file(
    name = "amd64_strip_libbfd",
    data = "@trixie//libbinutils/amd64:data",
    path = "usr/lib/x86_64-linux-gnu/libbfd-2.44-system.so",
)

deb_file(
    name = "amd64_strip_libsframe",
    data = "@trixie//libsframe1/amd64:data",
    path = "usr/lib/x86_64-linux-gnu/libsframe.so.1.0.0",
)

deb_file(
    name = "amd64_strip_libz",
    data = "@trixie//zlib1g/amd64:data",
    path = "usr/lib/x86_64-linux-gnu/libz.so.1.3.1",
)

deb_file(
    name = "amd64_strip_libzstd",
    data = "@trixie//libzstd1/amd64:data",
    path = "usr/lib/x86_64-linux-gnu/libzstd.so.1.5.7",
)

deb_file(
    name = "amd64_strip_libgcc_s",
    data = "@trixie//libgcc-s1/amd64:data",
    path = "usr/lib/x86_64-linux-gnu/libgcc_s.so.1",
)

# The amd64 loader + libc for the qemu cross-strip sysroot (mediamtx_bin_stripped
# above). These are exec tools, so they are deliberately amd64-ONLY: the
# qemu-x86_64 emulator rejects a non-x86-64 ELF loader with "Invalid ELF image
# for this architecture". Do NOT point them at the arch-selecting alias or add
# path_arm64 -- the arch-aware :ld_linux / :libc_so above serve the image
# layers instead.
deb_file(
    name = "strip_ld_linux",
    data = "@trixie//libc6/amd64:data",
    path = "usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2",
    out = "strip-ld-linux-x86-64.so.2",
)

deb_file(
    name = "strip_libc_so",
    data = "@trixie//libc6/amd64:data",
    path = "usr/lib/x86_64-linux-gnu/libc.so.6",
    out = "strip-libc.so.6",
)

# ca-certificates is Arch:all, so the arch-selecting alias
# @trixie//ca-certificates:data resolves to the same content tar for amd64
# and arm64 (the amd64 bytes are unchanged).
cacerts(
    name = "cacerts",
    package = "@trixie//ca-certificates:data",
)

pkg_files(
    name = "mediamtx_usr_bin",
    srcs = [
        ":busybox_bin",
        ":envsubst_bin",
        ":nice_bin",
