# BUILD file for the @mbedtls external repo (mbedTLS 3.6.7 source, pinned in
# MODULE.bazel). Exposes the full mbedTLS library as a static cc_library
# using its stock default config (include/mbedtls/mbedtls_config.h).
#
# This is exactly the BCR mbedtls 3.6.7 module's source set: glob
# library/*.c (the release tarball ships every generated source, including
# version_features.c and ssl_debug_helpers_generated.c) with the stock
# config, so the TLS 1.2/1.3 + X.509-verification feature set libcurl's
# mbedtls backend needs is the same known-good combination the BCR curl
# 8.22.0 module builds against. Unused cipher/TLS paths are pruned at link
# time by -ffunction-sections/-fdata-sections + -Wl,--gc-sections.
#
# Compiled statically against musl by the zig toolchain under
# //tools/bazel:c_controller_transition: features = ["-supports_dynamic_linker"]
# + linkstatic = True are the repo's musl-static cc_library convention
# (core/controller/c).

load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "mbedtls",
    srcs = glob(["library/*.c"]),
    hdrs = glob([
        "include/**/*.h",
        "library/*.h",
    ]),
    includes = [
        "include",
        "library",
    ],
    features = ["-supports_dynamic_linker"],
    linkstatic = True,
    visibility = ["//visibility:public"],
)