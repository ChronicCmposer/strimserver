# In-repo package for the libmicrohttpd smoke test. The library itself is
# built in the fetched @libmicrohttpd repo by BUILD.libmicrohttpd.

load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

exports_files(
    ["BUILD.libmicrohttpd", "MHD_config.h", "pin.json"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "mhd_smoke_test",
    srcs = ["mhd_smoke_test.c"],
    linkstatic = True,
    linkopts = [
        "-lpthread",
        "-static",
    ],
    target_compatible_with = select({
        "//tools/bazel:is_amd64_target": [],
        "//tools/bazel:is_arm64_target": ["@platforms//cpu:aarch64"],
        "//conditions:default": ["@platforms//cpu:aarch64"],
    }),
    deps = ["@libmicrohttpd//:libmicrohttpd"],
)
