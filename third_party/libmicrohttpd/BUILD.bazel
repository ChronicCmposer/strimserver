# Vendored libmicrohttpd v1.0.10 (GNU LGPL 2.1+), static, dual-arch, no TLS.
#
# The upstream release tarball's library sources (src/microhttpd/*.c) are
# committed here byte-for-byte, along with the public/internal headers
# (src/include/*.h, src/microhttpd/*.h). The configure-generated feature
# header MHD_config.h is committed as a static source file (same pattern as
# //third_party/libwebsockets's committed lwsgen/lws_config.h): it is a pure
# feature-define header with no arch-specific values, so the single committed
# file serves both target arches. It was generated by running the upstream
# configure with the control-plane feature set and patching two lines:
#   - HAVE_STDBOOL_H: this host's configure run failed to detect stdbool.h
#     (compiler-provided header on gcc/clang); defined unconditionally.
#   - _GNU_SOURCE: upstream passes this on the command line via MHD_SYS_EXT
#     (m4/mhd_sys_extentions.m4), not in MHD_config.h; folded into the header
#     because it is included before any system header. Required for accept4(),
#     pthread_setname_np() etc. on glibc.
#
# Feature set (configure flags): --disable-https --disable-bauth
# --disable-dauth --disable-postprocessor --disable-curl --enable-httpupgrade
# --enable-epoll. That yields: no TLS (no ssl/gnutls), no auth, no
# postprocessor, HTTP/1.1 Upgrade support enabled (MHD_ALLOW_UPGRADE — the
# wslay handoff path), EPOLL_SUPPORT, MHD_USE_POSIX_THREADS, and
# MHD_USE_SYS_TSEARCH (glibc tsearch, so tsearch.c is NOT compiled).
#
# The controller is single-threaded-core, so MHD runs in external event loop
# mode (MHD_USE_EPOLL + caller-driven MHD_run(), no internal thread) or with
# MHD_USE_INTERNAL_POLLING_THREAD; both are library features, not build
# features, so both work with this build. mhd_smoke_test.c exercises both.
#
# Static-only (matches the FROM-scratch controller image and the amd64 clang
# cross-toolchain's static-only sysroot): features = ["-supports_dynamic_linker"].
#
# Dual-arch: compiled by Bazel's C++ toolchain for the TARGET platform —
# linux/amd64 via the registered clang cross-toolchain, linux/arm64 via the
# native aarch64 toolchain (same pattern as //third_party/yyjson and
# //third_party/libwebsockets).

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# The library sources. Listed explicitly rather than globbed: the committed
# tree still carries the feature-disabled sources (basicauth.c, digestauth.c,
# gen_auth.c, connection_https.c, postprocessor.c, md5*.c, sha*.c,
# sysfdsetsize.c, tsearch.c), which must NOT be compiled with this feature
# set. The 14 files below are exactly the upstream libmicrohttpd_la_SOURCES
# for the enabled features (see src/microhttpd/Makefile.am). The internal
# headers are globbed (inert) so the sandbox contains everything the sources
# include.
cc_library(
    name = "libmicrohttpd",
    srcs = [
        # Configure-generated feature header at the package root (included as
        # "MHD_config.h" from src/include/mhd_options.h); declared so the
        # sandbox contains it for the -I. include path.
        "MHD_config.h",
        "src/microhttpd/connection.c",
        "src/microhttpd/daemon.c",
        "src/microhttpd/internal.c",
        "src/microhttpd/memorypool.c",
        "src/microhttpd/mhd_compat.c",
        "src/microhttpd/mhd_itc.c",
        "src/microhttpd/mhd_mono_clock.c",
        "src/microhttpd/mhd_panic.c",
        "src/microhttpd/mhd_send.c",
        "src/microhttpd/mhd_sockets.c",
        "src/microhttpd/mhd_str.c",
        "src/microhttpd/mhd_threads.c",
        "src/microhttpd/reason_phrase.c",
        "src/microhttpd/response.c",
    ] + glob([
        "src/microhttpd/*.h",
        "src/include/*.h",
    ]),
    hdrs = ["src/include/microhttpd.h"],
    includes = [
        # MHD_config.h (included by src/include/mhd_options.h).
        ".",
        # platform.h, microhttpd.h, mhd_options.h, autoinit_funcs.h.
        "src/include",
        # The src/microhttpd/*.h internal headers (internal.h, connection.h,
        # mhd_*.h ...) quoted by the sources.
        "src/microhttpd",
    ],
    # Static-only (same rationale as //third_party/libwebsockets): the amd64
    # clang toolchain links against the static-only @amd64_sysroot (no
    # libgcc_s.so.1), so no .so may be produced.
    features = ["-supports_dynamic_linker"],
    copts = [
        # MHD's build defines this for the library compile (see
        # libmicrohttpd_la_CPPFLAGS in src/microhttpd/Makefile.am); without it
        # the public microhttpd.h uses the wrong _MHD_EXTERN/visibility path.
        "-DBUILDING_MHD_LIB=1",
        # MHD 1.0.x is C11; matches the repo's other vendored C (yyjson).
        "-std=gnu11",
    ],
    target_compatible_with = select({
        "//tools/bazel:is_amd64_target": [],
        "//tools/bazel:is_arm64_target": ["@platforms//cpu:aarch64"],
        "//conditions:default": ["@platforms//cpu:aarch64"],
    }),
)

# Scratch smoke test: serves GET /healthz with (a) an internal polling thread
# daemon and (b) an external event-loop daemon (MHD_USE_EPOLL, caller-driven
# MHD_run), asserting HTTP/1.1 200 + body on both.
cc_test(
    name = "mhd_smoke_test",
    srcs = ["mhd_smoke_test.c"],
    # Static-only: same rationale as //third_party/libwebsockets:lws_smoke_test.
    linkstatic = True,
    linkopts = [
        "-lpthread",
        "-static",
    ],
    target_compatible_with = select({
        "//tools/bazel:is_amd64_target": [],
        "//tools/bazel:is_arm64_target": ["@platforms//cpu:aarch64"],
        "//conditions:default": ["@platforms//cpu:aarch64"],
    }),
    deps = [":libmicrohttpd"],
)