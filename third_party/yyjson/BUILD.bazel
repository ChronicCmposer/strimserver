# In-repo package for the yyjson smoke test. The library itself is built in
# the fetched @yyjson repo by BUILD.yyjson.

load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

exports_files(
    ["BUILD.yyjson", "pin.json"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "yyjson_smoke_test",
    srcs = ["yyjson_smoke_test.c"],
    linkstatic = True,
    linkopts = ["-static"],
    target_compatible_with = select({
        "//tools/bazel:is_amd64_target": [],
        "//tools/bazel:is_arm64_target": ["@platforms//cpu:aarch64"],
        "//conditions:default": ["@platforms//cpu:aarch64"],
    }),
    deps = ["@yyjson//:yyjson"],
)
