# Generated containerd API codecs (protobuf-c), Phase 3a of the ARM
# controller rewrite.
#
# Codegen: //third_party/containerd-api:codegen runs the pinned protoc 36.2 +
# the vendored protoc-gen-c plugin over the pinned containerd api v1.12.0
# protos, emitting .pb-c.{c,h} into bazel-bin under generated/codecgen/ (NOT
# codecgen/ — the outs must not shadow the committed files below, or the
# aarch64-only genrule would make the dual-arch :codecs library unanalyzable
# on amd64). The generated files are COMMITTED here as source under codecgen/
# (they are arch-independent C, and BOTH controllers link them directly):
# regenerate via
#   bazel run //third_party/containerd-api:write_codecs
# which writes the generated/codecgen bazel-bin outputs into this package's
# codecgen/. A future maintainer regenerates after bumping the containerd-api
# / protobuf-c pins; the genrule is deterministic (pinned protoc + plugin +
# protos), so committed == regenerated.
#
# amd64 (linux_amd64) builds NEVER run this codegen: the amd64 controller
# compiles the committed .pb-c.{c,h} directly (they are arch-independent C,
# byte-shift encoders with no architecture-specific code), so
# //third_party/protobuf-c:protoc_gen_c and the :codegen genrule below are
# deliberately arm64-only and no amd64 libprotobuf/libprotoc deb pins exist.
# If regeneration is ever needed for amd64, add libprotobuf-dev and
# libprotoc-dev 3.21.12-11+deb13u1_amd64 from the same snapshot.debian.org
# timestamp (20260824T082821Z) and widen the codegen targets.
#
# Scope: google/protobuf well-known types used by containerd, the seven
# service protos (tasks, containers, images, snapshots, events, content,
# version), the types/ protos (descriptor, event, fieldpath, metrics, mount,
# platform, task/task, runc/options), and the events/ protos (task, container,
# image). The api tree's remaining protos (introspection, sandbox, transfer,
# diff, leases, mounts, namespaces, streaming, ttrpc, runtime/*) are out of
# scope for the controller rewrite.

load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# ---------------------------------------------------------------------------
# Codegen: pinned protoc 36.2 + protoc-gen-c over the pinned containerd api
# ---------------------------------------------------------------------------
# The proto list below matches the spec's command shape exactly (all paths
# relative to the api/ subtree root). protoc emits one .pb-c.c/.pb-c.h pair
# per listed file into the --c_out dir, preserving the -I-relative paths.
PROTOS = [
    "google/protobuf/descriptor.proto",
    "google/protobuf/any.proto",
    "google/protobuf/empty.proto",
    "google/protobuf/timestamp.proto",
    "google/protobuf/field_mask.proto",
    "services/tasks/v1/tasks.proto",
    "services/containers/v1/containers.proto",
    "services/images/v1/images.proto",
    "services/snapshots/v1/snapshots.proto",
    "services/events/v1/events.proto",
    "services/content/v1/content.proto",
    "services/version/v1/version.proto",
    "types/descriptor.proto",
    "types/event.proto",
    "types/fieldpath.proto",
    "types/metrics.proto",
    "types/mount.proto",
    "types/platform.proto",
    "types/task/task.proto",
    "types/runc/options/oci.proto",
    "events/task.proto",
    "events/container.proto",
    "events/image.proto",
]

# protoc writes outputs next to the file paths given on the command line
# (which are -I-relative), so the output names mirror the proto paths with the
# .proto suffix swapped for .pb-c.c / .pb-c.h.
CODEC_PAIRS = [
    (p[:-len(".proto")] + ".pb-c.c", p[:-len(".proto")] + ".pb-c.h")
    for p in PROTOS
]

genrule(
    name = "codegen",
    srcs = [
        "@containerd_api//:api_protos",
        "@containerd_api//:api/services/tasks/v1/tasks.proto",
        "//third_party/protobuf-c:protoc_descriptor_proto",
    ],
    outs = ["generated/codecgen/" + f for pair in CODEC_PAIRS for f in pair],
    cmd = "set -eu; " +
          # OUT: the codecgen dir = dirname(dirname(dirname(generated/codecgen/google/protobuf/descriptor.pb-c.c)))
          "OUT=$$(dirname $$(dirname $$(dirname $(location :generated/codecgen/google/protobuf/descriptor.pb-c.c)))) ; " +
          # api root: @containerd_api//:api/services/tasks/v1/tasks.proto
          # -> dirname x4 = the api/ subtree root
          "API_ROOT=$$(dirname $$(dirname $$(dirname $$(dirname $(location @containerd_api//:api/services/tasks/v1/tasks.proto))))) ; " +
          # protoc include root: descriptor.proto sits at include/google/protobuf/
          # -> dirname x3 = the include dir
          "INC_ROOT=$$(dirname $$(dirname $$(dirname $(location //third_party/protobuf-c:protoc_descriptor_proto)))) ; " +
          "mkdir -p $$OUT; " +
          "$(location //third_party/protobuf-c:protoc_tool) " +
          "-I $$INC_ROOT " +
          "-I $$API_ROOT " +
          "--plugin=protoc-gen-c=$(location //third_party/protobuf-c:protoc_gen_c_tool) " +
          "--c_out=$$OUT " +
          " ".join(PROTOS),
    # arm64-only: amd64 builds compile the committed codecgen/ files directly
    # and never regenerate them (see the package header comment). The outs
    # live under generated/codecgen/ (NOT codecgen/), so they never shadow or
    # collide with the committed codecgen/ sources that :codecs compiles on
    # both architectures.
    target_compatible_with = ["@platforms//cpu:aarch64"],
    tools = [
        "//third_party/protobuf-c:protoc_gen_c_tool",
        "//third_party/protobuf-c:protoc_tool",
    ],
)

write_source_files(
    name = "write_codecs",
    diff_test = False,
    files = {
        "codecgen/%s" % f: "//third_party/containerd-api:generated/codecgen/%s" % f
        for pair in CODEC_PAIRS
        for f in pair
    },
    tags = ["manual"],
)

# ---------------------------------------------------------------------------
# Committed codecs -> cc_library
# ---------------------------------------------------------------------------
# srcs/hdrs resolve to the COMMITTED codecgen/ files for both arches: the
# :codegen genrule's outs live under generated/codecgen/, so no generated
# label shadows these committed paths. amd64 compiles the committed sources
# directly (never runs codegen); arm64 does the same, and the committed
# sources are byte-identical to what the deterministic codegen would emit.
cc_library(
    name = "codecs",
    srcs = ["codecgen/%s" % f for pair in CODEC_PAIRS for f in pair],
    hdrs = ["codecgen/%s" % f for pair in CODEC_PAIRS for f in pair],
    includes = ["codecgen"],
    # Static-only (same pattern as //third_party/libwebsockets): disable the
    # .so so the amd64 clang toolchain doesn't try to link a shared object
    # against the static-only @amd64_sysroot (it has no libgcc_s.so.1) and
    # consumers never pick a hidden-visibility .so. The controller links this
    # statically (-static), so only libcodecs.a is ever consumed.
    features = ["-supports_dynamic_linker"],
    target_compatible_with = select({
        "//tools/bazel:is_amd64_target": [],
        "//tools/bazel:is_arm64_target": ["@platforms//cpu:aarch64"],
        "//conditions:default": ["@platforms//cpu:aarch64"],
    }),
    deps = ["//third_party/protobuf-c:runtime"],
)

# Round-trip test: encode a types/task Process, decode it, compare fields.
cc_test(
    name = "codecs_roundtrip_test",
    srcs = ["roundtrip_test.c"],
    # Static-only (same pattern as //third_party/libwebsockets:lws_smoke_test):
    # the amd64 clang toolchain links against the static-only @amd64_sysroot,
    # which has no dynamic libgcc_s.so.1, so the test links its deps'
    # static archives instead of preferring .so outputs.
    linkstatic = True,
    linkopts = [
        "-lm",
        "-ldl",
        "-lpthread",
        "-static",
    ],
    target_compatible_with = select({
        "//tools/bazel:is_amd64_target": [],
        "//tools/bazel:is_arm64_target": ["@platforms//cpu:aarch64"],
        "//conditions:default": ["@platforms//cpu:aarch64"],
    }),
    deps = [":codecs"],
)