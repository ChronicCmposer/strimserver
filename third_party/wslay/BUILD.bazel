# In-repo package for the wslay smoke test. The library itself is built in
# the fetched @wslay repo by BUILD.wslay.

load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

exports_files(
    ["BUILD.wslay", "config.h", "pin.json"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "wslay_smoke_test",
    srcs = ["wslay_smoke_test.c"],
    linkstatic = True,
    linkopts = ["-static"],
    target_compatible_with = select({
        "//tools/bazel:is_amd64_target": [],
        "//tools/bazel:is_arm64_target": ["@platforms//cpu:aarch64"],
        "//conditions:default": ["@platforms//cpu:aarch64"],
    }),
    deps = ["@wslay//:wslay"],
)
