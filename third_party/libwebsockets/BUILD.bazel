# Vendored libwebsockets v5.0.0 (MIT), static server-only build.
#
# The vendored C sources are compiled directly by Bazel's C++ toolchain for
# the TARGET platform — aarch64 via the native toolchain, x86-64 via the
# clang cross-toolchain registered in MODULE.bazel (//tools/bazel/toolchains)
# — instead of a host-cmake genrule. This is the arch-correct fix: the old
# cmake genrule compiled the sources on the exec host (aarch64) and produced
# an aarch64 libwebsockets.a that could never link into an amd64 controller.
# Now the archive is built for whatever platform the target requests.
#
# Control-plane feature set (identical to what the old cmake build enabled):
# static only, no SSL, no HTTP/2, no zlib, no client, H1 + WS roles. The
# controller image ships glibc (libc6 FROM scratch), so the static lib links
# -lm -ldl -lpthread.
#
# Config generation: the vendored sources #include "lws_config.h" and
# "lws_config_private.h". These used to be emitted by a cmake configure step
# on the exec host; the generated headers are target-arch independent (pure
# feature defines, no arch-specific values), so they are COMMITTED here as
# static source files under lwsgen/ (same pattern as the committed
# containerd-api codecgen codecs). Regenerate only when the feature set
# changes: run the cmake configure with the same flags (see git history of
# this file for the old genrule) and copy the two headers out of the build
# tree.
#
# Dual-arch: the cc_library below compiles for both linux_amd64 (via the
# registered clang cross-toolchain) and linux_arm64 (via the native aarch64
# toolchain). The target_compatible_with select names both arches explicitly
# (amd64: no constraint; arm64: aarch64) and keeps any third platform
# arm64-only, matching the pre-amd64-port behavior.

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# The vendored .c files (the exact set the old cmake build compiled) plus the
# vendored internal headers, both exposed from @libwebsockets (see the
# build_file_content in MODULE.bazel). The lwsgen/ config headers are
# committed source files in this package; consumers get -I lwsgen so the
# `#include "lws_config.h"` inside libwebsockets.h resolves.
cc_library(
    name = "libwebsockets",
    srcs = ["@libwebsockets//:libwebsockets_sources"],
    hdrs = [
        "lwsgen/lws_config.h",
        "lwsgen/lws_config_private.h",
    ],
    includes = ["lwsgen"],
    # Static-only (matches LWS_WITH_SHARED=OFF): disable the .so so the
    # amd64 clang toolchain doesn't try to link a shared object against the
    # static-only sysroot (it has no libgcc_s.so.1) and consumers never pick
    # a hidden-visibility .so.
    features = ["-supports_dynamic_linker"],
    # Same compile definitions the cmake build used (C_DEFINES = -DLWS_BUILDING_STATIC
    # plus the warning flags from flags.make). -Werror is deliberately dropped:
    # the old build ran only the host gcc; the amd64 build runs clang, which may
    # warn differently, so keeping -Werror would break the cross build.
    copts = [
        "-DLWS_BUILDING_STATIC",
        "-Wno-deprecated-declarations",
        "-Wno-deprecated",
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
        "-Wconversion",
        "-Wsign-compare",
        "-Wstrict-aliasing",
        "-Wundef",
        "-Wuninitialized",
        "-Wtype-limits",
        "-Wignored-qualifiers",
        "-fvisibility=hidden",
    ],
    target_compatible_with = select({
        "//tools/bazel:is_amd64_target": [],
        "//tools/bazel:is_arm64_target": ["@platforms//cpu:aarch64"],
        "//conditions:default": ["@platforms//cpu:aarch64"],
    }),
    deps = [
        "@libwebsockets//:include",
        "@libwebsockets//:libwebsockets_internal_headers",
    ],
)

# Kept so //third_party:phase3a_gate still resolves (it references the old
# genrule target name); a filegroup over the compiled library is the same
# "buildable artifact" for the gate's purposes.
filegroup(
    name = "libwebsockets_static",
    srcs = [":libwebsockets"],
    target_compatible_with = select({
        "//tools/bazel:is_amd64_target": [],
        "//tools/bazel:is_arm64_target": ["@platforms//cpu:aarch64"],
        "//conditions:default": ["@platforms//cpu:aarch64"],
    }),
)

cc_test(
    name = "lws_smoke_test",
    srcs = ["lws_smoke_test.c"],
    # Static-only (matches the LWS_WITH_SHARED=OFF build; the controller image
    # is FROM scratch, and the amd64 clang toolchain links against the
    # static-only @amd64_sysroot, so there is no dynamic libc/libm to link).
    # Bazel would otherwise prefer the library's .so, whose symbols are hidden
    # by -fvisibility=hidden.
    linkstatic = True,
    linkopts = [
        "-lm",
        "-ldl",
        "-lpthread",
        "-static",
    ],
    target_compatible_with = select({
        "//tools/bazel:is_amd64_target": [],
        "//tools/bazel:is_arm64_target": ["@platforms//cpu:aarch64"],
        "//conditions:default": ["@platforms//cpu:aarch64"],
    }),
    deps = [":libwebsockets"],
)

# The HTTP/ws server binary used by the smoke test (also useful standalone).
cc_binary(
    name = "lws_server",
    srcs = ["lws_smoke_test.c"],
    defines = ["STANDALONE_SERVER"],
    # Static-only: same rationale as lws_smoke_test.
    linkstatic = True,
    linkopts = [
        "-lm",
        "-ldl",
        "-lpthread",
        "-static",
    ],
    target_compatible_with = select({
        "//tools/bazel:is_amd64_target": [],
        "//tools/bazel:is_arm64_target": ["@platforms//cpu:aarch64"],
        "//conditions:default": ["@platforms//cpu:aarch64"],
    }),
    deps = [":libwebsockets"],
)