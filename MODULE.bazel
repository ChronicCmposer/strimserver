"""strimserver: four OCI images + a Stream Deck plugin, built with Bazel."""

module(
    name = "strimserver",
    version = "0.0.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_cc", version = "0.1.1")

# --- Go controller -----------------------------------------------------------
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rules_distroless", version = "0.9.4")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "rules_nodejs", version = "6.7.5")

# aspect_bazel_lib's own MODULE.bazel unconditionally registers a bats-core
# toolchain (used by lib:bats.bzl, which nothing here uses) fetched from
# GitHub's codeload /archive/ endpoint. That endpoint 403s from this sandbox
# (unlike normal releases/download assets, which work fine), and eager
# toolchain registration means it's fetched even though it's unused. Patch it
# out rather than let an unused toolchain block every build.
single_version_override(
    module_name = "aspect_bazel_lib",
    patch_strip = 1,
    patches = ["//tools/bazel/patches:aspect_bazel_lib_no_bats.patch"],
    version = "2.22.5",
)

# aspect_bazel_lib depends on its own renamed successor module, which
# registers the same bats-core toolchain independently -- patch it out too.
# Pinned to 3.7.2 (not aspect_bazel_lib's own 3.0.0 floor): aspect_rules_js
# requires bazel_lib >= 3.7.0, and single_version_override forces bzlmod's
# normal max-version selection to exactly the version given here, so this
# has to track whatever the highest real requirement in the graph is.
single_version_override(
    module_name = "bazel_lib",
    patch_strip = 1,
    patches = ["//tools/bazel/patches:bazel_lib_no_bats.patch"],
    version = "3.7.2",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//core/controller:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//core/controller:go.mod")
use_repo(
    go_deps,
    "com_github_coder_websocket",
    "com_github_containerd_containerd_api",
    "com_github_containerd_containerd_v2",
    "com_github_containerd_errdefs",
    "com_github_containerd_typeurl_v2",
    "com_github_opencontainers_runtime_spec",
)

# golangci-lint pinned as a downloaded release tarball (checksummed) instead
# of `go install`ed over the network on every lint-enabled build.
#
# v2.13.2 (module path github.com/golangci/golangci-lint/v2) is required: the
# old v1 line stopped at v1.64.8 and refuses to analyze a go.mod declaring a
# newer Go version than it was built with, so it cannot lint this module's
# `go 1.26.4`. See the "version: 2" line added to .golangci.yml alongside
# this pin. The amd64/arm64 tarballs are both pinned; core/controller's lint
# sh_test selects the one matching the target platform (the test runs on the
# target platform via --use_target_platform_for_tests).
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

s3_http_archive = use_repo_rule("//tools/bazel:s3_download.bzl", "s3_http_archive")

s3_http_file = use_repo_rule("//tools/bazel:s3_download.bzl", "s3_http_file")

# The buildkit-direct-execve patched qemu-x86_64 as a Bazel tool (used by
# core/BUILD.bazel's mediamtx cross-strip genrule on non-x86_64 hosts).
# Lazily fetched: nothing references @qemu_x86_64_patched on amd64 builds
# (the genrule selects it away), so an amd64 host never builds qemu.
qemu_x86_64 = use_repo_rule("//tools/bazel:qemu_x86_64.bzl", "qemu_x86_64")

qemu_x86_64(name = "qemu_x86_64_patched")

http_archive(
    name = "golangci_lint_linux_amd64",
    build_file_content = "exports_files([\"golangci-lint\"])",
    sha256 = "2277d43b98ec0054280f2ac26b53268bae97682444678a59a657dd565da021d6",
    strip_prefix = "golangci-lint-2.13.2-linux-amd64",
    url = "https://github.com/golangci/golangci-lint/releases/download/v2.13.2/golangci-lint-2.13.2-linux-amd64.tar.gz",
)

http_archive(
    name = "golangci_lint_linux_arm64",
    build_file_content = "exports_files([\"golangci-lint\"])",
    sha256 = "a2a4e0065aa41be71f7c5ac90f271b61751331e5d04314e62afe4027855f0893",
    strip_prefix = "golangci-lint-2.13.2-linux-arm64",
    url = "https://github.com/golangci/golangci-lint/releases/download/v2.13.2/golangci-lint-2.13.2-linux-arm64.tar.gz",
)

# --- Debian donor packages for the FROM-scratch images ----------------------
# The runtime debs below come from a snapshot.debian.org timestamp instead of
# a rolling mirror, per rules_distroless's own reproducibility guidance.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    # Both donor architectures are declared so the apt extension resolves every
    # install package below for amd64 AND arm64, generating @trixie//<pkg>/<arch>:data
    # targets for both (rules_distroless resolves un-arch-suffixed install
    # packages for every architecture the sources_list declares).
    architectures = [
        "amd64",
        "arm64",
    ],
    components = [
        "main",
        "contrib",
        "non-free",
        "non-free-firmware",
    ],
    suites = ["trixie"],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian/20260824T082821Z"],
)
apt.install(
    dependency_set = "trixie",
    packages = [
        # Runtime shell for the controller image.
        "dash",
        # Runtime debs for the ffmpeg and mediamtx images (libfdk-aac2t64
        # resolves because the sources_list above already declares non-free).
        "busybox-static",
        "gettext-base",
        "ca-certificates",
        "libfdk-aac2t64",
        # glibc (ld-linux, libc/libm/libpthread/libresolv.so) and nice (a
        # coreutils binary a debian:trixie-slim image ships pre-installed;
        # Bazel has to ask for it by name).
        "libc6",
        "coreutils",
        # amd64 GNU strip (x86_64-linux-gnu-strip) plus its runtime closure
        # (libbinutils/libsframe1/zlib1g/libzstd1/libgcc-s1): a Bazel tool
        # used to cross-strip the amd64 mediamtx binary on non-x86_64 hosts,
        # running under the patched qemu-x86_64. The whole closure is listed
        # as direct packages because the apt extension only generates a
        # package dir (with a :data target) for directly-listed packages; a
        # package present only transitively yields a bare filemap repo with
        # no :data to point a deb_file at. Only the amd64 variant is ever
        # used (the strip genrule runs it as a tool, so it is built for the
        # *exec* platform, and qemu-x86_64 needs an amd64 ELF strip); the
        # arm64 variant exists in @trixie but is deliberately not wired.
        "libbinutils",
        "libsframe1",
        "zlib1g",
        "libzstd1",
        "libgcc-s1",
        "binutils-x86-64-linux-gnu",
    ],
    suites = ["trixie"],
)
use_repo(apt, "trixie")

# --- Vendored C layer (Phase 3a: ARM controller C infrastructure) ----------
# The ARM64 assembly controller drives a vendored C layer for protocol work:
# protobuf-c (protobuf wire format), generated containerd codecs, and
# libwebsockets (HTTP/1.1 + WebSocket server). All four sources are pinned
# http_archive downloads (sha256-verified), matching the repo's existing
# artifact-pinning conventions (golangci-lint, mediamtx, ffmpeg). The codegen
# dev debs (libprotobuf-dev / libprotoc-dev / protobuf-compiler) are extracted
# from the SAME snapshot.debian.org timestamp the @trixie apt extension above
# uses, via the deb_extract repo rule below.
#
# Everything here is arm64-target-only: the assembly controller is ARM-only,
# so the vendored C targets carry target_compatible_with = aarch64. amd64
# wildcard builds skip them (kept buildable; the existing amd64 Go controller
# never links the C layer), and arm64 builds genuinely compile them. See
# third_party/*/BUILD.bazel.

# protobuf-c v1.5.2 (BSD-2), patched twice:
#   1. protobuf_c_protobuf34_compat.patch — upstream commit d39f001b
#      ("Fix compilation against protobuf v34"): replaces the 8
#      FieldDescriptor::label() call sites (removed in libprotobuf >= 34)
#      with a FieldLabel() helper. Mandatory when building protoc-gen-c
#      against libprotobuf >= 34; harmless (and still applied) for the
#      3.21.12 libprotobuf the trixie snapshot ships.
#   2. protobuf_c_proto3_optional_feature.patch — declares
#      FEATURE_PROTO3_OPTIONAL in GetSupportedFeatures() so protoc permits
#      containerd protos using the proto3 `optional` keyword (images.proto,
#      fieldpath.proto). protobuf-c encodes those fields with LABEL_NONE
#      semantics, which is wire-compatible with proto3 optional presence.
http_archive(
    name = "protobuf_c",
    build_file = "//third_party/protobuf-c:BUILD.protobuf-c",
    patch_strip = 1,
    patches = [
        "//tools/bazel/patches:protobuf_c_protobuf34_compat.patch",
        "//tools/bazel/patches:protobuf_c_proto3_optional_feature.patch",
    ],
    sha256 = "e2c86271873a79c92b58fef7ebf8de1aa0df4738347a8bd5d4e65a80a16d0d24",
    strip_prefix = "protobuf-c-1.5.2",
    url = "https://github.com/protobuf-c/protobuf-c/releases/download/v1.5.2/protobuf-c-1.5.2.tar.gz",
)

# protoc v36.2 binaries, one per exec-arch. Codegen runs on the exec
# platform (the host), so a host's protoc must match its architecture; both
# zips are pinned and the codegen genrule selects by exec platform.
# (protoc 36.2 is the pinned codegen protoc; the @trixie protobuf-compiler
# deb is used separately to generate the plugin's own protobuf-c.pb.cc at the
# 3.21.12 libprotobuf version the plugin links.)
http_archive(
    name = "protoc_linux_aarch64",
    build_file = "//third_party/protobuf-c:BUILD.protoc",
    sha256 = "8b8f18bd2b30346efbc698dd5a73dd7c805f3ef8380f6dfc95c768f3f1852f6a",
    url = "https://github.com/protocolbuffers/protobuf/releases/download/v36.2/protoc-36.2-linux-aarch_64.zip",
)

http_archive(
    name = "protoc_linux_x86_64",
    build_file = "//third_party/protobuf-c:BUILD.protoc",
    sha256 = "121f6c7afe1d4d0e3ea6aab9432038599250134cbf4474cb1167d2c7decd4278",
    url = "https://github.com/protocolbuffers/protobuf/releases/download/v36.2/protoc-36.2-linux-x86_64.zip",
)

# containerd API protos v1.12.0 (Apache-2.0), the api/ subtree of the
# containerd repo (its own Go module github.com/containerd/containerd/api).
# All protos are gogoproto-free and import only google/protobuf + types/*;
# codegen uses this tree plus protoc's bundled well-known-type protos.
http_archive(
    name = "containerd_api",
    build_file = "//third_party/containerd-api:BUILD.containerd-api",
    sha256 = "6978892e8ab09b36f5c09311f856ae07411cd9efd76a5213d125a733f08753fa",
    strip_prefix = "containerd-api-v1.12.0",
    url = "https://github.com/containerd/containerd/archive/refs/tags/api/v1.12.0.tar.gz",
)

# libwebsockets v5.0.0 (MIT), static server-only build. Built by a genrule
# (cmake) in third_party/libwebsockets/BUILD.bazel; the image ships glibc
# (libc6 FROM scratch), so the static lib links -lm -ldl -lpthread. The
# upstream archive ships 12 self-referential `libwebsockets` symlinks under
# minimal-examples/embedded/ that loop back to the repo root; the
# tarball_strip_symlinks repo rule deletes them at fetch time (Bazel's
# patches mechanism cannot delete symlinks).
tarball_strip_symlinks = use_repo_rule(
    "//tools/bazel:tarball_strip_symlinks.bzl",
    "tarball_strip_symlinks",
)

tarball_strip_symlinks(
    name = "libwebsockets",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")
filegroup(
    name = "srcs",
    srcs = glob(
        ["**/*"],
        exclude = [".github/**", ".gitignore", ".gitmodules", ".clangd", ".gitattributes"],
    ),
    visibility = ["//visibility:public"],
)
filegroup(
    name = "root_anchor",
    srcs = ["CMakeLists.txt"],
    visibility = ["//visibility:public"],
)
# The vendored public headers (libwebsockets.h + libwebsockets/*.h). Compile
# consumers with -I<this repo>/include so `#include <libwebsockets.h>` works.
cc_library(
    name = "include",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "f853c6582101cfcee3a5a9e28ae92ab19d9735c5f31f0bb2e9794b5106123962",
    strip_prefix = "libwebsockets-5.0.0",
    url = "https://github.com/warmcat/libwebsockets/archive/refs/tags/v5.0.0.tar.gz",
)

# Build-time dev debs for the protoc-gen-c plugin, pinned to the same
# snapshot.debian.org timestamp as the @trixie apt extension above. Extracted
# by tools/bazel/deb_extract.bzl (ar + tar) into static libs + headers that
# the plugin's cc_binary links. arm64 debs only: the plugin is a codegen tool
# that runs on the exec platform, and this host is aarch64; an amd64 exec
# host would add the matching amd64 pins.
deb_extract = use_repo_rule("//tools/bazel:deb_extract.bzl", "deb_extract")

deb_extract(
    name = "libprotobuf_dev_arm64",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(
    name = "libprotobuf",
    srcs = ["usr/lib/aarch64-linux-gnu/libprotobuf.a"],
    hdrs = glob(["usr/include/google/protobuf/**"]),
    includes = ["usr/include"],
    linkopts = ["-lz"],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "26e311a867ef831d2378a33e772b1f21924261eedcefe08f7ce852c6176c2836",
    url = "https://snapshot.debian.org/archive/debian/20260824T082821Z/pool/main/p/protobuf/libprotobuf-dev_3.21.12-11+deb13u1_arm64.deb",
)

deb_extract(
    name = "libprotoc_dev_arm64",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(
    name = "libprotoc",
    srcs = ["usr/lib/aarch64-linux-gnu/libprotoc.a"],
    hdrs = glob(["usr/include/google/protobuf/**"]),
    includes = ["usr/include"],
    visibility = ["//visibility:public"],
    deps = ["@libprotobuf_dev_arm64//:libprotobuf"],
)
""",
    sha256 = "405ec6e7b5dd99b73a84f4671af03b0b0d94b4a372c36a49c0f94457f40b36a9",
    url = "https://snapshot.debian.org/archive/debian/20260824T082821Z/pool/main/p/protobuf/libprotoc-dev_3.21.12-11+deb13u1_arm64.deb",
)

deb_extract(
    name = "protobuf_compiler_arm64",
    build_file_content = """
exports_files(["usr/bin/protoc"])
""",
    sha256 = "a873f75cbdf8054a23687e7c9b39ca1a93545edd22a581f4caa560756678f658",
    url = "https://snapshot.debian.org/archive/debian/20260824T082821Z/pool/main/p/protobuf/protobuf-compiler_3.21.12-11+deb13u1_arm64.deb",
)

# --- iperf3 image (rules_oci, keeping the alpine base) ----------------------
# Bazel assembles the image from the digest-pinned alpine base plus two tar
# layers (see tools/bandwidth-test/BUILD.bazel). fish is dropped: the
# entrypoint only runs `iperf3 -s`, and fish's closure would add 5 packages.
# The pinned digest is the multi-arch index; rules_oci resolves the per-arch
# child (amd64 59855d3dceb3... / arm64 1529d13528ed...) from the same index.
# NOTE: the index's arm64 entry carries variant "v8", so the platform string
# must be linux/arm64/v8 (rules_oci matches os+arch+variant exactly); the
# generated repo is @alpine_linux_arm64_v8.
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "alpine",
    digest = "sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659",
    image = "docker.io/library/alpine",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
use_repo(oci, "alpine", "alpine_linux_amd64", "alpine_linux_arm64_v8")

# The iperf3 package (3.19.1-r1) as a single .apk, pinned per architecture
# (the x86_64 apk and the aarch64 apk are different files). Each apk's only
# runtime deps (musl, libcrypto.so.3) are already in the matching alpine
# base, so one apk + the base is the whole closure; the genrule in
# tools/bandwidth-test/BUILD.bazel extracts the selected apk's data.tar.gz
# payload into the image's first layer.
http_file(
    name = "iperf3_apk",
    sha256 = "c8fa78ac30761d2dc47d5db7b9056a3b5cfdd565af173a4be1e4449a6b7fd664",
    urls = ["https://dl-cdn.alpinelinux.org/alpine/v3.23/main/x86_64/iperf3-3.19.1-r1.apk"],
)

http_file(
    name = "iperf3_apk_arm64",
    sha256 = "da2a7b7eaaa0fc1427897999578cef7deb9b283fe220ac0ae38f80e1fc584199",
    urls = ["https://dl-cdn.alpinelinux.org/alpine/v3.23/main/aarch64/iperf3-3.19.1-r1.apk"],
)

# --- MediaMTX ----------------------------------------------------------
# Fetched via http_archive so the binary download is checksummed (a bare
# `wget` would not verify it). One dist per architecture; the strip genrule
# in core/BUILD.bazel selects the matching one as its src.
http_archive(
    name = "mediamtx_dist",
    build_file_content = "exports_files([\"mediamtx\"])",
    sha256 = "e02e34c3337a35f20ac9e5aa31524566108964e6e37dbc46cf8292169f6c792b",
    url = "https://github.com/bluenviron/mediamtx/releases/download/v1.21.0/mediamtx_v1.21.0_linux_amd64.tar.gz",
)

http_archive(
    name = "mediamtx_dist_arm64",
    build_file_content = "exports_files([\"mediamtx\"])",
    sha256 = "a8113b5928ba1a934b81557b61b8a07954b76921a4b567d54c7f086f8b39d9a2",
    url = "https://github.com/bluenviron/mediamtx/releases/download/v1.21.0/mediamtx_v1.21.0_linux_arm64.tar.gz",
)

# --- FFmpeg -------------------------------------------------------------
# The ffmpeg binary is built out-of-band by tools/ffmpeg-dist/publish.sh
# (compiling FFmpeg against CUDA needs nvcc, not a GPU; see README.md's
# "FFmpeg reproducibility and artifact pipeline" section). S3 is the
# canonical source; the GitHub Release asset is a mirror. The sha256 is the
# integrity pin. The S3 bucket and region come from the STRIMSERVER_S3_BUCKET
# / STRIMSERVER_S3_REGION env vars (no committed defaults); when they are
# unset, the GitHub Release mirror below is used.
#
# TODO(arm64): @ffmpeg_dist is the amd64 build (linux-x86_64, sm_75 CUDA
# arch). An arm64 ffmpeg (linux-sbsa, sm_75) must be built by the out-of-band
# tools/ffmpeg-dist pipeline; when it is produced, add an ffmpeg_dist_arm64
# pin here and make core/BUILD.bazel's ffmpeg_image srcs/architecture select
# it per target architecture (the lib paths are already selectable via the
# @trixie deb_file wiring).
s3_http_archive(
    name = "ffmpeg_dist",
    build_file_content = 'exports_files(["ffmpeg", "BUILD-INFO.txt"])',
    mirror_urls = ["https://github.com/ChronicCmposer/strimserver/releases/download/ffmpeg-artifacts/ffmpeg-8.1-deb20260824-cuda13.2.2-sm75-1a748fe.tar.gz"],
    s3_key = "ffmpeg/ffmpeg-8.1-deb20260824-cuda13.2.2-sm75-1a748fe.tar.gz",
    sha256 = "44021ca11d9c5a3f1921b57150dfe68562cb291658afbef40b231a3554a82120",
)

# --- Offline fallback segment ----------------------------------------------
# The 2160p60 HEVC/AAC fallback clip is produced out-of-band on macOS by
# tools/brb-screen/publish.sh generate (hevc_videotoolbox + aac_at are
# VideoToolbox/AudioToolbox codecs, so the encode cannot run inside the Bazel
# graph), then uploaded to S3 by tools/brb-screen/publish.sh upload <path>
# on a Linux host with AWS credentials. S3 is the canonical source; the
# GitHub Release asset is a mirror. The sha256 is the integrity pin. The S3
# bucket and region come from the STRIMSERVER_S3_BUCKET / STRIMSERVER_S3_REGION
# env vars (no committed defaults); when they are unset, the GitHub Release
# mirror below is used.
# Pin updated by running the two-phase publish; see README's Build
# instructions.
s3_http_file(
    name = "offline_segment_dist",
    downloaded_file_name = "strimserver-offline-2160p60.mp4",
    mirror_urls = ["https://github.com/ChronicCmposer/strimserver/releases/download/offline-segment/strimserver-offline-2160p60.mp4"],
    s3_key = "offline/strimserver-offline-2160p60.mp4",
    sha256 = "05ff15e41a61e9478b005135699a130e21a7efab21b6a1bcae1aa30bd3182f7d",
)

# --- OpenSSH RPM -----------------------------------------------------------
# The experimental OpenSSH RPM is built out-of-band by tools/openssh/build.sh
# inside an amazonlinux:2023 chroot run by tools/openssh/publish.sh (the
# rpmbuild pipeline cannot be expressed in rules_oci -- the same reason
# @ffmpeg_dist is prebuilt); on non-amd64 hosts the chroot runs under a
# buildkit-direct-execve patched qemu-x86_64 pinned to qemu 9.2.4. S3 is the
# canonical source; the GitHub Release asset (tag openssh-dist) is a mirror.
# The sha256 is the integrity pin. The S3 bucket and region come from the
# STRIMSERVER_S3_BUCKET / STRIMSERVER_S3_REGION env vars (no committed
# defaults); when they are unset, the GitHub Release mirror below is used.
# The published asset is a bare .rpm (no archive suffix), so it is fetched
# with s3_http_file's root-addressable exports_files mode (build_file_content
# set) rather than s3_http_archive: it mirrors the @ffmpeg_dist/@mediamtx_dist
# exports_files pattern while being a bare-file download. exports_files gives
# the RPM the @openssh_dist//:openssh-experimental.rpm label, and the
# now-redundant tools/openssh/BUILD.bazel filegroup wrapper is gone.
#
# TODO(arm64): @openssh_dist is the amd64 build. An arm64 openssh requires an
# aarch64 amazonlinux chroot rebuild (out-of-band by tools/openssh/build.sh);
# when the pipeline produces it, add an openssh_dist_arm64 pin here and make
# the //:bundle_openssh_rpm member select() per target architecture. The RPM
# ships in the deployment bundle as a host-side artifact, so until then there
# is nothing to select -- the amd64 RPM is the only artifact.
s3_http_file(
    name = "openssh_dist",
    build_file_content = 'exports_files(["openssh-experimental.rpm"])',
    downloaded_file_name = "openssh-experimental.rpm",
    mirror_urls = ["https://github.com/ChronicCmposer/strimserver/releases/download/openssh-dist/openssh-experimental.rpm"],
    s3_key = "openssh/openssh-experimental.rpm",
    sha256 = "698ccebf9a35c730c4fd402bdfb7f3473613e06a4edf2d2971460b82e65d2bab",
)

# --- Stream Deck plugin (rollup) ------------------------------------------
# Node version comes from tools/streamdeck-plugin/.nvmrc via
# node_version_from_nvmrc (rules_nodejs 6.7.5 supports it; its
# _verify_version_is_valid requires a full major.minor.patch, so .nvmrc now
# carries "24.13.0" rather than a bare major like "24"). Matches
# package.json's ">=24".
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version_from_nvmrc = "//tools/streamdeck-plugin:.nvmrc")

# npm_translate_lock uses pnpm_lock (pnpm-lock.yaml) because aspect_rules_js
# 3.4.1's npm_package_lock path is broken in two distinct ways: the bzlmod
# extension crashes on npm_package_lock, and even patched, the link targets
# for node_modules/typescript, tslib, and @types/node point at files that are
# never populated. pnpm_lock is the well-supported path. The lockfile is
# generated from package.json via `pnpm import` (the npm lockfile was deleted
# when the plugin consolidated on pnpm alone).
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//tools/streamdeck-plugin:pnpm-lock.yaml",
)
use_repo(npm, "npm")
