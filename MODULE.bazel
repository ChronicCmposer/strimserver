"""strimserver: five OCI images + a Stream Deck plugin, built with Bazel."""

module(
    name = "strimserver",
    version = "0.0.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_shell", version = "0.8.0")

# --- Go controller -----------------------------------------------------------
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.53.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rules_distroless", version = "0.9.4")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")

# aspect_rules_js 3.4.1's npm_translate_lock bzlmod extension has a bug:
# _npm_translate_lock_bzlmod unconditionally reads attr.pnpm_lock.repo_name
# to compute link_workspace, crashing with "'NoneType' value has no field or
# method 'repo_name'" for any npm_translate_lock configured with
# npm_package_lock (this repo's case) or yarn_lock instead of pnpm_lock.
# Verified against the pristine 3.4.1 release source, not just the fetched
# copy. Patches the same bug fixed upstream would need: read whichever lock
# attribute is actually set.
single_version_override(
    module_name = "aspect_rules_js",
    version = "3.4.1",
    patches = ["//tools/bazel/patches:aspect_rules_js_npm_package_lock_link_workspace.patch"],
    patch_strip = 1,
)
bazel_dep(name = "rules_nodejs", version = "6.7.3")

# aspect_bazel_lib's own MODULE.bazel unconditionally registers a bats-core
# toolchain (used by lib:bats.bzl, which nothing here uses) fetched from
# GitHub's codeload /archive/ endpoint. That endpoint 403s from this sandbox
# (unlike normal releases/download assets, which work fine), and eager
# toolchain registration means it's fetched even though it's unused. Patch it
# out rather than let an unused toolchain block every build.
single_version_override(
    module_name = "aspect_bazel_lib",
    version = "2.22.5",
    patches = ["//tools/bazel/patches:aspect_bazel_lib_no_bats.patch"],
    patch_strip = 1,
)

# aspect_bazel_lib depends on its own renamed successor module, which
# registers the same bats-core toolchain independently -- patch it out too.
# Pinned to 3.7.0 (not aspect_bazel_lib's own 3.0.0 floor): aspect_rules_js
# requires bazel_lib >= 3.7.0, and single_version_override forces bzlmod's
# normal max-version selection to exactly the version given here, so this
# has to track whatever the highest real requirement in the graph is.
single_version_override(
    module_name = "bazel_lib",
    version = "3.7.0",
    patches = ["//tools/bazel/patches:bazel_lib_no_bats.patch"],
    patch_strip = 1,
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//core/controller:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//core/controller:go.mod")
use_repo(
    go_deps,
    "com_github_coder_websocket",
    "com_github_containerd_containerd_api",
    "com_github_containerd_containerd_v2",
    "com_github_containerd_errdefs",
    "com_github_containerd_typeurl_v2",
    "com_github_opencontainers_runtime_spec",
)

# golangci-lint pinned as a downloaded release tarball (checksummed) instead
# of `go install`ed over the network on every lint-enabled build.
#
# core/controller/Dockerfile:29 (and feature-toggles.env's ENABLE_LINT path)
# pins v1.64.8, but that predates Go 1.26 entirely: golangci-lint refuses to
# analyze a go.mod declaring a newer Go version than it was built with, so
# v1.64.8 cannot lint this module's `go 1.26.4` (verified: it fails with
# "the Go language version (go1.24) ... is lower than the targeted Go version
# (1.26.4)"). golangci-lint v1 stopped at v1.64.8; v2+ is a different module
# path (github.com/golangci/golangci-lint/v2) with a new config schema, so
# picking up Go 1.26 support means moving to v2 -- see the "version: 2" line
# added to .golangci.yml alongside this pin.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "golangci_lint_linux_amd64",
    url = "https://github.com/golangci/golangci-lint/releases/download/v2.13.2/golangci-lint-2.13.2-linux-amd64.tar.gz",
    sha256 = "2277d43b98ec0054280f2ac26b53268bae97682444678a59a657dd565da021d6",
    strip_prefix = "golangci-lint-2.13.2-linux-amd64",
    build_file_content = "exports_files([\"golangci-lint\"])",
)

# --- Debian donor packages for the FROM-scratch images ----------------------
# Matches core/Dockerfile's and core/controller/Dockerfile's `libs` stages
# (both `debian:trixie-20260518-slim`). Pinned to a snapshot.debian.org
# timestamp near that image's build date instead of a rolling mirror, per
# rules_distroless's own reproducibility guidance.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")

apt.sources_list(
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian/20260518T203109Z"],
    suites = ["trixie"],
    components = ["main", "contrib", "non-free", "non-free-firmware"],
    architectures = ["amd64"],
)

apt.install(
    dependency_set = "trixie",
    suites = ["trixie"],
    packages = [
        # core/controller/Dockerfile's libs stage.
        "dash",
        # core/Dockerfile's libs stage, mediamtx target only (ffmpeg stays on
        # buildctl with its own unmodified Dockerfile stage -- see Phase 4).
        "busybox-static",
        "gettext-base",
        "ca-certificates",
        # glibc (ld-linux, libc/libm/libpthread/libresolv.so) and nice (a
        # coreutils binary the base debian:trixie-slim image ships
        # pre-installed, so the Dockerfile never apt-get installs it
        # explicitly -- Bazel has to ask for it by name).
        "libc6",
        "coreutils",
    ],
)

use_repo(apt, "trixie")

# --- MediaMTX ----------------------------------------------------------
# core/Dockerfile:142,150 fetched this with a bare `wget` and no checksum
# (bug #8) -- http_archive requires one, closing that gap.
http_archive(
    name = "mediamtx_dist",
    url = "https://github.com/bluenviron/mediamtx/releases/download/v1.17.0/mediamtx_v1.17.0_linux_amd64.tar.gz",
    sha256 = "97165888845f3a0a9bfeaa4b34bd19d72aa3f8d9abd39f9a02042c9fa434fb5a",
    build_file_content = "exports_files([\"mediamtx\"])",
)

# --- Stream Deck plugin (rollup) ------------------------------------------
# node_version_from_nvmrc can't parse tools/streamdeck-plugin/.nvmrc's bare
# major-version-only content ("24", a form nvm/fnm both accept and resolve
# to the latest matching release, but rules_nodejs's own parser requires a
# full major.minor.patch and crashes on anything less specific). Pinned
# explicitly instead of changing a file real developers run `nvm use`
# against; matches .nvmrc's own major version and package.json's ">=24".
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.13.0")

# npm_translate_lock's npm_package_lock path has real bugs in 3.4.1 (see the
# patch above) and appears to be a much less exercised code path than
# pnpm_lock -- hit a second, distinct failure (node_modules/typescript,
# tslib, and @types/node link targets pointing at files that were never
# actually populated) after patching the first. Rather than keep patching an
# upstream ecosystem this deep, generated tools/streamdeck-plugin/pnpm-lock.yaml
# from the committed package-lock.json via `pnpm import` (a standard,
# non-destructive, lossless conversion -- verified the package/version graph
# is identical) and used the well-supported pnpm_lock path instead.
# package-lock.json stays as the source of truth for plain `npm install`/
# `npm run build`; pnpm-lock.yaml is Bazel-only and regenerated the same way
# whenever package-lock.json changes.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//tools/streamdeck-plugin:pnpm-lock.yaml",
)
use_repo(npm, "npm")
