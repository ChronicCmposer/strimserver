load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# --- iperf3 image (Bazel-native rules_oci, KEEPING the alpine base) ----------
# The image is assembled from the digest-pinned alpine base
# (@alpine_linux_amd64 in MODULE.bazel) plus two tar layers:
#   1. iperf3_apk_layer.tar -- the iperf3 .apk payload (usr/bin/iperf3 +
#      usr/lib/libiperf.so.0*), extracted from the pinned @iperf3_apk, and
#   2. iperf3_env_tar -- the entrypoint + env files at /opt/.
# fish is dropped entirely: nothing at runtime uses it (entrypoint.sh only
# runs `iperf3 -s`), and its closure would add 5 packages (~13MB).

# The .apk (Alpine v3.23 format) is a gzipped tar carrying .PKGINFO, a .SIGN*
# signature, and the payload under usr/. Exclude the metadata members and
# re-tar the payload into a single layer. The apk's payload is already owned
# by root:root with correct modes (0755 bin/lib); --owner/--group re-assert
# root ownership and --sort=name gives deterministic member order.
genrule(
    name = "iperf3_apk_layer",
    srcs = ["@iperf3_apk//file"],
    outs = ["iperf3_apk_layer.tar"],
    cmd = """
      apk="$(location @iperf3_apk//file)"
      tmp="$$(mktemp -d)"
      tar -xzf "$$apk" --exclude='.PKGINFO' --exclude='.SIGN*' -C "$$tmp" 2>/dev/null
      test -f "$$tmp/usr/bin/iperf3" || { echo "error: iperf3 apk extraction produced no usr/bin/iperf3" >&2; exit 1; }
      tar -cf "$@" --owner=0 --group=0 --numeric-owner --sort=name -C "$$tmp" usr
      rm -rf "$$tmp"
    """,
)

pkg_files(
    name = "iperf3_entrypoint",
    srcs = ["entrypoint.sh"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/opt",
    renames = {"entrypoint.sh": "iperf3-entrypoint.sh"},
)

pkg_files(
    name = "iperf3_env",
    srcs = ["iperf3.env"],
    attributes = pkg_attributes(mode = "0644"),
    prefix = "/opt",
)

pkg_tar(
    name = "iperf3_env_tar",
    srcs = [
        ":iperf3_entrypoint",
        ":iperf3_env",
    ],
)

# os/architecture come from the alpine base and cannot be overridden when
# `base` is set (rules_oci fails on the attempt); the base is amd64, matching
# .bazelrc's --platforms=//tools/bazel:linux_amd64.
oci_image(
    name = "iperf3_image",
    base = "@alpine_linux_amd64",
    tars = [
        ":iperf3_apk_layer",
        ":iperf3_env_tar",
    ],
    entrypoint = ["/opt/iperf3-entrypoint.sh"],
)

oci_load(
    name = "iperf3_image_tarball",
    image = ":iperf3_image",
    repo_tags = ["docker.io/library/iperf3:latest"],
)

# Promotes oci_load's named "tarball" output group (the raw OCI tar) into a
# plain filegroup so the deployment bundle can depend on it normally.
filegroup(
    name = "iperf3_image_tar_file",
    srcs = [":iperf3_image_tarball"],
    output_group = "tarball",
    visibility = ["//visibility:public"],
)

# --- iperf3 standalone deployment bundle (`make publish-iperf3`) -----------
# Bug 4: the Makefile's $(IPERF3_DEPLOYMENT_TAR) requires
# tools/bandwidth-test/{fish-deploy.sh,imdslib.sh,prompt_login.fish}, none of
# which exist there -- they live in deploy/aws/ (verified: `make
# publish-iperf3` fails with "No rule to make target
# 'tools/bandwidth-test/fish-deploy.sh'"). iperf-deploy.sh's own `source
# imdslib.sh` / `source fish-deploy.sh` lines are generic and work identically
# against the deploy/aws/ copies (verified: those files have no
# strimserver-specific content).

# All bundle entries land flat at the tar root, matching the Makefile's
# `tar --transform='s#iperf-deploy\.sh$#deploy.sh#'` (no directory transform
# is needed for the rest, since GNU tar was already invoking with each file
# individually named on the command line -- there is no other prefix here).
pkg_files(
    name = "iperf3_deploy_script",
    srcs = ["iperf-deploy.sh"],
    renames = {"iperf-deploy.sh": "deploy.sh"},
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "iperf3_deploy_helpers",
    srcs = [
        "//deploy/aws:fish-deploy.sh",
        "//deploy/aws:imdslib.sh",
        "//deploy/aws:prompt_login.fish",
    ],
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "iperf3_deploy_image",
    srcs = [":iperf3_image_tar_file"],
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "iperf3_deploy_misc",
    srcs = [
        "iperf3.env",
        "iperf3.service",
    ],
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "iperf3_deployment_tar",
    srcs = [
        ":iperf3_deploy_helpers",
        ":iperf3_deploy_image",
        ":iperf3_deploy_misc",
        ":iperf3_deploy_script",
    ],
    out = "iperf3-deployment.tar",
)

sh_binary(
    name = "publish_iperf3",
    srcs = ["publish_iperf3.sh"],
    data = [":iperf3_deployment_tar"],
    args = ["$(rootpath :iperf3_deployment_tar)"],
)