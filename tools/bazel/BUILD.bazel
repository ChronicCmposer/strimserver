platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    visibility = ["//visibility:public"],
)

# True when the *exec* platform is x86_64 (matches the host arch for
# genrules). Used by core/BUILD.bazel's mediamtx cross-strip genrule to run
# the native `strip` on amd64 hosts and select the qemu emulator tool away,
# so amd64 builds never fetch or build @qemu_x86_64_patched.
config_setting(
    name = "is_x86_64_exec",
    constraint_values = ["@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)

# True when the *target* platform is arm64. Lets BUILD files select() on the
# architecture the artifacts are being built for (via --platforms), which is
# independent of the exec platform (the host).
config_setting(
    name = "is_arm64_target",
    constraint_values = ["@platforms//cpu:aarch64"],
    visibility = ["//visibility:public"],
)

# True when the *target* platform is amd64. Mirrors is_arm64_target for the
# x86_64 side so select() branches can name both architectures explicitly.
config_setting(
    name = "is_amd64_target",
    constraint_values = ["@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)
