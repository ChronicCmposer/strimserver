platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
)

# True when the *exec* platform is x86_64 (matches the host arch for
# genrules). Used by core/BUILD.bazel's mediamtx cross-strip genrule to run
# the native `strip` on amd64 hosts and select the qemu emulator tool away,
# so amd64 builds never fetch or build @qemu_x86_64_patched.
config_setting(
    name = "is_x86_64_exec",
    constraint_values = ["@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)
