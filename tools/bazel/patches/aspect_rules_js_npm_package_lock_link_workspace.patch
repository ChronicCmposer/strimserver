+    # "'NoneType' value has no field or method 'repo_name'" for any
+    # npm_translate_lock configured with npm_package_lock (or yarn_lock)
+    # instead of pnpm_lock.
+    lock_label = attr.pnpm_lock if attr.pnpm_lock else (attr.npm_package_lock if attr.npm_package_lock else attr.yarn_lock)
+    link_workspace = "@" + lock_label.repo_name
 
