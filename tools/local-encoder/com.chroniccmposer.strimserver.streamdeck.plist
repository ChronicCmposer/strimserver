<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.chroniccmposer.strimserver.streamdeck — launch Elgato Stream Deck at login with
  the local-encoder environment exported, so the Stream Deck plugin (a Node child of
  the app) reads the correct STRIMSERVER_URL instead of silently falling back to
  http://localhost:4000. The wrapper sources $LOCAL_ENCODER_ENV and then
  `open -a "Elgato Stream Deck"`; the app inherits the exported environment.

  The wrapper is installed to /usr/local/bin so this plist needs no repo-specific
  path. LOCAL_ENCODER_ENV and the log paths are per-user; the sed in Install fills
  in your macOS username (the USERNAME placeholder) from $USER.

  Install:
    install -m 0755 tools/local-encoder/launch-streamdeck.zsh /usr/local/bin/
    sed "s/USERNAME/$USER/g" tools/local-encoder/com.chroniccmposer.strimserver.streamdeck.plist \
      > "$HOME/Library/LaunchAgents/com.chroniccmposer.strimserver.streamdeck.plist"
    plutil -lint "$HOME/Library/LaunchAgents/com.chroniccmposer.strimserver.streamdeck.plist"
    launchctl bootstrap "gui/$UID" "$HOME/Library/LaunchAgents/com.chroniccmposer.strimserver.streamdeck.plist"
  Verify:  launchctl print "gui/$UID/com.chroniccmposer.strimserver.streamdeck"
           pgrep -fl "Elgato Stream Deck"
  Remove:
    launchctl bootout "gui/$UID/com.chroniccmposer.strimserver.streamdeck"
    rm "$HOME/Library/LaunchAgents/com.chroniccmposer.strimserver.streamdeck.plist"

  On-demand relaunch (after quitting the app manually):
    LOCAL_ENCODER_ENV="$HOME/.strimserver-local-encoder.env" /usr/local/bin/launch-streamdeck.zsh
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.chroniccmposer.strimserver.streamdeck</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/launch-streamdeck.zsh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin</string>
		<key>LOCAL_ENCODER_ENV</key>
		<string>/Users/USERNAME/.strimserver-local-encoder.env</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/USERNAME/Library/Logs/com.chroniccmposer.strimserver.streamdeck.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/USERNAME/Library/Logs/com.chroniccmposer.strimserver.streamdeck.log</string>
</dict>
</plist>