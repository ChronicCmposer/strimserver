load("@aspect_bazel_lib//lib:directory_path.bzl", "directory_path")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files([
    ".nvmrc",
    "pnpm-lock.yaml",
])

npm_link_all_packages(name = "node_modules")

# Replaces `npm run build` (rollup -c). The plan named this an
# npm_package_bin, but that macro doesn't exist in aspect_rules_js 3.4.1 --
# it was removed in the 2.x/3.x line in favor of js_run_binary (a thin
# wrapper over bazel_lib's run_binary for a js_binary-shaped tool), which is
# the currently-documented way to run a linked npm package's bin script as
# a build step.
# rollup's own package.json declares `"bin": {"rollup": "dist/bin/rollup"}`
# (verified directly in the fetched package) -- npm_link_all_packages left
# this package's `bins` empty (a pnpm_lock-vs-npm-lockfile metadata gap, not
# something to route around further), so this reaches directly into the
# linked package's directory output for the real entry point instead of
# relying on an auto-generated bin alias.
directory_path(
    name = "rollup_bin_entry_point",
    directory = ":node_modules/rollup/dir",
    path = "dist/bin/rollup",
)

js_binary(
    name = "rollup_bin",
    entry_point = ":rollup_bin_entry_point",
)

js_run_binary(
    name = "build",
    tool = ":rollup_bin",
    srcs = [
        "rollup.config.mjs",
        "tsconfig.json",
        ":node_modules/@elgato/streamdeck",
        ":node_modules/@rollup/plugin-commonjs",
        ":node_modules/@rollup/plugin-node-resolve",
        ":node_modules/@rollup/plugin-typescript",
        # Since the default target platform is the host, rules_js links the
        # rollup native package for the target arch -- which is the host arch --
        # so the js_run_binary action (also native) finds it by require() walk
        # with no cross-arch workaround devDependency.
        ":node_modules/@types/node",
        ":node_modules/tslib",
        ":node_modules/typescript",
        "//tools/streamdeck-plugin/src/client:srcs",
    ] + glob(["src/**/*.ts"]),
    outs = [
        "com.chroniccmposer.strimserver.sdPlugin/bin/plugin.js",
        "com.chroniccmposer.strimserver.sdPlugin/bin/plugin.js.map",
    ],
    args = ["-c"],
    chdir = "tools/streamdeck-plugin",
    mnemonic = "Rollup",
)

# --- Tests ------------------------------------------------------------------
# Node's built-in test runner over the pure version helpers
# (src/client/version.ts); Node 24 strips the .ts types natively, so the test
# runs straight from source with no compile step.
#
# The plugin is architecture-independent JavaScript, so it must build and test
# natively on the host. With the global amd64 --platforms removed, the default
# target platform IS the host, so the :host_node filegroup can be consumed
# directly as sh_test data/args: the target configuration now agrees with the
# execution (host) configuration. This is why the old host_node_bin genrule --
# which existed solely to reach around a forced amd64 target that would select
# the amd64 Node under qemu on an aarch64 host -- is gone.
#
# The select keys on the target arch, which equals the host arch here, and must
# cover both hosts: the aarch64 dev machines and the x86_64 CI runner.
#
# The node repos are generated by the `node` module extension in MODULE.bazel;
# that file's `use_repo` makes their apparent names (`@nodejs_linux_*`) visible
# from the main repo, so this references them directly rather than through
# their canonical `@@rules_nodejs++node+...` names.
filegroup(
    name = "host_node",
    srcs = select({
        "//tools/bazel:is_arm64_target": ["@nodejs_linux_arm64//:bin/node"],
        "//tools/bazel:is_amd64_target": ["@nodejs_linux_amd64//:bin/node"],
    }),
)

# version_test.sh is checked in executable, so sh_test runs it directly.
sh_test(
    name = "version_test",
    srcs = ["version_test.sh"],
    args = [
        "$(rootpath :host_node)",
        "$(rootpath //tools/streamdeck-plugin/src/client:version.test.ts)",
    ],
    data = [
        ":host_node",
        "//tools/streamdeck-plugin/src/client:version.ts",
        "//tools/streamdeck-plugin/src/client:version.test.ts",
    ],
)

test_suite(
    name = "all",
    tests = [":version_test"],
)

# --- Manifest (build-time version injection) --------------------------------
# The StreamDeck manifest Version field must be exactly four numeric
# dot-separated segments (schema pattern
# ^(0|[1-9]\d*)(\.(0|[1-9]\d*)){3}$), so it is derived from the git tag at
# build time rather than hardcoded. gen-manifest.sh maps:
#   empty GIT_TAG (dev build) -> 0.0.0.0,  vX.Y.Z -> X.Y.Z.0,
#   anything malformed        -> hard failure.
# GIT_TAG reaches the action env via `--action_env=GIT_TAG` (see the Makefile);
# its value is part of the action key, so dev and tagged builds never share a
# cache entry. The generated file shadows the checked-in
# com.chroniccmposer.strimserver.sdPlugin/manifest.json (kept at 0.0.0.0 for
# dev-loading the source tree), so consumers must use :manifest -- never the
# source label.
genrule(
    name = "manifest",
    srcs = ["com.chroniccmposer.strimserver.sdPlugin/manifest.json.tpl"],
    tools = ["gen-manifest.sh"],
    outs = ["com.chroniccmposer.strimserver.sdPlugin/manifest.json"],
    cmd = "$(location gen-manifest.sh) $(location com.chroniccmposer.strimserver.sdPlugin/manifest.json.tpl) $@",
    visibility = ["//visibility:public"],
)

# --- Distributable bundle ---------------------------------------------------
# The Stream Deck plugin ships as its own zip, published ALONGSIDE
# strimserver-deployment-go-amd64.tar (never inside it). Everything already lives under
# the com.chroniccmposer.strimserver.sdPlugin/ directory -- generated
# manifest (the :manifest genrule above), source imgs/**, and the :build outs
# (bin/plugin.js + .map). rules_pkg 1.3.0's default strip_prefix is files_only()
# (every directory component is dropped, flattening imgs/** and bin/ to the zip
# root), so it must be overridden: strip_prefix removes the
# com.chroniccmposer.strimserver.sdPlugin/ package dir, and prefix re-adds it as
# the single top-level directory, so the zip unzips directly into the plugin
# folder Stream Deck expects. logs/** (runtime logs) is never part of the glob,
# so it is excluded by construction.
pkg_files(
    name = "streamdeck_bundle_files",
    srcs = [
        ":manifest",
        ":build",
    ] + glob(["com.chroniccmposer.strimserver.sdPlugin/imgs/**"]),
    strip_prefix = "com.chroniccmposer.strimserver.sdPlugin",
    prefix = "com.chroniccmposer.strimserver.sdPlugin",
    visibility = ["//visibility:public"],
)

pkg_zip(
    name = "streamdeck_plugin_bundle",
    srcs = [":streamdeck_bundle_files"],
    out = "com.chroniccmposer.strimserver.sdPlugin.zip",
    visibility = ["//visibility:public"],
)

genrule(
    name = "streamdeck_plugin_bundle_sha256",
    srcs = [":streamdeck_plugin_bundle"],
    outs = ["com.chroniccmposer.strimserver.sdPlugin.zip.sha256"],
    cmd = "printf '%s  com.chroniccmposer.strimserver.sdPlugin.zip\\n' " +
          "\"$$(sha256sum $(location :streamdeck_plugin_bundle) | cut -d' ' -f1)\" > $@",
    visibility = ["//visibility:public"],
)

# The same sdPlugin layout, repackaged as a .tar.gz alongside the .zip (both
# are published as distributables; see README). Reuses :streamdeck_bundle_files,
# whose strip_prefix/prefix keep the single com.chroniccmposer.strimserver.sdPlugin/
# top-level directory. rules_pkg 1.3.0's pkg_tar compresses deterministically
# in-process: extension "tar.gz" selects gzip, and portable_mtime (default true)
# pins BOTH the tar entry mtimes and the gzip header mtime to 2000-01-01
# (gzip.GzipFile(mtime=...)), so the bytes are reproducible. compression_level 9
# matches what a `gzip -9` fallback would have produced.
pkg_tar(
    name = "streamdeck_plugin_tar_gz",
    srcs = [":streamdeck_bundle_files"],
    extension = "tar.gz",
    compression_level = 9,
    out = "com.chroniccmposer.strimserver.sdPlugin.tar.gz",
    visibility = ["//visibility:public"],
)

genrule(
    name = "streamdeck_plugin_tar_gz_sha256",
    srcs = [":streamdeck_plugin_tar_gz"],
    outs = ["com.chroniccmposer.strimserver.sdPlugin.tar.gz.sha256"],
    cmd = "printf '%s  com.chroniccmposer.strimserver.sdPlugin.tar.gz\\n' " +
          "\"$$(sha256sum $(location :streamdeck_plugin_tar_gz) | cut -d' ' -f1)\" > $@",
    visibility = ["//visibility:public"],
)

# Standalone S3 publish for ONLY the plugin bundle (`make publish-streamdeck`),
# mirroring tools/bandwidth-test:publish_iperf3. Shares the same S3 keys as
# `make publish-strimserver`, which also uploads the bundles. Publishes BOTH
# the .zip and .tar.gz variants.
sh_binary(
    name = "publish_streamdeck",
    srcs = ["publish_streamdeck.sh"],
    data = [
        ":streamdeck_plugin_bundle",
        ":streamdeck_plugin_tar_gz",
    ],
    args = [
        "$(rootpath :streamdeck_plugin_bundle)",
        "$(rootpath :streamdeck_plugin_tar_gz)",
    ],
)
