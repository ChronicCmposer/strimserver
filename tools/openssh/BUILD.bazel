# Experimental OpenSSH RPM: a pinned, out-of-band artifact fetched from
# @openssh_dist (MODULE.bazel). The rpmbuild pipeline
# (autoreconf/configure/make/rpmbuild on amazonlinux:2023) cannot be expressed
# in rules_oci -- the same reason @ffmpeg_dist is prebuilt -- so tools/openssh/
# publish.sh builds and publishes the RPM, and this filegroup just wraps the
# downloaded file. build.sh/publish.sh/sshd_config in this directory are
# sources for that operator workflow, not BUILD targets.
filegroup(
    name = "openssh_rpm",
    srcs = ["@openssh_dist//file"],
    visibility = ["//visibility:public"],
)