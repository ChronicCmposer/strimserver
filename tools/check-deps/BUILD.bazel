# The vendored pin manifests back TestExtractVendoredPinsRealRepo, which walks
# up from the test working directory to the directory holding third_party. The
# data labels below place each manifest at its repo-relative path in runfiles.
filegroup(
    name = "vendored_pins",
    srcs = [
        "//third_party/cares:pin.json",
        "//third_party/containerd-api:pin.json",
        "//third_party/curl:pin.json",
        "//third_party/libmicrohttpd:pin.json",
        "//third_party/libwebsockets:pin.json",
        "//third_party/mbedtls:pin.json",
        "//third_party/protobuf-c:pin.json",
        "//third_party/wslay:pin.json",
        "//third_party/yyjson:pin.json",
    ],
)

